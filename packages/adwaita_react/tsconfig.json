{
  "compilerOptions": {
    "strict": true,
    "declaration": false,
    "noEmitOnError": true,
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "moduleResolution": "bundler",
    "module": "ESNext",
    "target": "ESNext",
    "paths": {
      "@adwaita/shared": ["../shared/src/index.ts"],
      "@adwaita/shared/types": ["../shared/src/build/types.ts"]
    },
    "esModuleInterop": true,
    "isolatedModules": true,
    "lib": ["esnext", "dom"],
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "sourceMap": true,
    "jsx": "react-jsx",
    "types": ["node"]
  },
  "exclude": ["**/node_modules"],
  "include": ["src"]
}
