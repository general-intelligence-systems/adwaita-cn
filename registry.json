{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "adwaita-cn",
  "homepage": "https://github.com/n-at-han-k/adwaita-cn",
  "items": [
    {
      "name": "adwaita-theme",
      "type": "registry:style",
      "title": "Adwaita theme",
      "description": "The variables every component here reads: libadwaita's radii, easing, opacities and colours. Install this first.",
      "dependencies": [
        "clsx",
        "tailwind-merge"
      ],
      "files": [
        {
          "path": "registry/adwaita/adwaita.css",
          "type": "registry:file",
          "target": "styles/adwaita.css"
        },
        {
          "path": "registry/adwaita/lib/utils.ts",
          "type": "registry:lib"
        }
      ]
    }
  ]
}
