  "items": [
    {
      "name": "adwaita-theme",
      "type": "registry:style",
      "title": "Adwaita theme",
      "description": "The variables every component here reads: libadwaita's radii, easing, opacities and colours. Install this first.",
      "dependencies": [
        "clsx",
        "tailwind-merge"
      ],
      "files": [
        {
          "path": "registry/adwaita/adwaita.css",
          "type": "registry:file",
          "target": "styles/adwaita.css"
        },
        {
          "path": "registry/adwaita/lib/utils.ts",
          "type": "registry:lib"
        }
      ]
    },
    {
      "name": "gtk-enums",
      "type": "registry:lib",
      "title": "GTK enums",
      "description": "Every enumeration GTK and libadwaita define, as string-literal unions with their value arrays. Generated from the introspection data by bin/06-gtk-enums.",
