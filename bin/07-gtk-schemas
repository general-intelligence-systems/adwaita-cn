#!/usr/bin/env ruby
# frozen_string_literal: true

# 07-GTK-SCHEMAS(1)                 General Commands Manual                  07-GTK-SCHEMAS(1)
#
# NAME
#      bin/07-gtk-schemas — every widget's props, out of the introspection data
#
# SYNOPSIS
#      bin/07-gtk-schemas [--own] > schemas.json
#
# DESCRIPTION
#      Reads the GIR files under bin/02-fetch-gir.out/ and writes, as JSON on stdout, one entry per widget
#      class: its properties, each with the type it takes, its default, and whether it can be
#      written at all.
#
#      An implemented interface's properties are a class's own: `orientation` is declared
#      by Gtk.Orientable, and every box and scrollbar has it from there rather than from a
#      parent class. What a widget renders as is not read here -- bin/05-adwaita-components
#      reads that from the toolkit's source, where it is set, rather than from the
#      sentences the documentation happens to contain.
#
#      Read-only properties are included and flagged rather than dropped: passing one is an
#      error worth reporting, and a lint cannot report what it was not told about.
#
# OPTIONS
#      --own        Only the properties each class declares, without the inherited ones.
#      --qualified  Key by Adw.Button and Gtk.Button rather than consolidating.
#
# FILES
#      bin/02-fetch-gir.out/Gtk-4.0.gir
#      bin/02-fetch-gir.out/Adw-1.gir
#      bin/02-fetch-gir.out/VERSIONS
#              Which release each file came from. Properties move between releases.
#
# EXIT STATUS
#      The bin/07-gtk-schemas utility exits 0 on success, and >0 if an error occurs.
#
# EXAMPLES
#      The schemas:
#
#            bin/07-gtk-schemas > bin/07-gtk-schemas.out/schemas.json
#
#      What ActionRow itself adds:
#
#            bin/07-gtk-schemas --own | jq '.classes.ActionRow.properties | keys'
#
# SEE ALSO
#      bin/02-fetch-gir, bin/05-adwaita-components
#
# adwaita-cn                        October 12, 2026                         07-GTK-SCHEMAS(1)

require "json"
require "rexml/document"
require "set"

module GtkSchemas
  GIR = {
    "Gtk" => "bin/02-fetch-gir.out/Gtk-4.0.gir",
    "Adw" => "bin/02-fetch-gir.out/Adw-1.gir",
  }.freeze

  # The namespaces GTK and libadwaita declare their properties out of, which are read for
  # their type names and their enumerations and for nothing else: no class in here is a
  # component, and adding one to GIR above would have written a Gio.Application out as one.
  #
  # Without them a property's unqualified GIR type cannot be told apart from a widget.
  # `<type name="EllipsizeMode"/>` on GtkLabel is Pango's enumeration, and a reader holding
  # only Gtk-4.0.gir and Adw-1.gir resolved it to Gtk.EllipsizeMode, found no such thing,
  # and fell through to the branch which calls anything it does not know a widget. The
  # generator renders a widget as a child, so `ellipsize`, `wrap-mode`, `style`, `variant`,
  # `stretch`, `underline`, `alignment` and `gravity` were each written into the DOM as an
  # element: a label's own enumerations, rendered as its children.
  DEPENDENCIES = {
    "GLib" => "bin/02-fetch-gir.out/GLib-2.0.gir",
    "GObject" => "bin/02-fetch-gir.out/GObject-2.0.gir",
    "Gio" => "bin/02-fetch-gir.out/Gio-2.0.gir",
    "Pango" => "bin/02-fetch-gir.out/Pango-1.0.gir",
    "Gdk" => "bin/02-fetch-gir.out/Gdk-4.0.gir",
    "Gsk" => "bin/02-fetch-gir.out/Gsk-4.0.gir",
    "GdkPixbuf" => "bin/02-fetch-gir.out/GdkPixbuf-2.0.gir",
    "Graphene" => "bin/02-fetch-gir.out/Graphene-1.0.gir",
    "HarfBuzz" => "bin/02-fetch-gir.out/HarfBuzz-0.0.gir",
    "cairo" => "bin/02-fetch-gir.out/cairo-1.0.gir",
  }.freeze

  # Where an unqualified type name is looked for, in order, when the namespace which wrote it
  # does not declare it. GIR writes a name bare when it is the namespace's own or the
  # namespace's include's, and does not say which include, so the search is this order.
  LOOKUP = %w[Gtk Adw Gdk Gsk Gio GObject GLib Pango GdkPixbuf Graphene HarfBuzz cairo].freeze

  # A widget-typed property which names a widget rather than holding one. Both are
  # `<type name="Widget"/>` in the GIR and nothing in the file tells them apart, so the ones
  # which are a reference are listed: a label's `mnemonic-widget` is the entry the label
  # points at, which is somewhere else in the tree, and rendering it as the label's child
  # drew that entry twice.
  REFERENCES = %w[
    accessible activatable-widget active-window application banner carousel column-view
    current-object default-widget device expander-column focus-cell focus-widget group
    key-capture-widget list-row mnemonic-widget object pad parent printer selected-page
    source stack swipeable transient-for view visible-child visible-dialog visible-page
  ].freeze

  # The GIR type names which are a JavaScript primitive, and which one.
  PRIMITIVES = {
    "utf8" => "string",
    "filename" => "string",
    "gboolean" => "boolean",
    "gint" => "number",
    "guint" => "number",
    "gint64" => "number",
    "guint64" => "number",
    "glong" => "number",
    "gulong" => "number",
    "gfloat" => "number",
    "gdouble" => "number",
    "gsize" => "number",
    "gssize" => "number",
    "gunichar" => "string",
    "none" => "void",
  }.freeze

  # GTK spells a property `subtitle-lines`; React spells the same prop `subtitleLines`.
  def self.camel(name)
    parts = name.split("-")

    (parts.first.to_s + parts.drop(1).map(&:capitalize).join)
  end

  # Everything declared in both files, keyed the way a GIR type reference spells it.
  def self.read(root)
    classes = {}
    enums = {}
    interfaces = {}
    # Every type name any of the namespaces declares, which is what tells an unqualified
    # type reference where it came from.
    declared = Set.new

    GIR.each do |namespace, relative|
      document = REXML::Document.new(File.read(File.join(root, relative)))

      REXML::XPath.each(document, "//namespace/enumeration | //namespace/bitfield") do |node|
        members = REXML::XPath.match(node, "member").map do |member|
          {
            "value" => member.attribute("nick")&.to_s || member.attribute("name").to_s,
            "name" => member.attribute("name").to_s,
            "number" => member.attribute("value")&.to_s,
          }
        end

        enums["#{namespace}.#{node.attribute('name')}"] = {
          "flags" => node.name == "bitfield",
          "members" => members,
        }
      end

      # An interface declares properties too, and a widget which implements one has them
      # as surely as it has its parent's: `orientation` is Gtk.Orientable's, and every box,
      # scrollbar and separator in the toolkit gets it from there rather than from a class.
      REXML::XPath.each(document, "//namespace/interface") do |node|
        interfaces["#{namespace}.#{node.attribute('name')}"] = self.properties(node)
      end

      REXML::XPath.each(
        document,
        "//namespace/class | //namespace/interface | //namespace/record | " \
          "//namespace/union | //namespace/alias | //namespace/callback | " \
          "//namespace/enumeration | //namespace/bitfield",
      ) do |node|
        declared << "#{namespace}.#{node.attribute('name')}"
      end

      REXML::XPath.each(document, "//namespace/class") do |node|
        name = node.attribute("name").to_s
        parent = node.attribute("parent")&.to_s

        classes["#{namespace}.#{name}"] = {
          namespace: namespace,
          # A parent in the same namespace is written bare, so it is qualified here.
          parent: self.qualify(parent, namespace),
          properties: self.properties(node),
          implements: REXML::XPath.match(node, "implements")
            .map{|one| self.qualify(one.attribute("name").to_s, namespace) },
        }
      end
    end

    # The properties an implemented interface brings, which the class does not repeat.
    classes.each_value do |entry|
      entry.fetch(:implements).each do |name|
        interfaces.fetch(name, {}).each do |property, attributes|
          entry[:properties][property] ||= attributes
        end
      end
    end

    # The dependency namespaces, for their enumerations and their type names only.
    DEPENDENCIES.each do |namespace, relative|
      path = File.join(root, relative)
      next unless File.exist?(path)

      document = REXML::Document.new(File.read(path))

      REXML::XPath.each(document, "//namespace/enumeration | //namespace/bitfield") do |node|
        members = REXML::XPath.match(node, "member").map do |member|
          {
            "value" => member.attribute("nick")&.to_s || member.attribute("name").to_s,
            "name" => member.attribute("name").to_s,
            "number" => member.attribute("value")&.to_s,
          }
        end

        enums["#{namespace}.#{node.attribute('name')}"] = {
          "flags" => node.name == "bitfield",
          "members" => members,
        }
      end

      REXML::XPath.each(
        document,
        "//namespace/class | //namespace/interface | //namespace/record | " \
          "//namespace/union | //namespace/alias | //namespace/callback | " \
          "//namespace/enumeration | //namespace/bitfield",
      ) do |node|
        declared << "#{namespace}.#{node.attribute('name')}"
      end
    end

    [classes, enums, declared]
  end

  def self.qualify(name, namespace)
    if name.nil? || name.empty?
      nil
    elsif name.include?(".")
      name
    else
      "#{namespace}.#{name}"
    end
  end

  # The same, but for a type reference rather than a parent: a bare name is the namespace's
  # own only when the namespace declares it, and is one of its includes' otherwise.
  #
  # Prefixing the writing namespace unconditionally is what put `Adw.Orientation`,
  # `Adw.Widget`, `Adw.Application` and `Adw.Adjustment` in the schema -- libadwaita declares
  # none of those; they are Gtk's -- and each resolved to nothing and was called a widget.
  def self.reference(name, namespace, declared)
    return nil if name.nil? || name.empty?
    return name if name.include?(".")
    return "#{namespace}.#{name}" if declared.include?("#{namespace}.#{name}")

    LOOKUP.each do |other|
      return "#{other}.#{name}" if declared.include?("#{other}.#{name}")
    end

    "#{namespace}.#{name}"
  end

  # Whether a class is a GtkWidget, which is what makes a property holding one a child.
  def self.widget?(qualified, classes)
    seen = {}
    current = qualified

    while current && classes.key?(current) && !seen.key?(current)
      return true if current == "Gtk.Widget"

      seen[current] = true
      current = classes.fetch(current)[:parent]
    end

    current == "Gtk.Widget"
  end

  def self.properties(node)
    REXML::XPath.match(node, "property").to_h do |property|
      name = property.attribute("name").to_s
      type = REXML::XPath.first(property, "type | array")
      writable = property.attribute("writable")&.to_s == "1"
      # An <array> carries its element type inside it, and reading the name off the array
      # itself gave nil -- which the classifier read as "a type GIR did not name" and called
      # a widget. `developers`, `designers`, `artists` and `documenters` are arrays of utf8.
      array = !type.nil? && type.name == "array"
      type = REXML::XPath.first(type, "type") || type if array

      [
        name,
        {
          "prop" => self.camel(name),
          "gir" => type&.attribute("name")&.to_s,
          "array" => array,
          "writable" => writable,
          "constructOnly" => property.attribute("construct-only")&.to_s == "1",
          "default" => property.attribute("default-value")&.to_s,
          "deprecated" => property.attribute("deprecated")&.to_s == "1",
        },
      ]
    end
  end

  # The GIR type as something a lint can test a JSX attribute against, and as the thing the
  # generator does with it.
  #
  # "node" is a CHILD, and the generator writes one into the DOM. Only a property which holds
  # a widget is one. Everything else which is not a primitive or an enumeration is "object":
  # a value the caller passes and the DOM has no place for -- a GListModel, a GtkAdjustment,
  # a GtkListItemFactory, a GtkExpression, a GVariant, a GdkRGBA, a PangoFontDescription.
  #
  # Calling all of those "node" is why a drop down rendered an empty box where its list should
  # be and a button rendered its action target beside its label: `model`, `factory`,
  # `expression` and `action-target` were handed to React as children.
  def self.kind(gir, name, namespace, enums, classes, declared, array: false)
    qualified = self.reference(gir, namespace, declared)

    if gir.nil?
      # An <array> with no element type, or a type GIR did not name.
      { "type" => "object" }
    elsif PRIMITIVES.key?(gir)
      array ? { "type" => "object", "of" => PRIMITIVES.fetch(gir) } : { "type" => PRIMITIVES.fetch(gir) }
    elsif enums.key?(qualified)
      {
        "type" => "enum",
        "enum" => qualified,
        "values" => enums.fetch(qualified).fetch("members").map{|member| member.fetch("value")},
      }
    elsif !array && self.widget?(qualified, classes) && !REFERENCES.include?(name)
      { "type" => "node", "gobject" => qualified }
    else
      found = { "type" => "object", "gobject" => qualified }
      found["widget"] = true if self.widget?(qualified, classes)
      found
    end
  end

  # A class's properties with its ancestors' folded in, nearest declaration winning.
  def self.resolve(name, classes, own:)
    chain = []
    current = name

    while current && classes.key?(current)
      chain << current
      current = classes.fetch(current)[:parent]
    end

    if own
      chain = chain.take(1)
    end

    # Furthest ancestor first, so a class which redeclares a property overwrites it.
    chain.reverse.each_with_object({}) do |ancestor, found|
      classes.fetch(ancestor)[:properties].each do |property, attributes|
        found[property] = attributes.merge("from" => ancestor)
      end
    end
  end

  # Adw before Gtk, so that consolidating by bare name keeps the Adw class.
  PRECEDENCE = %w[Adw Gtk].freeze

  # The bare name a qualified class is consolidated under, and nil for anything outside the two
  # namespaces -- a GObject or Gio parent stays qualified, because it is not a component.
  def self.consolidated(qualified, classes)
    namespace, name = qualified.to_s.split(".", 2)

    if PRECEDENCE.include?(namespace) && classes.key?(qualified)
      name
    else
      qualified
    end
  end

  # ── The CSS nodes, which is what ties a stylesheet selector to a class ──

  # A stylesheet addresses `list > row`, not GtkListBox > GtkListBoxRow, and the join between the
  # two spellings is documented: every widget's doc comment carries a `# CSS nodes` section
  # naming the node it renders as, the subnodes under it, and the style classes it takes. That
  # section is the authority for which class a selector is talking about, so it is parsed rather
  # than guessed at.
  #
  # It is written two ways. Most classes draw a tree in a fenced block, where the first line is
  # the node the widget itself is and the lines below it are its parts:
  #
  #       list[.separators][.rich-list][.navigation-sidebar][.boxed-list]
  #       ╰── row[.activatable]
  #
  # The rest say the same thing in a sentence -- "has a single CSS node with name button", "has a
  # main node `expander-widget`, and subnode `box`" -- so both forms are read.












  # Furthest ancestor first, so a common prefix is a common ancestry.
  def self.ancestry(name, classes)
    chain = []
    current = name

    while current && classes.key?(current)
      chain.unshift(current)
      current = classes.fetch(current)[:parent]
    end

    chain
  end




  def self.run(argv)
    root = File.expand_path("..", __dir__)
    own = !argv.delete("--own").nil?
    qualified = !argv.delete("--qualified").nil?
    classes, enums, declared = self.read(root)

    if qualified
      keyed = classes.keys.to_h{|name| [name, name]}
    else
      # Gtk first and Adw second, so Adw overwrites the shared names.
      keyed = {}
      PRECEDENCE.reverse.each do |namespace|
        classes.each_key do |name|
          if name.start_with?("#{namespace}.")
            keyed[name.split(".", 2).last] = name
          end
        end
      end
    end

    schemas = keyed.sort.to_h do |key, name|
      entry = classes.fetch(name)
      properties = self.resolve(name, classes, own: own).sort.to_h do |property, attributes|
        [
          property,
          attributes.merge(self.kind(
            attributes["gir"], property, entry[:namespace], enums, classes, declared,
            array: attributes["array"] == true,
          )),
        ]
      end

      [key, self.entry(key, name, entry, classes, qualified).merge("properties" => properties)]
    end

    File.write(self.output("schemas.json"), "#{JSON.pretty_generate({
      "versions" => File.read(File.join(root, "bin/02-fetch-gir.out/VERSIONS")).lines.map{|line| line.strip.squeeze(" ")},
      "enums" => enums.sort.to_h,
      "classes" => schemas,
    })}\n")
    warn("wrote bin/07-gtk-schemas.out/schemas.json")
  end

  # Every interface a class implements, walking up the parents it inherits them from.
  def self.implemented(entry, classes)
    found = []
    current = entry

    while current && !found.include?(current)
      found.concat(current.fetch(:implements, []))
      current = classes[current[:parent]]
    end

    found.uniq
  end

  # One class's own identity: where it came from, what it displaced, and who its parent is once
  # the namespaces are gone.
  def self.entry(key, name, entry, classes, qualified)
    shadowed = "Gtk.#{key}"
    parent = entry[:parent]

    found = {
      "class" => name,
      "namespace" => entry[:namespace],
      "parent" => qualified ? parent : self.consolidated(parent, classes),
      # The interfaces the class implements, its parents' included. Having a property is
      # not the same as implementing the interface it came from, and `orientation` is the
      # case that matters: Gtk.Orientable is what gtk_widget_update_orientation keys off,
      # and AdwClamp, AdwLeaflet and AdwWrapBox all carry an `orientation` of their own
      # without implementing it -- so a component which read the property got
      # `.horizontal` on four widgets the toolkit never puts it on.
      "implements" => self.implemented(entry, classes).sort,
    }

    if !qualified && entry[:namespace] == "Adw" && classes.key?(shadowed) && shadowed != name
      found["shadows"] = shadowed
    end

    if found["parent"] == key
      found["parentThrough"] = parent
      found["parent"] = self.consolidated(classes.fetch(parent)[:parent], classes)
    end

    found
  end

  # Beside the script, in a directory named after it.
  def self.output(name)
    File.join(__dir__, "07-gtk-schemas.out").then do |directory|
      Dir.mkdir(directory) unless Dir.exist?(directory)
      File.join(directory, name)
    end
  end
end

GtkSchemas.run(ARGV)
