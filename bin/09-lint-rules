#!/usr/bin/env ruby
# frozen_string_literal: true

# 09-LINT-RULES(1)                  General Commands Manual                   09-LINT-RULES(1)
#
# NAME
#      bin/09-lint-rules — the rule file the oxlint plugin checks against
#
# SYNOPSIS
#      bin/09-lint-rules > lint/rules.json
#
# DESCRIPTION
#      Joins lint/components.json, which declares which components exist, to vendor/gir/
#      schemas.json, which says what each one's props are, and writes the one file the oxlint
#      plugin reads.
#
#      THE PLUGIN KNOWS NOTHING, which is the point of generating this. A linter which infers
#      whether a name is meant to be a GTK component guesses, and a guess that fires on correct
#      code is worse than no lint at all -- an earlier version reported <ShellHeader> as a
#      misspelling of <ListHeader>. Existence is declared here instead: a name in this file is
#      checked, a name absent from it is not mentioned, and the plugin is a dumb rule-checker
#      with no opinions of its own.
#
#      lint/components.json is the declaration, and it is written by hand. Thirty-five of its
#      entries map to a GTK class by name; the rest do not, and a CSS node does not say which
#      class it belongs to. `row` is Gtk.ListBoxRow, `.boxed-list` is Adw.PreferencesGroup, and
#      `.card` is no class at all.
#
#      A `null` class is a style class: a component which is styling and nothing else, so it
#      exists but has no props to validate. The plugin accepts any prop on one of those rather
#      than rejecting every prop, which is the only safe reading of "no schema".
#
#      Props are carried under both spellings, GTK's `subtitle-lines` and React's
#      `subtitleLines`, so a component may use either.
#
# FILES
#      lint/components.json    which components exist, and which class each one is
#      vendor/gir/schemas.json what each class accepts
#      lint/rules.json         the output
#
# EXIT STATUS
#      The bin/09-lint-rules utility exits 0 on success, and >0 if an error occurs.
#
# SEE ALSO
#      bin/06-gtk-schemas, bin/04-adwaita-components, lint/adwaita-plugin.js
#
# adwaita-cn                         October 12, 2026                         09-LINT-RULES(1)

require "json"

module LintRules
  # React's own, which no GTK class declares and every component takes.
  REACT = %w[key ref children className style id slot].freeze

  # Where a component is imported from. A named import from one of these must be a component in
  # this file, which is how existence is checked without the plugin guessing from the name.
  SOURCES = %w[@/components/ui/ @/components/adwaita/ adwaita-cn].freeze

  def self.run(_argv)
    root = File.expand_path("..", __dir__)
    declared = JSON.parse(File.read(File.join(root, "lint/components.json")))
    schemas = JSON.parse(File.read(File.join(root, "vendor/gir/schemas.json")))
    classes = schemas.fetch("classes")

    missing = declared.reject{|_name, entry| entry["class"].nil? || classes.key?(entry["class"])}

    unless missing.empty?
      warn("lint-rules: declared classes which do not exist: #{missing.keys.join(', ')}")
      exit(1)
    end

    components = declared.sort.to_h do |name, entry|
      [name, self.component(name, entry, classes)]
    end

    puts(JSON.pretty_generate({
      "versions" => schemas.fetch("versions"),
      "react" => REACT,
      "sources" => SOURCES,
      "components" => components,
    }))
  end

  def self.component(_name, entry, classes)
    klass = entry["class"]

    found = {
      "nodes" => entry.fetch("nodes"),
      "widget" => entry["widget"],
      "class" => klass,
    }

    if klass.nil?
      # Styling only. There is no schema, so there is nothing to check a prop against, and
      # rejecting every prop would be a lint which forbids writing the component at all.
      found["props"] = nil
    else
      found["props"] = self.props(classes.fetch(klass).fetch("properties"))
    end

    found
  end

  # One entry per spelling, so the plugin looks a prop up and does no transforming.
  def self.props(properties)
    {}.tap do |found|
      properties.each do |gtk, attributes|
        rule = {
          "type" => attributes.fetch("type"),
          "writable" => attributes.fetch("writable"),
          "from" => attributes.fetch("from"),
        }

        if attributes.key?("values")
          rule["values"] = attributes.fetch("values")
          rule["enum"] = attributes.fetch("enum")
        end

        found[gtk] = rule
        found[attributes.fetch("prop")] = rule
      end
    end
  end
end

LintRules.run(ARGV)
