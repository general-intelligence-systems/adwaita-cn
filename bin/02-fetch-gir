#!/usr/bin/env bash

# 02-FETCH-GIR(1)                   General Commands Manual                    02-FETCH-GIR(1)
#
# NAME
#      bin/02-fetch-gir — vendor GTK's and libadwaita's introspection data
#
# SYNOPSIS
#      bin/02-fetch-gir
#
# DESCRIPTION
#      Writes Gtk-4.0.gir and Adw-1.gir into vendor/gir/, which is what bin/07-gtk-schemas reads.
#
#      Each file ships in its library's `dev` output, under share/gir-1.0.
#
#      The versions are recorded in vendor/gir/VERSIONS, because properties are added and
#      deprecated between releases and a lint built on one release is only true of that one.
#
# FILES
#      vendor/gir/Gtk-4.0.gir
#      vendor/gir/Adw-1.gir
#      vendor/gir/VERSIONS
#
# EXIT STATUS
#      The bin/02-fetch-gir utility exits 0 on success, and >0 if an error occurs.
#
# SEE ALSO
#      bin/07-gtk-schemas, bin/01-fetch-adwaita, g-ir-scanner(1)
#
# adwaita-cn                         October 12, 2026                          02-FETCH-GIR(1)

set -o errexit
set -o nounset
set -o pipefail

cd "$(dirname "$0")/.."

out="vendor/gir"
mkdir -p "$out"

# pkg-config names the directory when the devshell provides the library, and the store is the
# fallback. Neither library is a runtime dependency: they are where the schema comes from.
locate() {
  local module="$1" file="$2" pattern="$3" given="${4:-}" dir path

  # The devshell sets these, and they are the only answer which cannot be the wrong release.
  path="$given/share/gir-1.0/$file"

  if [ ! -f "$path" ]; then
    dir="$(pkg-config --variable=girdir "$module" 2>/dev/null || true)"
    path="$dir/$file"
  fi

  if [ ! -f "$path" ]; then
    path="$(find /nix/store -maxdepth 4 -path "*$pattern*/share/gir-1.0/$file" 2>/dev/null | sort | tail -1)"
  fi

  if [ ! -f "$path" ]; then
    echo "fetch-gir: cannot find $file; add $pattern's dev output to the devshell" >&2
    exit 1
  fi

  echo "$path"
}

gtk="$(locate gtk4 Gtk-4.0.gir gtk4 "${GTK_DEV:-}")"
adw="$(locate libadwaita-1 Adw-1.gir libadwaita "${ADWAITA_DEV:-}")"

# install rather than cp: a file copied out of the store keeps the store's read-only mode, and
# the next run cannot overwrite it.
install -m 644 "$gtk" "$out/Gtk-4.0.gir"
install -m 644 "$adw" "$out/Adw-1.gir"

# The store path carries the version, which is the only place it is written down.
{
  echo "gtk4       $(basename "$(dirname "$(dirname "$(dirname "$gtk")")")")"
  echo "libadwaita $(basename "$(dirname "$(dirname "$(dirname "$adw")")")")"
} > "$out/VERSIONS"

wc -c "$out"/*.gir
cat "$out/VERSIONS"
