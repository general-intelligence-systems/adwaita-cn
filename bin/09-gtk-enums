#!/usr/bin/env ruby
# frozen_string_literal: true

# 09-GTK-ENUMS(1)                   General Commands Manual                    09-GTK-ENUMS(1)
#
# NAME
#      bin/09-gtk-enums — the enumerations as TypeScript
#
# SYNOPSIS
#      bin/09-gtk-enums [FINAL] > enums.ts
#
# DESCRIPTION
#      Reads vendor/adwaita/final-components.json and writes TypeScript: one string-literal
#      union per enumeration, with the array of its values beside it.
#
#      ONLY THE ENUMERATIONS THE COMPONENTS DRAW FROM, which is 36 of the 158 the introspection
#      data declares. The other 122 belong to widgets nothing in this registry wraps, and a file
#      of types nothing imports is a file nobody maintains.
#
#      A UNION AND AN ARRAY FROM ONE SOURCE, because both are wanted and keeping them in step by
#      hand is how they drift:
#
#          export const toolbarStyleValues = ["flat", "raised", "raised-border"] as const
#          export type ToolbarStyle = (typeof toolbarStyleValues)[number]
#
#      The type is what a prop is annotated with and costs nothing at runtime. The array is what
#      a select populates itself from and what a lint checks a value against, and deriving the
#      type from it means there is one place to change.
#
#      THE VALUES ARE GTK'S NICKS. A member is written `raised_border` in the introspection data
#      and the string the property system accepts is `raised-border`. Anything generated from
#      the names rather than the nicks insists on values GTK rejects.
#
#      Names are consolidated the way the schemas are: no Adw/Gtk prefix, Adw taking precedence.
#      No enumeration name is claimed by both namespaces, so nothing is displaced.
#
#      FLAGS ARE UNIONS OF THE MEMBERS, NOT OF THE SET. A bitfield is several members at once, so
#      a prop drawn from one is an array of its union rather than the union -- `inputHints?:
#      InputHints[]`. They are emitted because props reference them: Gtk.Entry's `input-hints` is
#      a bitfield, and leaving it out gave a generated component an import of a type which did
#      not exist. Each one says so in its doc comment.
#
# FILES
#      vendor/adwaita/final-components.json
#              The input, from bin/08-final-components.
#
# EXIT STATUS
#      The bin/09-gtk-enums utility exits 0 on success, and >0 if an error occurs.
#
# EXAMPLES
#      Into the registry, where components import it:
#
#            bin/09-gtk-enums > registry/adwaita/lib/enums.ts
#
# SEE ALSO
#      bin/08-final-components, bin/07-gtk-schemas
#
# adwaita-cn                         October 12, 2026                          09-GTK-ENUMS(1)

require "json"

module GtkEnums
  # `ToolbarStyle` -> `toolbarStyle`, which is the array's name with `Values` after it.
  def self.camel(name)
    name.sub(/\A[A-Z]+/){|run| run.length > 1 ? run[0..-2].downcase + run[-1] : run.downcase}
  end

  def self.run(argv)
    root = File.expand_path("..", __dir__)
    source = argv.first || File.join(root, "vendor/adwaita/final-components.json")
    schemas = JSON.parse(File.read(source))

    # Adw first, so that consolidating by bare name keeps it. No name is claimed by both, so
    # this only decides the order the file is written in.
    wanted = schemas.fetch("enums")

    consolidated = {}

    %w[Gtk Adw].each do |namespace|
      wanted.each do |qualified, enum|
        if qualified.start_with?("#{namespace}.")
          consolidated[qualified.split(".", 2).last] = [qualified, enum]
        end
      end
    end

    puts(self.header(schemas))

    consolidated.sort.each do |name, (qualified, enum)|
      puts(self.enumeration(name, qualified, enum))
    end
  end

  def self.header(schemas)
    <<~TS
      // Generated by bin/09-gtk-enums from #{schemas.fetch('versions').join(', ')}.
      //
      // Every enumeration this registry's components draw a prop from, as a string-literal
      // union with the array of its values beside it. The values are GTK's nicks, which is the spelling the property
      // system accepts: `raised-border`, not the `raised_border` the introspection data names
      // the member.
      //
      // Do not edit. Run bin/09-gtk-enums.
    TS
  end

  def self.enumeration(name, qualified, enum)
    members = enum.fetch("members")
    values = members.map{|member| member.fetch("value")}
    array = "#{self.camel(name)}Values"

    [].tap do |lines|
      lines << ""
      lines << "/** #{qualified}#{enum.fetch('flags') ? ' — flags: a set, so a prop drawn from this is an array of it' : ''} */"
      lines << "export const #{array} = [#{values.map(&:inspect).join(', ')}] as const"
      lines << ""
      lines << "export type #{name} = (typeof #{array})[number]"
    end.join("\n")
  end
end

GtkEnums.run(ARGV)
