#!/usr/bin/env bash

# 01-FETCH-ADWAITA(1)               General Commands Manual                01-FETCH-ADWAITA(1)
#
# NAME
#      bin/01-fetch-adwaita — vendor the Adwaita and GTK stylesheets, templates and icons
#
# SYNOPSIS
#      bin/01-fetch-adwaita
#
# DESCRIPTION
#      Writes the two compiled stylesheets Fractal is drawn with into bin/01-fetch-adwaita.out/, which is
#      what bin/03-adwaita-tailwind reads.
#
#      Two sheets, because Adwaita is only the top half:
#
#      adwaita.css
#              libadwaita's, which is Adwaita proper — every Adw.* widget and style class.
#
#      ui/*.ui
#              The composite widgets' templates: the child tree of each Adw widget, which is the
#              toolkit saying which widgets it is built out of rather than anybody guessing.
#
#      icons/*.svg
#              The Adwaita symbolic icon set, and libadwaita's own. An `icon-name` is not
#              decoration: GTK draws a named icon out of this theme, so a port with no icons
#              has an empty circle everywhere the toolkit has a back arrow, a close button, a
#              menu, a checkmark or an expander. They are symbolic, which means one colour --
#              the widget's -- so bin/11 writes each one out as a mask.
#
#      gtk-default-light.css
#              GTK's own Default theme, which is the base widget sheet Adwaita sits on. GTK 4
#              no longer ships an Adwaita of its own; gtk/theme/ holds Default and Empty, and
#              Adwaita moved out to libadwaita.
#
#      The versions extracted are recorded in bin/01-fetch-adwaita.out/VERSIONS, because the metrics move
#      between releases and a generated class list is only true of the sheet it came from.
#
# FILES
#      bin/01-fetch-adwaita.out/adwaita.css
#      bin/01-fetch-adwaita.out/gtk-default-light.css
#      bin/01-fetch-adwaita.out/ui/*.ui
#      bin/01-fetch-adwaita.out/icons/*.svg
#      bin/01-fetch-adwaita.out/VERSIONS
#
# EXIT STATUS
#      The bin/01-fetch-adwaita utility exits 0 on success, and >0 if an error occurs.
#
# SEE ALSO
#      bin/03-adwaita-tailwind, gresource(1)
#
# async-matrix                          October 12, 2026                     01-FETCH-ADWAITA(1)

set -o errexit
set -o nounset
set -o pipefail

cd "$(dirname "$0")/.."

out="bin/01-fetch-adwaita.out"
mkdir -p "$out"

# pkg-config when the devshell provides the libraries, and the store otherwise. Neither the
# library nor the tool is a runtime dependency of this app -- they are where the stylesheet
# comes from, so they are only needed to re-vendor it.
locate() {
  local module="$1" soname="$2" path given="${4:-}"

  # The devshell sets these, and they are the only answer which cannot be the wrong release.
  path="$given/lib/$soname"

  if [ ! -f "$path" ]; then
    path="$(pkg-config --variable=libdir "$module" 2>/dev/null || true)/$soname"
  fi

  if [ ! -f "$path" ]; then
    path="$(find /nix/store -maxdepth 3 -name "$soname" -path "*$3*" 2>/dev/null | sort | tail -1)"
  fi

  if [ ! -f "$path" ]; then
    echo "fetch-adwaita: cannot find $soname; add $3 to the devshell" >&2
    exit 1
  fi

  echo "$path"
}

if ! command -v gresource >/dev/null; then
  echo "fetch-adwaita: gresource is not on PATH; add glib to the devshell" >&2
  exit 1
fi

adwaita="$(locate libadwaita-1 libadwaita-1.so.0 libadwaita "${ADWAITA_LIB:-}")"
gtk="$(locate gtk4 libgtk-4.so.1 gtk4 "${GTK_LIB:-}")"

gresource extract "$adwaita" /org/gnome/Adwaita/styles/gtk.css > "$out/adwaita.css"
gresource extract "$gtk" /org/gtk/libgtk/theme/Default/Default-light.css > "$out/gtk-default-light.css"

mkdir -p "$out/ui"
for resource in $(gresource list "$adwaita" | grep "/ui/.*\.ui$"); do
  gresource extract "$adwaita" "$resource" > "$out/ui/$(basename "$resource")"
done

# The icons GTK draws a named icon out of. The theme is a directory of SVGs rather than a
# resource, so it is found the same way the libraries are.
icons="${ADWAITA_ICONS:-}"

if [ ! -d "$icons" ]; then
  icons="$(find /nix/store -maxdepth 5 -type d -path "*adwaita-icon-theme*/share/icons/Adwaita/symbolic" 2>/dev/null | sort | tail -1)"
fi

if [ ! -d "$icons" ]; then
  for candidate in /usr/share/icons/Adwaita/symbolic /run/current-system/sw/share/icons/Adwaita/symbolic; do
    [ -d "$candidate" ] && icons="$candidate" && break
  done
fi

if [ ! -d "$icons" ]; then
  echo "fetch-adwaita: cannot find the Adwaita symbolic icons; add adwaita-icon-theme to the devshell" >&2
  exit 1
fi

mkdir -p "$out/icons"
rm -f "$out/icons"/*.svg
# `install` rather than `cp`: the theme's files come out of the store read-only, and a
# second run cannot overwrite what the first one copied.
find "$icons" -name "*-symbolic.svg" -exec install -m 644 {} "$out/icons/" \;

# libadwaita ships icons of its own -- the entry row's apply and edit marks, the expander
# arrow -- in its resource bundle rather than in the theme.
for resource in $(gresource list "$adwaita" | grep "/icons/.*\.svg$"); do
  gresource extract "$adwaita" "$resource" > "$out/icons/$(basename "$resource")"
done

# The store path carries the version, which is the only place it is written down.
{
  echo "libadwaita $(basename "$(dirname "$(dirname "$adwaita")")")"
  echo "gtk4       $(basename "$(dirname "$(dirname "$gtk")")")"
  echo "icons      $(basename "$(dirname "$(dirname "$(dirname "$(dirname "$icons")")")")")"
} > "$out/VERSIONS"

wc -c "$out"/*.css
echo "icons      $(ls "$out/icons" | wc -l)"
cat "$out/VERSIONS"
