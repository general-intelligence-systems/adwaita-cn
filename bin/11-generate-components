#!/usr/bin/env ruby
# frozen_string_literal: true

# 11-GENERATE-COMPONENTS(1)       General Commands Manual      11-GENERATE-COMPONENTS(1)
#
# NAME
#      bin/11-generate-components — a file per component, with its props and its classes
#
# SYNOPSIS
#      bin/11-generate-components [--force]
#
# DESCRIPTION
#      Writes one .tsx under registry/adwaita/ui/ for every buildable component in
#      vendor/adwaita/final-components.json, with
#      the props its GTK class accepts and the Tailwind classes its CSS node is styled with,
#      and registers each one in registry.json.
#
#      THE MARKUP IS A PLACEHOLDER AND THE REST IS NOT. What is generated is everything that
#      can be derived -- the prop names, their types, the enum unions they are drawn from, the
#      cn() call with Adwaita's measurements in it -- so that writing a component is a matter of
#      replacing one <div> with the markup it should have been. Nothing a human writes has to be
#      kept in step with the toolkit by hand.
#
#      IT DOES NOT OVERWRITE. A file which exists is left exactly as it is, because the moment
#      somebody replaces that <div> the file stops being generated output. Re-running this adds
#      what is missing and touches nothing else, so it is safe after a release bump which brings
#      new widgets. --force overwrites, which throws away hand-written markup and is there for
#      regenerating on purpose.
#
#      PROPS ARE FACTORED THE WAY GTK FACTORS THEM. Gtk.Widget declares thirty writable
#      properties -- visible, sensitive, tooltipText, the expand and align pairs -- and every
#      widget has them. Repeating those in fifty-four interfaces would bury the five or ten
#      which are actually the component's own, so they live in one WidgetProps and each
#      component extends it. ActionRow adds thirteen, Button six, Switch two.
#
#      Read-only properties are left out: a prop which cannot be written is not a prop.
#
#      A component whose class is null is a style class -- styling with no properties -- so it
#      gets the classes and no props beyond WidgetProps.
#
# OPTIONS
#      --force   Overwrite files which already exist.
#
# FILES
#      vendor/adwaita/final-components.json  which components exist, and what each accepts
#      vendor/adwaita/widgets.json  the Tailwind classes per CSS node
#      registry/adwaita/ui/         the output
#      registry.json                gains an item per component
#
# EXIT STATUS
#      The bin/11-generate-components utility exits 0 on success, and >0 if an error occurs.
#
# SEE ALSO
#      bin/10-lint-rules, bin/03-adwaita-tailwind
#
# adwaita-cn                       October 12, 2026             11-GENERATE-COMPONENTS(1)

require "json"
require "set"

module GenerateComponents
  # The GIR type as the TypeScript a prop is annotated with. A widget-valued property is a
  # ReactNode, because that is what it is once it is a prop.
  TYPES = {
    "string" => "string",
    "boolean" => "boolean",
    "number" => "number",
    "node" => "ReactNode",
    "void" => "void",
  }.freeze

  def self.run(argv)
    root = File.expand_path("..", __dir__)
    force = !argv.delete("--force").nil?
    final = JSON.parse(File.read(File.join(root, "vendor/adwaita/final-components.json")))
    flags = final.fetch("enums").select{|_name, enum| enum.fetch("flags")}.keys.to_set
    components = final.fetch("components").slice(*final.fetch("buildable"))

    # Gtk.Widget's own, which every component extends rather than repeats. bin/08-final-components
    # has already subtracted them from each component's own props.
    shared = final.fetch("widget")
    self.write(root, "lib/widget-props.ts", self.widget_props(shared, flags), force)

    written = []
    skipped = []

    components.sort.each do |name, component|
      file = "ui/#{self.kebab(name)}.tsx"
      source = self.component(name, component, flags, components)

      if self.write(root, file, source, force)
        written << name
      else
        skipped << name
      end
    end

    self.register(root, components)

    puts("written: #{written.size}")
    puts("left alone: #{skipped.size}#{skipped.empty? ? '' : " (#{skipped.join(', ')})"}")
  end

  # True when the file was written, false when it was already there.
  def self.write(root, relative, source, force)
    path = File.join(root, "registry/adwaita", relative)

    if File.exist?(path) && !force
      false
    else
      FileUtils.mkdir_p(File.dirname(path))
      File.write(path, source)
      true
    end
  end

  def self.kebab(name)
    name.gsub(/([a-z0-9])([A-Z])/, '\1-\2').downcase
  end

  def self.annotation(attributes, flags)
    if attributes.fetch("type") == "enum"
      name = attributes.fetch("enum").split(".").last

      # A bitfield is several members at once, so the prop is an array of its union.
      flags.include?(attributes.fetch("enum")) ? "#{name}[]" : name
    else
      TYPES.fetch(attributes.fetch("type"), "unknown")
    end
  end

  def self.declaration(prop, attributes, flags)
    comment = "  /** #{attributes.fetch('gir') || 'object'}, from #{attributes.fetch('from')} */"
    "#{comment}\n  #{prop}?: #{self.annotation(attributes, flags)}"
  end

  def self.widget_props(shared, flags)
    lines = shared.sort.map{|prop, attributes| self.declaration(prop, attributes, flags)}
    enums = self.enums_used(shared)

    <<~TS
      // Generated by bin/11-generate-components. Do not edit.
      //
      // Gtk.Widget's own writable properties, which every widget has. They live here rather
      // than in all fifty-four component interfaces so that each component's file shows the
      // five or ten props which are actually its own.

      import type { ReactNode } from "react"
      #{enums.empty? ? '' : "import type { #{enums.join(', ')} } from \"./enums\"\n"}
      export interface WidgetProps {
      #{lines.join("\n\n")}
      }
    TS
  end

  def self.enums_used(props)
    props.values
      .select{|attributes| attributes.fetch("type") == "enum"}
      .map{|attributes| attributes.fetch("enum").split(".").last}
      .uniq
      .sort
  end

  # The classes the component's CSS node is styled with, base state only: a state is a variant
  # the markup has to opt into and there is no markup yet.
  def self.classes_for(component)
    component.dig("classes", "base").to_a
  end

  def self.component(name, component, flags, components)
    klass = component["gtk"]
    props = component.fetch("props")
    body = self.body(name, component, components)
    enums = self.enums_used(props)
    used = self.elements(body)

    <<~TS
      // #{name}#{klass ? " — #{klass}" : ''}
      //
      // Generated by bin/11-generate-components, which does not overwrite.
      //
      // #{self.provenance(component)}

      import type { ReactNode } from "react"

      import { cn } from "@/lib/utils"
      import type { WidgetProps } from "@/lib/widget-props"
      #{used.map{|element| "import { #{element} } from \"@/ui/#{self.kebab(element)}\"\n"}.join}#{enums.empty? ? '' : "import type { #{enums.join(', ')} } from \"@/lib/enums\"\n"}
      export interface #{name}Props extends WidgetProps {
        className?: string
        children?: ReactNode
      #{props.sort.map{|prop, attributes| self.declaration(prop, attributes, flags)}.join("\n\n")}
      }

      export function #{name}({ #{self.parameters(component, body)} }: #{name}Props) {
        return (
      #{body}
        )
      }
    TS
  end

  # Where this component's markup came from, which is one of two places.
  def self.provenance(component)
    if component["tree"]
      "The markup is #{component.fetch('template')}, which libadwaita ships, and the classes are\n  // Adwaita's own rules for each node in it."
    else
      "It ships no template, so the markup is the one element its CSS node is, carrying what\n  // Adwaita styles #{component['node'] || 'it'} with."
    end
  end

  # The component's markup.
  #
  # A COMPOSITE IS ITS OWN TEMPLATE. libadwaita ships a .ui for twenty-nine of these and
  # bin/06-component-trees read them, so the structure is not a thing to invent: AdwActionRow is
  # a box holding a box of prefixes, an image, a box of two labels and a box of suffixes, and
  # the template says which classes each node has and which of the component's props it is
  # bound to.
  #
  # ANYTHING ELSE IS ONE ELEMENT. A widget built in C ships no template, so what is known about
  # it is the node it renders as and the rules Adwaita has for that node.
  def self.body(name, component, components)
    if component["tree"]
      self.node(component.fetch("tree"), component, components, 4, root: true)
    else
      self.leaf(component, 4)
    end
  end

  # One element, for a component with no template: its own classes, its text, and its children.
  def self.leaf(component, indent)
    pad = " " * indent
    text = component.fetch("text").map{|prop| "#{pad}  {#{prop}}"}

    [
      "#{pad}<div className={cn(#{self.classes(component.fetch('classes', {}))}className)}>",
      *text,
      "#{pad}  {children}",
      "#{pad}</div>",
    ].join("\n")
  end

  # One node of a template, and everything under it.
  #
  # THE ROOT IS THE COMPONENT ITSELF, so it is the element this function returns rather than a
  # component it renders -- a tree whose root is ActionRow cannot render an <ActionRow> without
  # recurring forever. Every node below it is a component in the registry, which is the whole
  # point of generating the trees: GTK has no <div>, so each node names a widget.
  def self.node(node, component, components, indent, root: false)
    pad = " " * indent
    name = node.fetch("class")
    inner = self.children(node, component, components, indent + 2)
    element = root || !components.key?(name) ? "div" : name
    attributes = self.attributes(node, component, components, root: root)
    opening = "#{pad}<#{element}#{attributes}"

    if inner.empty?
      "#{opening} />"
    else
      ["#{opening}>", inner, "#{pad}</#{element}>"].join("\n")
    end
  end

  # A node's children, which a template writes as `children` in order and as named `slots`.
  def self.children(node, component, components, indent)
    pad = " " * indent
    slots = node.fetch("slots", {}).values
    found = (slots + node.fetch("children", [])).map do |child|
      self.node(child, component, components, indent)
    end

    if node.fetch("class") == component["gtk"]&.split(".")&.last
      found
    else
      found
    end.push(node.equal?(component["tree"]) ? "#{pad}{children}" : nil).compact.join("\n")
  end

  # A node's attributes: its classes, and the template's own property values.
  # THE ROOT TAKES ONLY ITS CLASSES. It is a plain element rather than a component, so the
  # template's `activatable="False"` has nowhere to go on it: those are the component's own
  # props, which is its API rather than something to set on its outermost div.
  def self.attributes(node, component, components, root: false)
    classes = self.classes(node.fetch("classes", {}))

    if root
      " className={cn(#{classes}className)}"
    else
      found = classes.empty? ? [] : ["className={cn(#{classes.delete_suffix(', ')})}"]

      found.concat(self.properties(node, component, components))

      found.empty? ? "" : " #{found.join(' ')}"
    end
  end

  # The property values a template sets on a node, as props.
  #
  # A BINDING IS THE COMPONENT'S OWN PROP. The template writes `label` on ActionRow's title
  # label as `bind: title`, which is how the string a caller passes reaches the markup, and is
  # why these components take props at all rather than being pictures.
  #
  # A LITERAL IS ONLY PASSED WHERE THE CHILD ACCEPTS IT. A template sets GTK properties which
  # the registry does not model on every node, and a prop no component declares is exactly what
  # the lint is there to catch.
  def self.properties(node, component, components)
    accepts = components.dig(node.fetch("class"), "accepts") || {}

    found = node.fetch("properties", {}).filter_map do |property, value|
      rule = accepts[property]

      next if rule.nil? || !rule.fetch("writable")

      self.value(self.camel(property), value, rule, component)
    end

    self.by_id(node, component, accepts, found) + found
  end

  # A NODE NAMED AFTER A PROP CARRIES IT. AdwActionRow's template binds its title label's text to
  # the `title` property and leaves the subtitle one to be set from C, so the binding is there
  # for one and missing for the other -- but the node's id is `subtitle` and the component has a
  # `subtitle` prop, which is the same statement made another way.
  def self.by_id(node, component, accepts, found)
    id = self.camel(node.fetch("id", ""))
    text = component.fetch("text")

    if text.include?(id) && accepts.key?("label") && found.none?{|one| one.start_with?("label=")}
      ["label={#{id}}"]
    else
      []
    end
  end

  def self.value(prop, value, rule, component)
    if value.is_a?(Hash)
      bound = self.camel(value.fetch("bind"))

      component.fetch("props").key?(bound) ? "#{prop}={#{bound}}" : nil
    else
      self.literal(prop, value, rule)
    end
  end

  # A template writes every value as a string, so the type says what it means.
  def self.literal(prop, value, rule)
    case rule.fetch("type")
    when "boolean" then "#{prop}={#{value.downcase == 'true'}}"
    when "number" then value.match?(/\A-?\d+(\.\d+)?\z/) ? "#{prop}={#{value}}" : nil
    when "string" then "#{prop}=#{value.inspect}"
    when "enum" then rule.fetch("values").include?(value) ? "#{prop}=#{value.inspect}" : nil
    end
  end

  # The classes a node carries, as the first arguments to cn().
  def self.classes(classes)
    classes.fetch("base", []).map(&:inspect).join(", ").then{|list| list.empty? ? "" : "#{list}, "}
  end

  # Which of the component's props the markup actually reads, so the signature destructures
  # those and nothing else: an unused parameter is a lint error.
  def self.parameters(component, body)
    used = component.fetch("props").keys.select{|prop| body.match?(/[{=]#{Regexp.escape(prop)}[}\s]/)}

    (["className", "children"] + used.sort).join(", ")
  end

  # The components the markup renders, which is what it has to import.
  def self.elements(body)
    body.scan(/<([A-Z][A-Za-z0-9]*)/).flatten.uniq.sort
  end

  # `subtitle-lines` -> `subtitleLines`.
  def self.camel(name)
    parts = name.split("-")

    parts.first.to_s + parts.drop(1).map(&:capitalize).join
  end

  def self.register(root, components)
    path = File.join(root, "registry.json")
    registry = JSON.parse(File.read(path))
    existing = registry.fetch("items").map{|item| item.fetch("name")}

    components.sort.each do |name, component|
      slug = self.kebab(name)
      next if existing.include?(slug)

      registry["items"] << {
        "name" => slug,
        "type" => "registry:ui",
        "title" => name,
        "description" => "#{component['widget']}#{component['class'] ? " (#{component['class']})" : ''}.",
        "registryDependencies" => ["adwaita-theme", "gtk-enums"],
        "files" => [{ "path" => "registry/adwaita/ui/#{slug}.tsx", "type" => "registry:ui" }],
      }
    end

    File.write(path, "#{JSON.pretty_generate(registry)}\n")
  end
end

require "fileutils"
GenerateComponents.run(ARGV)
