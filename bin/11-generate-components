    # otherwise, and a toast which did not say so was 856x538 where the toolkit's is
    # 194x46: a dark rounded slab over the whole of bin/apps/software.
    "ToastWidget" => {
      imports: ['import { Icon } from "@/lib/icon"', 'import { Button } from "@/ui/button"'],
      props: ["  /** AdwToast:title, which the toast shows as its heading. */\n  title?: string\n\n  /** AdwToast:button-label. The action button is drawn when there is one. */\n  buttonLabel?: string"],
