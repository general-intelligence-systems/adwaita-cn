    # AdwViewSwitcherBar is an action bar whose centre is an AdwViewSwitcher, revealed or
    # not. Nothing of the pages is read here: the switcher inside reads them.
    "ViewSwitcherBar" => {
      imports: ['import { ViewSwitcher } from "@/ui/view-switcher"', 'import type { ViewPage } from "@/lib/view-pages"'],
      props: ["  /** The pages of the stack this switches between. */\n  pages?: ViewPage[]\n\n  /** The name of the page which is selected. The first, where none is named. */\n  visiblePage?: string"],
      body: <<~'TSX'.chomp,
        function ViewSwitcherBar({ className, render, stack: _stack, reveal, pages, visiblePage, children, ...props }: ViewSwitcherBarProps) {
          const { hidden, className: widgetClassName, style, attributes: widgetAttributes, rest } = widget(props)

          const defaultProps = {
            "data-slot": "view-switcher-bar",
            "data-node": "viewswitcherbar",
            className: cn("viewswitcherbar", "lay-col", widgetClassName, className),
            style,
            children: (
              <div data-slot="view-switcher-bar-action-bar" data-node="actionbar" className={cn("actionbar", "lay-col")}>
                <div data-slot="view-switcher-bar-revealer" data-node="revealer" className={cn("revealer", "lay-col", reveal ? "" : "hidden")}>
                  <div
                    data-slot="view-switcher-bar-center-box"
                    data-node="box"
                    className={cn("centerbox")}
                  >
                    <div data-node="box" className={cn("box", "box", "horizontal", "start")} />
                    <ViewSwitcher pages={pages} visiblePage={visiblePage} />
                    <div data-node="box" className={cn("box", "box", "horizontal", "end")} />
                  </div>
                </div>
                {children}
              </div>
            ),
            ...widgetAttributes,
          }

          return useRender({
            defaultTagName: "div",
            enabled: !hidden,
            render,
            props: mergeProps<"div">(defaultProps, rest),
          })
        }
      TSX
    },
    # AdwViewSwitcherSidebar is an AdwSidebar: a scrolled list with a row per page, each an
    # icon beside the page's title. The rows are AdwActionRow's shape -- `box.horizontal`
    # holding the image and a vertical box of title and subtitle -- rather than the rows
    # themselves, which is why they are written out and not composed from ActionRow.
    "ViewSwitcherSidebar" => {
      imports: ['import { Icon } from "@/lib/icon"', 'import type { ViewPage } from "@/lib/view-pages"'],
      props: ["  /** The pages of the stack this switches between. */\n  pages?: ViewPage[]\n\n  /** The name of the page which is selected. The first, where none is named. */\n  visiblePage?: string"],
      body: <<~'TSX'.chomp,
        function ViewSwitcherSidebar({ className, render, stack: _stack, filter, mode, placeholder, pages, visiblePage, children, ...props }: ViewSwitcherSidebarProps) {
          const { hidden, className: widgetClassName, style, attributes: widgetAttributes, rest } = widget(props)

          const shown = pages ?? []
          const selected = visiblePage ?? shown[0]?.name

          const defaultProps = {
            "data-slot": "view-switcher-sidebar",
            "data-node": "viewswitchersidebar",
            className: cn("viewswitchersidebar", "lay-col", widgetClassName, className),
            style,
            children: (
              <div data-slot="view-switcher-sidebar-sidebar" data-node="sidebar" className={cn("sidebar", "lay-col", "fills")}>
                <div data-slot="view-switcher-sidebar-scrolled-window" data-node="scrolledwindow" className={cn("scrolledwindow", "lay-col", "fills", "scrolls")}>
                  <div data-slot="view-switcher-sidebar-viewport" data-node="viewport" className={cn("viewport", "lay-col", "fills")}>
                    {/* A LIST BOX AND LIST BOX ROWS, by their own slots: the toolkit builds a
                        GtkListBox here and the comparison walks both sides in order, so a list
                        under a slot of its own went uncounted on this side while the toolkit's
                        was counted -- and every row after it in the application paired with
                        the wrong one. */}
                    <div data-slot="list-box" data-node="list" className={cn("list", "navigation-sidebar", "lay-col")}>
                      {shown.map((page) => (
                        <div
                          key={page.name}
                          data-slot="list-box-row"
                          data-node="row"
                          role="tab"
                          aria-selected={page.name === selected}
                          data-state={page.name === selected ? "checked" : "unchecked"}
                          className={cn("row", "box", "activatable", "lay-row")}
                        >
                          <div data-node="box" className={cn("box", "box", "horizontal", "sidebar-row")}>
                            {page.iconName === undefined ? null : <Icon name={page.iconName} data-node="image" className={cn("image", "icon")} />}
                            <div data-node="box" className={cn("box", "box", "vertical", "sidebar-row-text")}>
                              <span data-slot="label" data-node="label" className="title">{page.title}</span>
                              {/* The toolkit's row has a subtitle label whether or not there is
                                  a subtitle, and measures it at nothing when there is not. */}
                              <span data-slot="label" data-node="label" className="subtitle" />
                            </div>
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                </div>
                {children}
              </div>
            ),
            ...widgetAttributes,
          }

          return useRender({
            defaultTagName: "div",
            enabled: !hidden,
            render,
            props: mergeProps<"div">(defaultProps, rest),
          })
        }
      TSX
    },
    # AdwViewSwitcher builds one button per page of its stack, and each button holds BOTH
    # layouts in a GtkStack: `box.wide` is the icon beside the label and `box.narrow` the
    # icon above it, and the policy shows one of them. Both are rendered here because both
    # are in the toolkit's tree and the comparison walks the two in order; the one which is
    # not shown measures nothing, exactly as the toolkit's does.
    #
    # Every rule for this is already in the table, owned by `viewswitcher` and written
    # against `> button.toggle > stack > box.narrow > label`, so the nodes are what earn
    # the measurements and nothing is restated here.
    "ViewSwitcher" => {
      imports: ['import { Icon } from "@/lib/icon"', 'import { IndicatorBin } from "@/ui/indicator-bin"', 'import type { ViewPage } from "@/lib/view-pages"'],
      props: ["  /** The pages of the stack this switches between. */\n  pages?: ViewPage[]\n\n  /** The name of the page which is selected. The first, where none is named. */\n  visiblePage?: string"],
      body: <<~'TSX'.chomp,
        function ViewSwitcherButtonContent({ page, wide, shown }: { page: ViewPage; wide: boolean; shown: boolean }) {
          return (
            <div
              data-slot="view-switcher-button-box"
              data-node="box"
              aria-hidden={shown ? undefined : true}
              className={cn(
                wide ? "wide flex flex-row items-center justify-center" : "narrow flex flex-col items-center justify-center",
                "whitespace-nowrap",
                shown ? "" : "invisible pointer-events-none",
              )}
            >
              <IndicatorBin>
                {page.iconName === undefined ? null : <Icon name={page.iconName} data-node="image" className={cn("image")} />}
              </IndicatorBin>
              <span data-slot="label" data-node="label">{page.title}</span>
            </div>
          )
        }

        function ViewSwitcherButton({ page, selected, wide }: { page: ViewPage; selected: boolean; wide: boolean }) {
          return (
            <div
              data-slot="view-switcher-button"
              data-node="button"
              role="tab"
              aria-selected={selected}
              data-state={selected ? "checked" : "unchecked"}
              className={cn("button", "toggle", "flat", "lay-col", "view-switcher-toggle", "bin")}
            >
              {/* BOTH LAYOUTS MEASURED, one of them shown. A GtkStack asks every child for
                  its size and takes the largest, so a narrow switcher is still as wide as
                  its own wide layout -- which is where the toolkit's 100px per button comes
                  from, against the 36px a button came to when the layout it was not showing
                  was `display: none` and measured nothing. Overlapped in one grid cell and
                  hidden with `visibility`, the cell is the larger of the two either way. */}
              <div data-slot="view-switcher-button-stack" data-node="stack" className={cn("stack")}>
                <ViewSwitcherButtonContent page={page} wide shown={wide} />
                <ViewSwitcherButtonContent page={page} wide={false} shown={!wide} />
              </div>
            </div>
          )
        }

        function ViewSwitcher({ className, render, variant = "default", stack: _stack, policy, pages, visiblePage, children, ...props }: ViewSwitcherProps) {
          const { hidden, className: widgetClassName, style, attributes: widgetAttributes, rest } = widget(props)

          const wide = policy === "wide" || variant === "wide"
          const shown = pages ?? []
          const selected = visiblePage ?? shown[0]?.name

          const defaultProps = {
            "data-slot": "view-switcher",
            "data-node": "viewswitcher",
            "data-variant": variant,
            role: "tablist",
            "data-policy": policy,
            className: cn("viewswitcher", "lay-row", viewSwitcherVariants({ variant }), wide ? "wide" : "narrow", widgetClassName, className),
            style,
            children: (
              <>
                {shown.map((page) => (
                  <ViewSwitcherButton key={page.name} page={page} selected={page.name === selected} wide={wide} />
                ))}
                {children}
              </>
            ),
            ...widgetAttributes,
          }

          return useRender({
            defaultTagName: "div",
            enabled: !hidden,
            render,
            props: mergeProps<"div">(defaultProps, rest),
          })
        }
      TSX
    },
    "Avatar" => { body: <<~'TSX'.chomp },
      // adw-avatar.c: `(g_str_hash (text) % 14) + 1`, as a class on the gizmo. g_str_hash
      // is djb2 over the bytes, so the text is encoded before it is hashed -- a name with
      // an accent in it hashed by UTF-16 code unit picked a different colour from the one
      // the toolkit picks.
      function avatarColor(text: string | undefined) {
        if (!text) return "color1"

        let hash = 5381
        for (const byte of new TextEncoder().encode(text)) hash = (Math.imul(hash, 33) + byte) >>> 0

        return `color${(hash % 14) + 1}`
      }

      function Avatar({ className, render, iconName, customImage: _customImage, showInitials, size, text, children, ...props }: AvatarProps) {
        const { hidden, className: widgetClassName, style, attributes: widgetAttributes, rest } = widget(props)

        // The label when there are initials to show and the icon when there are not:
        // adw_avatar_set_show_initials toggles exactly one of the two children visible.
        //
        // ONE LETTER PER WORD, which is what adw_avatar_set_text means by initials:
        // `Adwaita::Avatar.new (32, "AL", true)` draws `A`, not `AL`, because "AL" is one
        // word. Shown whole, every avatar in bin/apps/library was a letter wider than the
        // toolkit's and the text was scaled down to fit a circle it should have filled.
        const initials = showInitials && text
          ? text.split(/\s+/).filter(Boolean).map((word) => [...word][0]).join("")
          : null

        const defaultProps = {
          "data-slot": "avatar",
          "data-show-initials": showInitials,
          "data-size": size,
          "data-text": text,
          className: cn("avatar", "group/avatar", widgetClassName, className),
          style: { ...style, ...(size === undefined ? {} : { minWidth: size }), ...(size === undefined ? {} : { minHeight: size }) } as React.CSSProperties,
          children: (
            <AvatarGizmo className={cn(avatarColor(text), "contrasted", "flex items-center justify-center overflow-hidden")}
              style={{ fontSize: size === undefined ? undefined : `${Math.round(size * 0.4)}px` }}>
              {initials === null ? (
                <AvatarImage name={iconName ?? "avatar-default-symbolic"} style={{ "--adw-icon-size": size === undefined ? undefined : `${Math.round(size * 0.6)}px` } as React.CSSProperties} />
              ) : (
                <AvatarLabel>{initials}</AvatarLabel>
              )}
              {children}
            </AvatarGizmo>
          ),
          ...widgetAttributes,
        }

        return useRender({
          defaultTagName: "div",
          enabled: !hidden,
          render,
          props: mergeProps<"div">(defaultProps, rest),
        })
      }
    TSX
  }.freeze

  # What `adw_view_stack_add_titled_with_icon` records about a page, and all a switcher
  # ever reads off a stack.
  #
  # A GtkStackPage is a GObject and not a widget, so it is not buildable and there is no
  # component for it. In GTK a switcher is handed the stack and walks its pages; a
  # component cannot be handed another component, so the pages are passed as data and
  # the application states them once for the stack and its switchers -- which is what
  # `stack.add_titled_with_icon` and `switcher.stack = stack` amount to between them.
  VIEW_PAGES_TS = <<~'TS'
    /** A page of an Adw.ViewStack, as its switchers read it. */
    export interface ViewPage {
      /** The name `adw_view_stack_add_titled` filed the page under. */
      name: string
      /** The page's title, which a switcher shows as its label. */
      title?: string
      /** The page's icon, which a switcher shows above or beside the label. */
      iconName?: string
      /** AdwViewStackPage:badge-number. Shown in the indicator when it is not zero. */
      badgeNumber?: number
      /** AdwViewStackPage:needs-attention. Shown as a dot when there is no badge. */
      needsAttention?: boolean
    }
  TS

  # `adw_preferences_group_add` asks whether what it was handed IS A ROW: an
  # AdwPreferencesRow goes into the group's list box and anything else is appended to the
  # group's box underneath it. A component cannot be asked what it descends from at
  # runtime, so the generator marks the ones which do, and PreferencesGroup reads the mark.
  #
  # Without it bin/apps/software drew its progress bar, level bar and spinner INSIDE the
  # card and above the row, where the toolkit draws them below it.
  def self.row_mark(name, component)
    return "" unless self.preferences_row?(name, component)

    "\n\n#{name}.isPreferencesRow = true"
  end

  def self.preferences_row?(name, component)
    return true if name == "PreferencesRow"

    parent = component["parent"]
    seen = self.components_by_name
    while parent
      return true if parent == "PreferencesRow"

      parent = seen.dig(parent, "parent")
    end
    false
  end

  class << self
    attr_accessor :components_by_name
  end

  def self.component(name, component, flags)
    props = component.fetch("props")
    appearance, sizes = AdwaitaClasses.split(self.offered(component))
    cva = !appearance.empty? || !sizes.empty?
    parts = component["tree"] ? self.parts(name, component) : []
    element = self.element(component)
    enums = self.enums_used(props)

    <<~TS
      // #{name}#{component['gtk'] ? " — #{component['gtk']}" : ''}
      //
      // Generated by bin/11-generate-components. The measurements are Adwaita's, read out
      // of its stylesheet#{component['template'] ? " and out of #{component['template']}" : ''}. The shape is shadcn/ui's, on Base UI.

      import * as React from "react"
      #{props.values.any?{|one| one.fetch('type') == 'node'} ? "import type { ReactNode } from \"react\"\n" : ''}#{cva ? "import { cva, type VariantProps } from \"class-variance-authority\"\n" : ''}import { mergeProps } from "@base-ui/react/merge-props"
      import { useRender } from "@base-ui/react/use-render"

      import { cn } from "@/lib/utils"
      #{(OWN_BEHAVIOUR[name] || {})[:imports].to_a.map{|line| "#{line}\n" }.join}#{self.draws_icon?(component, parts) ? "import { Icon } from \"@/lib/icon\"\n" : ''}#{STACKS.include?(name) ? "import { visibleChild } from \"@/lib/stack\"\n" : ''}import { widget } from "@/lib/widget"
      import type { WidgetProps } from "@/lib/widget-props"
      #{self.clamped?(name, component) ? "import { useClamp } from \"@/lib/clamp\"\n" : ''}#{SPLIT.include?(name) ? "import { useSplitView } from \"@/lib/split-view\"\n" : ''}#{enums.empty? ? '' : "import type { #{enums.join(', ')} } from \"@/lib/enums\"\n"}#{cva ? "\n#{self.cva(name, component, appearance, sizes)}\n" : ''}
      #{self.interface(name, component, props, flags, cva, element)}

      #{(OWN_BEHAVIOUR[name] || {})[:body] || self.root(name, component, props, cva, element, parts)}#{parts.map{|part| "\n\n#{part.fetch(:source)}"}.join}

      export { #{([name] + parts.map{|part| part.fetch(:name)} + (cva ? ["#{self.variants_name(name)}"] : [])).join(', ')} }#{self.row_mark(name, component)}
    TS
  end

  # Whether this component draws an icon anywhere: through an `icon-name` prop of its own,
  # or through an image node in its tree.
  def self.draws_icon?(component, parts)
    return true if component.fetch("props", {}).key?("iconName")

    found = false
    self.each_node(component["tree"]){|one| found ||= self.icon_part?(one) } if component["tree"]
    found && !parts.empty?
  end

  def self.cva(name, component, appearance, sizes)
    # Empty on purpose. A variant is THE NAME OF A STYLE CLASS and nothing else; what
    # that name means is in lib/adwaita-classes.ts, which cn resolves it through. A cva
    # which carried the measurements too was the same facts in two places, and the place
    # that could state a contextual rule was never this one.
    base = '""'
    keys = []

    unless appearance.empty?
      entries = appearance.sort.map do |style, variant|
        value = AdwaitaClasses.expression(variant["classes"], 8, name: style)
        "        /** .#{style}#{variant['summary'] ? " — #{variant['summary']}" : ''} */\n        #{self.camel(style)}: #{value},"
      end
      keys << "      variant: {\n#{appearance.key?('default') ? '' : "        default: \"\",\n"}#{entries.join("\n")}\n      },"
    end

    unless sizes.empty?
      entries = sizes.sort.map do |style, variant|
        value = AdwaitaClasses.expression(variant["classes"], 8, name: style)
        "        /** .#{style}#{variant['summary'] ? " — #{variant['summary']}" : ''} */\n        #{self.camel(style)}: #{value},"
      end
      keys << "      size: {\n#{sizes.key?('default') ? '' : "        default: \"\",\n"}#{entries.join("\n")}\n      },"
    end

    defaults = []
    defaults << "variant: \"default\"" unless appearance.empty?
    defaults << "size: \"default\"" unless sizes.empty?

    <<~TS.chomp
      const #{self.variants_name(name)} = cva(
        #{base},
        {
          variants: {
      #{keys.join("\n")}
          },
          defaultVariants: { #{defaults.join(', ')} },
        },
      )
    TS
  end

  def self.interface(name, component, props, flags, cva, element)
    # `variant` and `size` are the cva's, and the element may have its own of the same
    # name: `<input size>` is a number, and extending both at once is a type error.
    own = props.keys + (cva ? %w[variant size] : [])
    omit = own.map(&:inspect).join(" | ")
    extends = [
      "Omit<useRender.ComponentProps<#{element.inspect}>, keyof WidgetProps#{own.empty? ? '' : " | #{omit}"}>",
      "WidgetProps",
    ]
    extends << "VariantProps<typeof #{self.variants_name(name)}>" if cva

    declarations = props.sort.map{|prop, attributes| self.declaration(prop, attributes, flags)}
    declarations += (OWN_BEHAVIOUR[name] || {})[:props].to_a

    <<~TS.chomp
      export interface #{name}Props
        extends #{extends.join(",\n    ")} {#{declarations.empty? ? '' : "\n#{declarations.join("\n\n")}"}
      }
    TS
  end

  # The component itself.
  #
  # Base UI's useRender is what gives every component its element: `render` puts
  # a different one in its place, `enabled` is GTK's `visible` property, and the
  # props are merged rather than overwritten so a caller's handler runs beside
  # the component's own.
  #
  # Everything a GTK widget has that the DOM does not is resolved by widget();
  # the component's own properties become markup where they are markup and data
  # attributes where they are state, so none of them reaches the DOM as an
  # unknown attribute.
  # The states a CSS node is in because its WIDGET is, which is every state but the ones
  # about where the node sits among its siblings.
  #
  # GTK has one state per widget and its nodes are drawn from it: `check:checked` is a
  # check button which is checked, not a check node with a state of its own. The DOM has
  # no such inheritance -- a `<div>` is never `:disabled`, nobody hovers the 14px box
  # rather than the row it is in, and `data-state` is written on the component's own
  # element -- so every one of these on a part selected nothing at all. 770 rules across
  # the registry, which is why a checked check button drew an empty box, a switch never
  # took its accent colour and no part of any component answered the pointer.
  #
  # `first` and `last` are the exceptions: those really are about the node's position.
  POSITIONAL = %w[first last].to_set

  # A part's classes, with the widget's states restated as the group the component is.
  #
  # Tailwind's named group, keyed to the component, rather than a bare `group`: a button
  # inside a check button would otherwise answer the check button's state as well as its
  # own.
  def self.grouped(classes, group)
    return classes if classes.nil? || group.nil?

    classes.to_h do |state, list|
      next [state, list] if state == "base" || POSITIONAL.include?(state)

      [state.split(":").map{|one| POSITIONAL.include?(one) ? one : "group-#{one}/#{group}" }.join(":"), list]
    end
  end

  # A text property, as the label node GTK builds for it.
  #
  # `data-slot="label"` and not `<slug>-label`: this is a Gtk.Label in the toolkit's own
  # tree, which is what bin/15-app-report pairs against, and a slot named after its
  # parent is a part rather than the widget it actually is.
  #
  # The component which is itself a label renders the text into its own element, because
  # there the root already is the node.
  def self.text_markup(prop, component)
    return "              {#{prop}}" if component["node"] == "label"

    "              {#{prop} === undefined ? null : (\n" \
      "                <span data-slot=\"label\" data-node=\"label\" data-xalign=\"center\" data-yalign=\"center\" className={cn(\"label\")}>\n" \
      "                  {#{prop}}\n" \
      "                </span>\n" \
      "              )}"
  end

  # What goes where the children go. A stack shows one of them.
  def self.children_markup(name, props)
    return "{children}" unless STACKS.include?(name)

    props.key?("visibleChildName") ? "{visibleChild(children, visibleChildName)}" : "{visibleChild(children)}"
  end

  def self.root(name, component, props, cva, element, parts)
    # A <textarea> HOLDS TEXT AND NOTHING ELSE. React puts whatever children it is given into
    # the value, so the parts a text view builds came out as the literal string
    # `[object Object]` sitting in the box. It takes no children for the same reason an
    # <input> takes none, and what it shows is its value.
    void = VOID.include?(element) || element == "textarea"
    appearance, sizes = AdwaitaClasses.split(self.offered(component))
    slug = self.kebab(name)

    text = void ? [] : component.fetch("text", []) & props.keys
    nodes = void ? [] : props.select{|_prop, one| one.fetch("type") == "node"}.keys
    icons = props.keys.select{|prop| prop == "iconName"}
    markup = text + nodes + icons
    # Neither markup nor an attribute. A GListModel is not a string and `data-model="[object
    # Object]"` is what writing one to the DOM produces, so these are destructured out of the
    # rest and go no further.
    objects = props.select{|_prop, one| one.fetch("type") == "object"}.keys - markup
    data = props.keys - markup - objects

    attributes = ["\"data-slot\": #{slug.inspect}"]
    # The CSS node the widget is, which is what the stylesheet addresses it by. A style
    # class states rules about what is inside the widget it is put on --
    # `.navigation-sidebar > row` -- and `row` is not a slot name, because a slot is one
    # component and `row` is every kind of row there is.
    attributes << "\"data-node\": #{component['node'].inspect}" if component["node"]
    attributes << "ref: clampRef" if CLAMPED.include?(name) || SPLIT.include?(name)
    attributes << '"data-variant": variant' unless appearance.empty?
    attributes << '"data-size": size' unless sizes.empty?
    role = ROLES[component["node"]]
    attributes << "role: #{role.inspect}" if role
    type = TYPE_ATTRS[component["node"]]
    # Only where the component is the input. A widget which builds a text node inside
    # itself renders as the container, and `type="text"` on a `<div>` is nothing.
    attributes << "type: #{type.inspect}" if type && element == "input"

    data.sort.each do |prop|
      if STATES.key?(prop) && props.fetch(prop).fetch("type") == "boolean"
        attributes.concat(STATES.fetch(prop))
      elsif PLAIN.key?(prop) && %w[input textarea].include?(element)
        attributes << "#{PLAIN.fetch(prop)}: #{prop}"
      elsif STATES.key?(prop)
        # A property which shares its NAME with a GTK state but is not that state.
        # AdwComboRow's `selected` is which row is chosen, a number, and writing it as
        # `data-selected` put the attribute the stylesheet's `:selected` is generated
        # as on every combo row there is -- so a row showing its first item was drawn
        # in the selection's blue, with white text, in every preferences page.
        attributes << "\"data-#{self.kebab(prop)}-value\": #{prop}"
      else
        attributes << "\"data-#{self.kebab(prop)}\": #{prop}"
      end
    end

    # Two properties can want the same attribute -- Gtk.Switch has `state` of its
    # own as well as `active` -- and an object literal cannot name one twice, so
    # the first to claim it keeps it.
    attributes = attributes.uniq{|one| one[/\A[^:]+/] }
    written = attributes.join(" | ")

    taken = ["className", "render"]
    taken << "variant = \"default\"" unless appearance.empty?
    taken << "size = \"default\"" unless sizes.empty?
    taken.concat(markup.sort)
    taken.concat(objects.sort.map{|prop| "#{prop}: _#{prop}" })
    taken.concat(data.sort.map do |prop|
      # A property whose attribute another one claimed is still destructured, so
      # that it does not reach the DOM, and named as the unused value it now is.
      written.match?(/[:\s]#{Regexp.escape(prop)}\b/) ? prop : "#{prop}: _#{prop}"
    end)
    taken << (void ? "children: _children" : "children")

    arguments = []
    arguments << "variant" unless appearance.empty?
    arguments << "size" unless sizes.empty?
    classes =
      if cva
        "#{self.variants_name(name)}({ #{arguments.join(', ')} })"
      else
        nil
      end

    inner = []

    # A template says where its children go; a tree read out of the stylesheet does not, and
    # only the second needs the node guessed at. Guessing at it for a template put a
    # preferences group's rows in the box its own .ui builds rather than in its boxed list, and
    # the group lost the card it draws around them.
    slot = component["tree"] ? self.slot(component.fetch("tree"), derived: component["template"].nil?) : nil

    if component["tree"] && !void
      children = (component.fetch("tree").fetch("slots", {}).values +
        component.fetch("tree").fetch("children", []))
        .select{|child| self.rendered?(child, props)}
      inner.concat(
        children.map{|child| self.tree(child, props, 14, slot, self.control_attributes(props), slug) }
          .reject(&:empty?),
      )
      # ONLY WHAT IS ACTUALLY DRAWN. A part is generated for every node in the tree, but a
      # node the component does not render holds nothing, so a prop counted as bound to one
      # was taken out of the markup and never put back: AdwCheckButton's label node is not
      # drawn, and subtracting it dropped `Remember me` off every check button in the
      # registry while the text it was meant to stop duplicating was in a node which IS
      # drawn, inside AdwButtonContent's box.
      drawn = []
      self.each_node(component.fetch("tree")) do |one|
        drawn << self.bound(one, component.fetch("props")) if self.rendered?(one, props)
      end
      bound = parts.map{|part| part.fetch(:bound)}.compact & drawn.compact
      placed = []
      self.each_node(component.fetch("tree")) do |one|
        placed << one["takes"] if one["takes"] && one["takes"] != "children"
      end
      text -= bound
      icons -= bound
      nodes -= (bound + placed)
    end

    icons.each do |prop|
      # The name is a GTK icon name and `Icon` is what turns one into a drawing:
      # `gtk_button_set_icon_name (button, "go-previous-symbolic")` and
      # `<Button iconName="go-previous-symbolic" />` reach the same icon in adwaita_react.
      # Only when the caller named one. An Icon with no name drew its own empty box, and a
      # button which takes an icon but was given a label rendered that box beside the label:
      # the blank squares in every toolbar, every file in the icon grid, and the gap before
      # the first toggle in a toggle group.
      inner << "              {#{prop} === undefined ? null : (\n" \
        "                <Icon name={#{prop}} data-slot=#{"#{slug}-icon".inspect} data-node=\"image\" className={cn(\"image\")} />\n" \
        "              )}"
    end
    # A widget's text is a label node, not a bare run of characters. gtk_button_set_label
    # builds a GtkLabel inside the button and the stylesheet addresses it --
    # `button.image-text-button > box > label` is 0.5 of padding on the label and not on
    # the button -- so text written straight into the element was styled by none of those
    # rules and appeared in neither tree as the label it is. The component which already
    # IS a label is left alone, because the root is the node.
    inner.concat(text.sort.map{|prop| self.text_markup(prop, component)})

    # The content first and the bars after it, because that is the order the widget tree
    # is in: AdwToolbarView parents its content before its revealers, and both sides are
    # walked in order and paired in order, so a page whose header bar came first paired
    # its back button with the toolkit's spin buttons and everything after it slid along
    # by one. Where the content goes on the screen is `order`, below, and not where it is
    # written.
    inner.concat(self.in_order(nodes).map{|prop| "              #{self.node_markup(slug, name, prop)}"})
    inner << "              #{self.children_markup(name, props)}" unless void || slot

    fields = attributes.dup
    # The group the parts read the widget's state off, named after the component so
    # that a component nested in another answers only its own.
    group = parts.empty? ? "" : "\"group/#{slug}\", "
    # The node is cn's first argument, which is the context the names after it resolve in:
    # `cn("button", "flat")` is the component saying what GTK says.
    named = component["node"].nil? || component["node"].empty? ? "" : "#{component['node'].inspect}, "
    fields << "className: cn(#{named}#{group}#{self.layout(name, component)}#{classes ? "#{classes}, " : ''}#{self.track(component)}#{self.applied_classes(component)}#{self.content_classes(component)}widgetClassName, className)"
    fields << self.style(name, component, props)
    # One child needs no fragment; several do. A lone `{expr}` is the expression
    # itself, because an object literal's value is not JSX.
    # The node a widget's own C builds around whatever it is given. GTK's scrolled window
    # puts a GtkViewport around a child which cannot scroll itself, and the stylesheet is
    # written against it -- `statuspage > scrolledwindow > viewport > box > clamp > box` is
    # where a status page's margins, its spacing and its 128px icon are stated, and without
    # the viewport in the tree not one of those rules reaches anything.
    inner = self.wrapped(name, inner)

    unless inner.empty?
      only = inner.first.strip

      fields <<
        if inner.length == 1 && only.match?(/\A\{.+\}\z/)
          "children: #{only[1..-2]}"
        elsif inner.length == 1
          "children: (\n        #{only}\n      )"
        else
          "children: (\n        <>\n#{inner.map{|one| "    #{one}" }.join("\n")}\n        </>\n      )"
        end
    end

    <<~TS.chomp
      function #{name}({ #{taken.join(', ')}, ...props }: #{name}Props) {
        const { hidden, className: widgetClassName, style, attributes: widgetAttributes, rest } = widget(props)
      #{self.clamp_hook(name, props)}
        // Named rather than passed inline: a fresh object literal handed straight
        // to mergeProps is excess-property checked against the element's props,
        // which no data attribute of ours is one of.
        const defaultProps = {
      #{fields.map{|field| "    #{field},"}.join("\n")}
          ...widgetAttributes,
        }

        return useRender({
          defaultTagName: #{element.inspect},
          enabled: !hidden,
          render,
          props: mergeProps<#{element.inspect}>(defaultProps, rest),
        })
      }
    TS
  end

  # A clamp measures itself, because the width it gives its child is a curve rather than
  # a cap. Nothing else needs a hook.
  # What each widget's C wraps its children in, by the CSS node it builds.
  WRAPS = { "ScrolledWindow" => "viewport" }.freeze

  # The same, for a scrolled window a composite builds inside itself: AdwStatusPage's
  # template names one, and the stylesheet reaches through its viewport just the same.
  WRAPS_NODE = { "scrolledwindow" => "viewport" }.freeze

  # The scrollbars a GtkScrolledWindow builds in its own C, which the stylesheet measures as
  # `scrollbar > range > trough > slider` and which nothing declarative states.
  SCROLLBARS = [
    %w[bottom horizontal overlay-indicator],
    %w[overlay-indicator right vertical],
  ].freeze

  def self.scrollbars(slug)
    SCROLLBARS.flat_map do |classes|
      edge = classes.include?("vertical") ? "vertical" : "horizontal"

      [
        "<div data-slot=#{"#{slug}-scrollbar-#{edge}".inspect} data-node=\"scrollbar\" " \
          "className={cn(\"scrollbar\", #{classes.map(&:inspect).join(', ')})}>",
        "  <div data-node=\"range\" className={cn(\"range\", #{edge.inspect})}>",
        "    <div data-node=\"trough\" className={cn(\"trough\")}>",
        "      <div data-node=\"slider\" className={cn(\"slider\")} />",
        "    </div>",
        "  </div>",
        "</div>",
      ]
    end
  end

  def self.wrapped(name, inner)
    node = WRAPS[name]

    return inner if node.nil? || inner.empty?

    [
      "<div data-slot=#{self.kebab(name).concat('-', node).inspect} data-node=#{node.inspect} " \
        "className={cn(#{node.inspect})}>",
      *inner.map{|one| "  #{one}" },
      "</div>",
      *self.scrollbars(self.kebab(name)),
    ]
  end

  def self.clamp_hook(name, props)
    if SPLIT.include?(name)
      options = %w[minSidebarWidth maxSidebarWidth sidebarWidthFraction unit]
        .select{|prop| props.key?(prop) }

      return <<~TS.chomp
        \n  const { ref: clampRef, columns: clampColumns } = useSplitView<HTMLDivElement>({ #{options.join(', ')} })
      TS
    end

    return "" unless CLAMPED.include?(name)

    options = %w[maximumSize tighteningThreshold unit].select{|prop| props.key?(prop) }

    <<~TS.chomp
      \n  const { ref: clampRef, columns: clampColumns } = useClamp<HTMLDivElement>({ #{options.join(', ')} })
    TS
  end

  # The order a widget's own child props are packed in, where the alphabet is not it: a
  # split view puts its sidebar before its content, and `content` sorts first.
  # `endChild` sorts before `startChild`, and a paned drew its second pane in its first
  # track: the clock list where bin/apps/clocks puts its sidebar, and the sidebar where it
  # puts the list.
  ORDER = %w[
    titlebar startWidget startChild start sidebar centerWidget center content child
    endChild endWidget end bottomBar
  ].freeze

  def self.in_order(nodes)
    nodes.sort_by{|prop| [ORDER.index(prop) || ORDER.length, prop] }
  end

  # A node prop, as the markup which renders it. The one the widget fills with whatever
  # space is left is wrapped in the element which takes that space, because a prop is a
  # ReactNode and there is no class to put on it: a caller hands a toolbar view a page
  # and the page is laid out by the view, not by itself.
  # What the widget's C draws there when the caller names nothing. AdwHeaderBar builds an
  # AdwWindowTitle for its title when no title-widget is set, and the stylesheet is written
  # against `headerbar ... label.title`: with nothing rendered the node was not there at all.
  DEFAULTED = {
    "HeaderBar" => {
      "titleWidget" =>
        '<span data-slot="header-bar-title-label" data-node="label" data-xalign="center" ' \
        'data-yalign="center" className={cn("label", "title")} />',
    },
  }.freeze

  def self.node_markup(slug, name, prop)
    fallback = DEFAULTED.dig(name, prop)

    return "{#{prop} ?? (\n                #{fallback}\n              )}" unless fallback.nil?

    return "{#{prop}}" unless FILLS[name] == prop

    "<div data-slot=#{"#{slug}-#{self.kebab(prop)}".inspect} className={cn(\"toolbar-view-content\")}>{#{prop}}</div>"
  end

  # The style the element carries: what Gtk.Widget's own properties resolved to, and the
  # sizing properties this component has of its own, which GEOMETRY names.
  #
  # A length a caller passes is a style and never a class. Tailwind generates a rule for
  # every class name it finds written in the sources, so `gap-[${spacing}px]` -- a name
  # that only exists once the component has been handed a number -- has no rule behind it
  # and does nothing at all.
  def self.style(name, component, props)
    found = GEOMETRY.fetch(name, {}).select{|prop, _| props.key?(prop) }
      .flat_map{|prop, properties| properties.map{|css| "...(#{prop} === undefined ? {} : { #{css}: #{prop} })" } }

    if self.layout_kind(name, component).start_with?("box") && props.key?("spacing")
      found << '...(spacing === undefined ? {} : { gap: `${spacing}px` })'
    end

    # A wrapping container spaces its lines and its children separately, which is `gap`
    # with two lengths. Named differently by each of the two widgets which wrap.
    GAPS.fetch(name, []).select{|prop| props.key?(prop) }.then do |(down, across)|
      next if down.nil? || across.nil?

      found << "gap: `${#{down} ?? 0}px ${#{across} ?? 0}px`"
    end

    if CLAMPED.include?(name) || SPLIT.include?(name)
      found << "...(clampColumns === undefined ? {} : { gridTemplateColumns: clampColumns })"
    end

    # A GtkPaned's `position` is how long its first pane is, in pixels, and the second takes
    # what is left. The stylesheet states neither, because GtkPanedLayout measures it, so a
    # paned with no tracks of its own ran its two panes one under the other: the clock list and
    # the sidebar beside it in bin/apps/clocks came out stacked.
    if PANED.include?(name)
      found << "...(position === undefined ? {} : orientation === \"vertical\" " \
        "? { gridTemplateRows: `${position}px 1fr` } : { gridTemplateColumns: `${position}px 1fr` })"
    end

    return "style" if found.empty?

    "style: { ...style, #{found.join(', ')} } as React.CSSProperties"
  end

  # A composite's parts, as sibling functions in the same file: libadwaita ships a .ui
  # for twenty-nine of these and bin/06-component-trees read them, so each widget under
  # the root becomes one function, named for the id the template gave it.
  # Marks the node the component's children are rendered into, so that the parts know not to
  # hide the one thing the component is for.
  def self.mark_slot!(component)
    tree = component["tree"]
    return if tree.nil?

    slot = self.slot(tree, derived: component["template"].nil?)
    slot["slot?"] = true if slot
  end

  def self.parts(name, component)
    found = []
    self.mark_slot!(component)
    self.walk(component.fetch("tree"), name, component, found, Set.new, root: true)
    found
  end

  def self.widget_node?(node)
    klass = node.fetch("class")

    !NOT_WIDGETS.include?(klass) && NOT_WIDGET_PREFIXES.none?{|one| klass.start_with?(one)}
  end

  # Whether a node is DRAWN, which is a narrower question than whether it is a widget. A node
  # the toolkit's documentation puts in brackets -- `[progress[.pulse]]` under entry, `[value]`
  # under scale -- is one the widget adds when it is asked for it, so it is not written into
  # the markup. The part is still generated, because a caller who does want one needs it.
  def self.rendered?(node, props = {})
    return false unless self.widget_node?(node)
    return false if NOT_DRAWN.include?(node["node"])
    # The item node is the shape of what the caller puts in, not a thing to put in.
    return false if node["item"]
    # Unless the component has the value which fills it: a level bar's block is drawn twice in
    # the documentation to say there can be several, and a scale's highlight is bracketed
    # because it appears only with an origin, but a bar given a value HAS one of each and
    # drawing neither left both of them an empty trough.
    return true if self.proportion(node, props)

    !node["optional"]
  end

  def self.walk(node, parent, component, found, seen, root: false)
    children = (node.fetch("slots", {}).values + node.fetch("children", []))
      .select{|child| self.widget_node?(child)}

    unless root
      label = self.pascal(node["id"] || node.fetch("class"))
      base = "#{parent}#{label}"
      suffix = 1
      suffix += 1 while seen.include?(suffix == 1 ? base : "#{base}#{suffix}")
      node["part"] = suffix == 1 ? base : "#{base}#{suffix}"
      seen << node.fetch("part")
    end

    children.each{|child| self.walk(child, parent, component, found, seen)}

    unless root
      found << {
        name: node.fetch("part"),
        bound: self.bound(node, component.fetch("props")),
        source: self.part(node, self.element_for(node, component.fetch("props", {})), self.kebab(parent)),
      }
    end
  end

  # What a template says about where its node sits and whether it takes the space left:
  # adw-action-row.ui gives its title box `hexpand="True"` and `valign="center"`, and a
  # part which dropped them was its own width in the middle of a row rather than all of
  # the width between the prefixes and the suffixes.
  TEMPLATE_ALIGN = { "halign" => "data-halign", "valign" => "data-valign" }.freeze
  TEMPLATE_EXPAND = { "hexpand" => "data-hexpand", "vexpand" => "data-vexpand" }.freeze

  def self.part_style(node)
    found = node.fetch("properties", {})["opacity"]

    return "" unless found.is_a?(String) && found.match?(/\A[\d.]+\z/)

    # adw-entry-row.ui stacks two titles in the same place and fades between them, the
    # second at `opacity="0"`. Ignoring it drew both at once, so every entry row had its
    # own title written over itself.
    "\n        style={{ opacity: #{found} }}"
  end

  def self.part_attributes(node)
    properties = node.fetch("properties", {})

    found = TEMPLATE_ALIGN.filter_map do |property, attribute|
      value = properties[property]

      next if value.nil? || value == "fill"

      "#{attribute}=#{value.inspect}"
    end

    found += TEMPLATE_EXPAND.filter_map do |property, attribute|
      properties[property] == "True" ? "#{attribute}=\"\"" : nil
    end

    self.label_node?(node) ? found + self.label_attributes(properties).grep(/\Adata-/) : found
  end

  # An `<input>` asks to be about twenty characters wide and will not go below it, which
  # is not a statement GTK's text node makes: a GtkText is as narrow as it is allowed to
  # be and the entry around it carries the minimum. Left alone, the search entry in a
  # sidebar's header bar made the sidebar 287px wide where the toolkit makes it 225.
  # `basis-0` and not `w-0`: a flex item sized from its basis fills the line, and a GRID item
  # ignores the basis and stretches to its cell. adw-entry-row.ui stacks its text and its two
  # titles in one place, which is a grid, and `w-0` left the text 0px wide -- an entry row drew
  # its title and never its value.
  TEXT_CLASSES = "min-w-0 basis-0 grow"

  # A popover is not part of what a widget looks like at rest. GTK puts one on a surface
  # of its own and only maps it when it is opened, which is why the toolkit measures a
  # combo row's popover at 0x0 -- and why rendering one inline drew the whole menu, the
  # search entry and the list over the top of the row it belongs to.
  POPOVER_NODES = %w[popover contents].to_set

  # A GtkLabel PLACES ITS TEXT inside its own allocation: `xalign` across, `yalign` down,
  # and `justify` between the lines of one which wraps. Both aligns are 0.5 unless a
  # template says otherwise -- AdwActionRow's title says `xalign="0"` and AdwStatusPage's
  # says nothing at all -- so a label which fills its row shows its text in the middle of
  # it, and that is the toolkit's default rather than the exception.
  #
  # A `span` has none of this. Text sits at the top left of whatever box it is in, so
  # every button in the registry wore its label against the top of its pill, and the
  # title, the description and the buttons of AdwStatusPage were left against the icon
  # they are supposed to sit under.
  ALIGNMENTS = { "0" => "start", "0.0" => "start", "0.5" => "center", "1" => "end", "1.0" => "end" }.freeze

  # `justify` is how the LINES of a wrapped label sit against each other, which is
  # `text-align`, and is not `xalign`, which is where the block of them sits.
  JUSTIFICATIONS = {
    "left" => "text-left", "right" => "text-right", "center" => "text-center", "fill" => "text-justify",
  }.freeze

  # What every label does, and the rules which read the alignment off the one in hand.
  LABEL_CLASSES = [
    "flex",
    "[&[data-xalign=start]]:justify-start",
    "[&[data-xalign=center]]:justify-center",
    "[&[data-xalign=end]]:justify-end",
    "[&[data-yalign=start]]:items-start",
    "[&[data-yalign=center]]:items-center",
    "[&[data-yalign=end]]:items-end",
  ].join(" ").freeze

  # The alignment a label was given, as the attributes those rules select on.
  def self.label_attributes(properties)
    [
      "data-xalign=#{ALIGNMENTS.fetch(properties["xalign"].to_s, "center").inspect}",
      "data-yalign=#{ALIGNMENTS.fetch(properties["yalign"].to_s, "center").inspect}",
      JUSTIFICATIONS[properties["justify"].to_s],
    ].compact
  end

  # Whether this node is a label, and so places its text rather than simply holding it.
  # Whether this node already builds a label of its own, in which case the text it binds is
  # drawn there and a second one is the same words twice.
  def self.draws_label?(node)
    found = false
    self.each_node(node){|one| found ||= self.label_node?(one) && !one.equal?(node) }
    found
  end

  def self.label_node?(node)
    node["node"] == "label" || node.fetch("class", nil) == "Label"
  end

  def self.part(node, element, group = nil)
    classes = nil
    # A popover nested in another widget is not drawn inline, and that is the one thing here
    # which is a question about this tree rather than about the node: AdwPopover IS the
    # popover, so hiding the `contents` its children go in hid its own menu.
    utility = [node["utility"],
               (POPOVER_NODES.include?(node["node"]) && !node["slot?"] ? "hidden" : nil)].compact.join(" ")
    named = node["node"].nil? || node["node"].empty? ? "" : "#{node['node'].inspect}, "
    layout = "#{named}#{self.part_layout(node)}#{utility.empty? ? '' : "#{utility.inspect}, "}"

    return self.clamp_part(node, classes, layout) if CLAMPED.include?(node.fetch("class"))

    attributes = self.part_attributes(node).map{|one| "\n        #{one}" }.join
    slot = (node["slot"] || self.kebab(node.fetch("part"))).inspect
    node_attribute = node["node"] ? "\n        data-node=#{node['node'].inspect}" : ""

    # An image node is an icon and nothing else, so the part renders through `Icon` rather
    # than through a `<span>` of its own. `icon` is the name the toolkit's own C puts
    # there where the stylesheet names none -- a spin button's minus and plus, a window's
    # close cross -- and it is a default rather than a fixed value, so a caller can still
    # say which icon an image draws.
    if self.icon_part?(node)
      return <<~TS.chomp
        function #{node.fetch('part')}({ className#{node['icon'] ? ", name = #{node.fetch('icon').inspect}" : ''}, ...props }: React.ComponentProps<typeof Icon>) {
          return (
            <Icon#{node['icon'] ? "\n        name={name}" : ''}
              data-slot=#{slot}#{node_attribute}#{attributes}#{self.part_style(node)}
              className={cn(#{layout}#{classes ? "#{classes}, " : ''}className)}
              {...props}
            />
          )
        }
      TS
    end

    wrap = WRAPS_NODE[node["node"]]

    return <<~TS.chomp unless wrap.nil?
      function #{node.fetch('part')}({ className, children, ...props }: React.ComponentProps<#{element.inspect}>) {
        return (
          <#{element}
            data-slot=#{slot}#{node_attribute}#{attributes}#{self.part_style(node)}
            className={cn(#{layout}#{classes ? "#{classes}, " : ''}className)}
            {...props}
          >
            <div data-slot=#{"#{node['node']}-#{wrap}".inspect} data-node=#{wrap.inspect} className={cn(#{wrap.inspect})}>
              {children}
            </div>
      #{self.scrollbars(node['node']).map{|one| "      #{one}" }.join("\n      ")}
          </#{element}>
        )
      }
    TS

    <<~TS.chomp
      function #{node.fetch('part')}({ className, ...props }: React.ComponentProps<#{element.inspect}>) {
        return (
          <#{element}
            data-slot=#{slot}#{node_attribute}#{attributes}#{self.part_style(node)}
            className={cn(#{layout}#{classes ? "#{classes}, " : ''}className)}
            {...props}
          />
        )
      }
    TS
  end

  # A template node which draws an icon: the toolkit's image nodes, and anything the
  # constructed trees named an icon on.
  def self.icon_part?(node) = node.fetch("class") == "Image" || !node["icon"].nil?

  # A clamp inside a template is as much a clamp as one a caller makes: AdwPreferencesPage
  # is a scrolled window holding one, and a page whose clamp was a plain div was the full
  # width of the window rather than the width the layout manager eases it to.
  def self.clamp_part(node, classes, layout)
    options = node.fetch("properties", {}).slice("maximum-size", "tightening-threshold", "unit")
      .filter_map{|key, value| "#{self.camel(key)}: #{value.is_a?(String) && value.match?(/\A\d+\z/) ? value : value.inspect}" }

    <<~TS.chomp
      function #{node.fetch('part')}({ className, style, ...props }: React.ComponentProps<"div">) {
        const { ref, columns } = useClamp<HTMLDivElement>({ #{options.join(', ')} })

        return (
          <div
            ref={ref}
            data-slot=#{self.kebab(node.fetch('part')).inspect}#{node['node'] ? "\n        data-node=#{node['node'].inspect}" : ''}
            className={cn(#{layout}#{classes ? "#{classes}, " : ''}className)}
            style={{ ...style, ...(columns === undefined ? {} : { gridTemplateColumns: columns }) }}
            {...props}
          />
        )
      }
    TS
  end

  # Whether anything in this file needs the clamp's arithmetic: the component itself, or
  # a clamp its template holds.
  def self.clamped?(name, component)
    return true if CLAMPED.include?(name)
    return false unless component["tree"]

    found = false
    self.each_node(component.fetch("tree")){|node| found ||= CLAMPED.include?(node.fetch("class")) }
    found
  end

  def self.each_node(node, &block)
    block.call(node)
    node.fetch("children", []).each{|child| self.each_node(child, &block) }
    node.fetch("slots", {}).each_value{|slot| self.each_node(slot, &block) }
  end

  # Where a composite's children go: the last container the template leaves
  # empty, which is the slot it keeps for them; failing that the innermost
  # container it does fill; failing that the root.
  # Where a widget's C puts what it is given, when the template does not say. AdwStatusPage
  # adds its child to the box the clamp sits in, not inside the clamp -- the toolkit's tree
  # has it as the clamp's sibling, and nesting it inside put the status page's buttons in the
  # clamped column instead of under it.
  SLOT_IDS = { "StatusPage" => "toplevel_box" }.freeze

  def self.slot(node, derived: true)
    wanted = SLOT_IDS[node["class"]]

    unless wanted.nil?
      found = nil
      self.each_node(node){|one| found ||= one if one["id"] == wanted }

      return found unless found.nil?
    end

    said = nil
    self.each_node(node){|one| said ||= one if one["takes"] == "children" }

    return said if said

    # A tree read out of the stylesheet or the documentation names no slot, because neither
    # says where a widget puts what it is given. The node which holds it is the one the widget
    # draws its own content in: a drop down's `button`, a menu button's `button`, the `box` in
    # a composite. Without this the children were written after the widget's parts rather than
    # inside them, and a drop down rendered an empty button with its label beside it.
    return self.fallback_slot(node) unless derived

    found_slot = nil
    self.each_node(node) do |one|
      next unless one["css-node"] && CONTENT_SLOTS.include?(one["node"])
      next unless (one.fetch("children", []) + one.fetch("slots", {}).values).empty?
      next unless self.rendered?(one)

      found_slot ||= one
    end

    return found_slot if found_slot

    self.fallback_slot(node)
  end

  # Where a template puts them: the last container it leaves empty, failing that the innermost
  # container it does fill, failing that the root.
  def self.fallback_slot(node)
    found = []
    self.containers(node, found, 0)

    found = found.select{|one| self.rendered?(one.fetch(:node)) }

    found.select{|one| one.fetch(:empty) }.last&.fetch(:node) ||
      found.max_by{|one| one.fetch(:depth) }&.fetch(:node)
  end

  def self.containers(node, found, depth)
    children = (node.fetch("slots", {}).values + node.fetch("children", []))
      .select{|child| self.widget_node?(child) }

    if depth.positive? && CONTAINERS.include?(node.fetch("class"))
      found << { node: node, depth: depth, empty: children.empty? }
    end

    children.each{|child| self.containers(child, found, depth + 1) }
  end

  # A template node's layout, with the direction and spacing the template sets on it.
  # A template node whose widget lays its children out in C, named by the id the template
  # gives it. AdwEntryRow's editable area is an AdwGizmo with a measure and an allocate of
  # its own which put the title, the text, the indicator and the apply button all in the
  # same box -- the title sits over the text and slides up when the row is focused -- and
  # read as a widget with no layout at all it stacked the six of them down the page and
  # made every entry row 99px tall instead of 55.
  HAND_LAID_PARTS = { "editable_area" => "overlay" }.freeze

  # A node inside a template is as much the widget it is as one a caller makes.
  #
  # HAND_LAID says what a widget which allocates in C amounts to, and the root of a
  # component was the only thing reading it: a node of class `ActionRow` or `Entry` or
  # `Gizmo` inside somebody else's tree got no arrangement at all and fell into the
  # document's own flow. 94 nodes across the registry were in that state -- which is why
  # AdwBanner drew its title above its button, in a strip 61px tall where the toolkit's
  # is 46.
  def self.node_layout(node)
    HAND_LAID_PARTS[node["id"]] || node["layout"] || HAND_LAID[node.fetch("class")]
  end

  def self.part_layout(node)
    kind = CLAMPED.include?(node.fetch("class")) ? :clamped : self.node_layout(node)
    properties = node.fetch("properties", {})
    single = self.single_child?(node)
    gizmo = node.fetch("class") == "Gizmo" && !single
    boxed = (kind.to_s.start_with?("box") || (kind.nil? && gizmo)) &&
            !self.laid_out?(node) && !(self.leaves || Set.new).include?(node["node"])
    manager = self.manager(kind, single_child: single, gizmo: gizmo)
    named = (self.conflicted || Set.new).include?(node["node"]) && !manager.empty? ? "#{manager.inspect}, " : ""
    # THE STYLE CLASSES THE TEMPLATE PUTS ON IT. `<class name="icon"/>` is what
    # adw-status-page.ui says about its image, and `statuspage > ... > box > .icon` is where
    # the 128px icon is stated: without the name the rule reaches nothing and every status
    # page drew a 16px icon.
    named += Array(node["styles"]).map{|one| "#{one.inspect}, " }.join

    return named unless boxed

    vertical = kind == "box-vertical" || properties["orientation"] == "vertical"
    orientable = node["node"] == "box"

    "#{named}#{(vertical ? (orientable ? 'vertical' : LAY_COL) : (orientable ? 'horizontal' : LAY_ROW)).inspect}, "
  end

  # The text a template node shows: the property it binds to `label`, or the component
  # prop its id is named after.
  def self.bound(node, props)
    label = node.fetch("properties", {})["label"]

    if label.is_a?(Hash) && props.key?(self.camel(label.fetch("bind")))
      self.camel(label.fetch("bind"))
    elsif props.key?(self.camel(node["id"]))
      self.camel(node["id"])
    elsif props.key?(self.camel(node["id"].to_s.delete_suffix("_label")))
      # A template names the widget which shows a property after the property:
      # AdwWindowTitle's `title` is shown by the label whose id is `title_label`.
      self.camel(node["id"].to_s.delete_suffix("_label"))
    elsif props.key?(self.camel("#{node['id']}_label"))
      # And the other way about: AdwBanner's button is the widget with id `button` and
      # the property it shows is `button-label`, set from the widget's own source rather
      # than bound in the template. Without this the banner rendered its button label as
      # loose text beside the banner and the button itself not at all.
      self.camel("#{node['id']}_label")
    elsif node.fetch("class") == "Image" && props.key?("#{self.camel(node['id'].to_s.delete_suffix('_image'))}IconName")
      # A row names the icon it shows after where it sits rather than after the widget:
      # AdwButtonRow's `start_image` draws `start-icon-name`. Nothing bound the two, so the
      # icon was rendered with no name and drew nothing at all.
      "#{self.camel(node['id'].to_s.delete_suffix('_image'))}IconName"
    elsif node.fetch("class") == "Image" && props.key?("iconName")
      "iconName"
    elsif node.fetch("class") == "Label" && props.key?("label")
      # The same for text as the line above is for an icon. A label the stylesheet shows
      # -- `buttoncontent > box.horizontal > label` -- has no id and no binding in any
      # template, because there is no template; nothing bound it, so the component drew
      # the label node empty inside the box AND the text again at its root, where the
      # root's own layout stacked the two on top of each other. Every button carrying an
      # icon and a label at once had the one printed over the other.
      "label"
    end
  end

  # A composite's tree, as the parts which were generated for it.
  # The nodes whose length along the widget is the value the widget holds, and the prop which
  # gives it. A scale's slider is placed rather than stretched, which is why it is separate.
  PROPORTIONS = {
    "progress" => :fraction,
    "block" => :value,
    "highlight" => :value,
  }.freeze

  # `fraction` is already 0..1. `value` is somewhere between `minValue` and `maxValue`, which
  # is what a GtkAdjustment holds and what bin/08-final-components gives a range as props.
  def self.proportion(node, props)
    wanted = PROPORTIONS[node["node"]]
    return nil if wanted.nil?

    expression =
      if wanted == :fraction && props.key?("fraction")
        "(fraction ?? 0) * 100"
      elsif wanted == :value && props.key?("value")
        "(((value ?? 0) - (minValue ?? 0)) / ((maxValue ?? 1) - (minValue ?? 0) || 1)) * 100"
      end

    return nil if expression.nil?

    length = "`${Math.max(0, Math.min(100, #{expression}))}%`"

    # Along the widget, so one statement serves both orientations: a vertical progress bar
    # grows upwards and `inline-size` is its width, which is not what fills.
    # And the whole of the way across: a highlight is the trough's own thickness, which the
    # stylesheet never states because GTK's box model gives it one. Left to its content it was
    # nothing tall, so a scale drew its trough grey with no fill in it at all.
    if props.key?("orientation")
      "[orientation === \"vertical\" ? \"blockSize\" : \"inlineSize\"]: #{length}, " \
        "[orientation === \"vertical\" ? \"inlineSize\" : \"blockSize\"]: \"100%\""
    else
      "inlineSize: #{length}, blockSize: \"100%\""
    end
  end

  # A switch is as wide as its slider can travel: two slider widths and its own padding. GTK
  # measures that in gtkswitch.c -- the stylesheet states the 20px handle and the 3px padding
  # and never states the 46px track -- so a switch built from the stylesheet alone came out
  # square, a 26px circle beside every label it belongs to.
  def self.track(component)
    found = self.track_width(component["node"], component["classes"], component.dig("tree", "children"))

    found ? "#{found.inspect}, " : ""
  end

  # The same for a switch which is a PART of something else: a switch row builds one into its
  # suffixes, and a track measured only on the component's own root left that one square.
  def self.track_part(node)
    self.track_width(node["node"], node["classes"], node["children"])
  end

  def self.track_width(node, classes, children)
    return nil unless node == "switch"

    slider = (children || []).find{|one| one["node"] == "slider" }
    return nil if slider.nil?

    width = self.pixels(slider.dig("classes", "base") || [], /\Amin-w-([0-9.]+)\z/)
    padding = self.pixels((classes || {}).fetch("base", []), /\Ap-\[([0-9.]+)px\]\z/, scale: 1)
    return nil if width.nil?

    "min-w-[#{(width * 2 + (padding || 0) * 2).round}px]"
  end

  # A Tailwind length as pixels. The spacing scale is in quarters of a rem, so `min-w-5` is
  # 20px; a bracketed length is already in pixels.
  def self.pixels(classes, pattern, scale: 4)
    classes.filter_map{|one| one[pattern, 1]&.to_f }.first&.*(scale)
  end

  # Where a switch's slider sits: the start of the track, or the end of it once it is on.
  def self.thrown(node, props, group)
    return nil unless node["node"] == "slider" && group
    return nil unless props.key?("active") && !props.key?("value")

    "justify-self-start self-center group-data-[state=checked]/#{group}:justify-self-end"
  end

  # A range's slider is placed along the trough at the value, not stretched to it.
  def self.placement(node, props)
    return nil unless node["node"] == "slider"
    return nil unless props.key?("value")

    along = "(((value ?? 0) - (minValue ?? 0)) / ((maxValue ?? 1) - (minValue ?? 0) || 1)) * 100"
    along = "`${Math.max(0, Math.min(100, #{along}))}%`"

    if props.key?("orientation")
      "[orientation === \"vertical\" ? \"insetBlockStart\" : \"insetInlineStart\"]: #{along}"
    else
      "insetInlineStart: #{along}"
    end
  end

  # The trough a placed slider sits in is what the slider is placed AGAINST, so it is the box
  # the offset is measured from. Its thickness is the slider's own box with the slider's
  # negative margin taken off it, which is how GTK arrives at a 4px trough under a 20px handle:
  # the stylesheet states both numbers and neither states the trough.
  def self.trough_classes(node)
    return nil unless node["node"] == "trough"

    slider = node.fetch("children", []).find{|child| child["node"] == "slider" }
    return nil if slider.nil?

    "relative #{self.thickness(slider)}"
  end

  # `min-h-5` and `-m-2` is 20px of handle with 8px taken off each side: a 4px trough.
  def self.thickness(slider)
    classes = slider.dig("classes", "base") || []
    size = classes.filter_map{|one| one[/\Amin-h-([0-9.]+)\z/, 1]&.to_f }.first
    margin = classes.filter_map{|one| one[/\A-m-([0-9.]+)\z/, 1]&.to_f }.first

    return "min-h-1" if size.nil?

    [((size - (margin || 0) * 2) * 4).round, 1].max.then{|px| "min-h-[#{px}px]" }
  end

  # Whether this node is the element the control's own properties belong on.
  def self.control?(node, props = {}) = %w[input textarea].include?(self.element_for(node, props))

  # One attribute per attribute. Three of a widget's properties can be the same statement
  # to the browser -- a spin button has `value` and `text`, a progress bar has `fraction`
  # and `text`, and all three are `defaultValue` -- and emitting one term each wrote the
  # name twice in the same tag, which is a JSX error rather than a component that renders.
  # Whichever of them the caller gave, in the order the map states, is the one that shows.
  def self.control_attributes(props)
    CONTROL_PROPS.select{|prop, _attribute| props.key?(prop) }
      .group_by{|_prop, attribute| attribute }
      .map{|attribute, pairs| "#{attribute}={#{pairs.map(&:first).join(' ?? ')}}" }
  end

  # A template which stacks two nodes in the same place and fades between them says so with
  # `opacity="0"` on the one which starts hidden: adw-entry-row.ui stacks a large title for the
  # empty row over a small one for the filled row, and stacks the text itself under both.
  #
  # Which is showing is whether the row HAS text. The stylesheet cannot say that and the
  # template only states the resting state, so an entry row given a value drew the empty row's
  # title and nothing else -- the value was there, at opacity 0.
  def self.fade(node, props)
    return nil unless props.key?("text")
    return "opacity: text === undefined ? 1 : 0" if node["fade-out"]

    hidden = node.fetch("properties", {})["opacity"] == "0"

    hidden ? "opacity: text === undefined ? 0 : 1" : nil
  end

  # The other half of a cross-fade: the node stacked under the hidden one, bound to the same
  # property, which is the one showing until there is text. Without this an entry row with a
  # value drew both titles over each other.
  def self.pair_fades(children, props)
    hidden = children.select{|one| one.fetch("properties", {})["opacity"] == "0" }
    return if hidden.empty?

    hidden.each do |one|
      bound = self.bound(one, props)
      next if bound.nil?

      children.each do |other|
        next if other.equal?(one)
        next unless self.bound(other, props) == bound
        next if other.fetch("properties", {}).key?("opacity")

        other["fade-out"] = true
      end
    end
  end

  def self.tree(node, props, indent, slot = nil, control = [], group = nil)
    pad = " " * indent
    children = (node.fetch("slots", {}).values + node.fetch("children", []))
      .select{|child| self.rendered?(child, props)}
    # An `<input>` holds nothing: a text node's cursor and placeholder are things the
    # element draws itself, and rendering them into it is an error React refuses the
    # whole tree for rather than a part that comes out wrong.
    children = [] if VOID.include?(self.element_for(node, props))
    self.pair_fades(children, props)
    inner = children.map{|child| self.tree(child, props, indent + 2, slot, control, group)}.reject(&:empty?)
    inner << "#{pad}  {children}" if node.equal?(slot)
    taken = node["takes"] unless node["takes"] == "children"
    inner << "#{pad}  {#{taken}}" if taken
    text = self.bound(node, props)

    size = self.proportion(node, props)
    placed = self.placement(node, props)
    thrown = self.thrown(node, props, group)

    markup =
      if thrown
        # A switch's slider is thrown from one end of its track to the other by the state. The
        # stylesheet says how big the handle is and says nothing about where it sits, because
        # GTK slides it in gtkswitch.c; left in the overlay layout it filled the whole track.
        "<#{node.fetch('part')} className=#{thrown.inspect} />"
      elsif placed
        # A node which is POSITIONED at the value rather than sized by it: a range's slider
        # sits where the value is and keeps its own 20px. Left in the flow it was stretched
        # across the whole trough by the overlay layout, and a scale came out as one long
        # white pill with no trough and no fill behind it.
        "<#{node.fetch('part')} className=\"absolute top-1/2 -translate-x-1/2 -translate-y-1/2\" style={{ #{placed} }} />"
      elsif size
        # A node whose length IS the value: a progress bar's progress, a level bar's block, a
        # scale's highlight. GTK sizes these from the adjustment every time it draws; nothing
        # in a stylesheet can, so the proportion is written onto the element.
        "<#{node.fetch('part')} style={{ #{size} }} />"
      elsif text && node.fetch("class") == "Image"
        # An image node draws the name it is given. The part is an `Icon` of its own, so
        # the name goes through as a prop rather than as a class.
        "<#{node.fetch('part')} name={#{text}} />"
      elsif text && VOID.include?(self.element_for(node, props))
        # A text node renders as an `<input>`, which holds nothing: React refuses the whole
        # tree rather than the one element, so an entry row given its text rendered the page
        # blank. What an input shows is its value.
        "<#{node.fetch('part')} defaultValue={#{text}}#{self.fade(node, props).then{|one| one ? " style={{ #{one} }}" : '' }} />"
      elsif text
        self.fade(node, props).then do |one|
          if one
            "<#{node.fetch('part')} style={{ #{one} }}>{#{text}}</#{node.fetch('part')}>"
          else
            "<#{node.fetch('part')}>{#{text}}</#{node.fetch('part')}>"
          end
        end
      elsif inner.empty?
        "<#{node.fetch('part')}#{self.control?(node, props) && !control.empty? ? " #{control.join(' ')}" : ''} />"
      else
        ["<#{node.fetch('part')}>", *inner.map{|one| one.sub(/\A#{pad}/, "") }, "</#{node.fetch('part')}>"].join("\n#{pad}")
      end

    # A template node the template itself hides is not on screen until something gives it
    # something to show: adw-preferences-page.ui builds its description label with
    # `visible="False"`, and a page with no description rendered it anyway -- an empty
    # label, and the 24px of spacing on either side of it, above every group on the page.
    return "" if self.never?(node)
    return "#{pad}#{markup}" unless self.hidden?(node) || self.bound_visible(node, props)

    # A template node the template itself hides is on screen once something is put in it:
    # adw-action-row.ui builds its prefixes and its suffixes with `visible="False"`, and
    # an empty one still took the 6px of spacing on either side of it. What puts
    # something in it is what it takes -- the children, a property -- or the text it is
    # bound to; a node with none of those is never shown and is not rendered at all.
    # A hidden container which the template itself fills is not empty and is not hidden:
    # AdwSwitchRow's .ui puts a switch in the suffixes box AdwActionRow's .ui builds
    # hidden, and gating it on the caller's children took the switch off every switch row.
    return "#{pad}#{markup}" unless children.empty?

    # A hidden container the template itself fills is not empty and is not hidden:
    # adw-switch-row.ui puts a switch in the suffixes box adw-action-row.ui builds with
    # `visible="False"`, and gating that on the caller's children took the switch off
    # every switch row, the spin button off every spin row and the list off every combo.
    return "#{pad}#{markup}" unless children.empty?

    gate = self.bound_visible(node, props) ||
      node["takes"] || (self.holds?(node, slot) ? "children" : nil) || text

    gate ? "#{pad}{#{gate} ? (\n#{pad}  #{markup.gsub("\n", "\n  ")}\n#{pad}) : null}" : ""
  end

  def self.hidden?(node) = node.fetch("properties", {})["visible"] == "False"

  # A template child the widget's own source never shows at rest: AdwEntryRow's apply
  # button and its indicator are `gtk_widget_set_child_visible (..., FALSE)` until the row
  # is typed in, and rendering them anyway put a full-width suggested-action button over
  # the text of every entry row in the registry.
  def self.never?(node)
    found = node.fetch("properties", {})["visible"]

    found.is_a?(Hash) && found["when"].to_s.strip == "FALSE"
  end

  # What a template's `<binding name="visible">` is a condition on, as the prop to render
  # it under: the row's image appears when it is given an icon name, its subtitle when it
  # is given a subtitle. A label binds its own `label`, which is itself bound to the
  # component's property, so that one resolves to the text the node shows.
  def self.bound_visible(node, props)
    found = node.fetch("properties", {})["visible"]

    return nil unless found.is_a?(Hash)

    if found["bind"]
      prop = self.camel(found.fetch("bind"))

      return props.key?(prop) ? prop : self.bound(node, props)
    end

    # The condition the widget's C shows the child under, as the props it names. What is
    # left -- internal state nobody outside the widget can see -- is a child GTK shows at
    # rest, so a condition which names no property at all is not a condition here.
    named = found.fetch("when", "").scan(/[a-z_][a-z0-9_]*/).map{|one| self.camel(one) }
      .uniq.select{|one| props.key?(one) }

    named.empty? ? nil : named.join(" || ")
  end

  # Whether this node is where the children go, or holds the node that is.
  def self.holds?(node, slot)
    return false if slot.nil?
    return true if node.equal?(slot)

    (node.fetch("slots", {}).values + node.fetch("children", []))
      .any?{|child| self.holds?(child, slot) }
  end

  def self.register(root, components)
    path = File.join(root, "registry.json")
    registry = JSON.parse(File.read(path))
    generated = components.keys.map{|name| self.kebab(name)}.to_set

    # The items this script does not own, kept in the order they were in.
    items = registry.fetch("items").reject do |item|
      item.fetch("type") == "registry:ui" ||
        generated.include?(item.fetch("name")) ||
        item.fetch("name") == "widget-props"
    end

    # Gtk.Widget's properties and the function which resolves them, which this script
    # generates and every component it generates imports.
    items << {
      "name" => "widget-props",
      "type" => "registry:lib",
      "title" => "Widget props",
      "description" => "Gtk.Widget's writable properties, which every component accepts, " \
        "and the function which resolves them to the className, style and attributes " \
        "the DOM carries.",
      "files" => [
        { "path" => "registry/adwaita/lib/widget-props.ts", "type" => "registry:lib" },
        { "path" => "registry/adwaita/lib/widget.ts", "type" => "registry:lib" },
      ],
    }

    # The resolver which turns a GTK icon name into the component that draws it. A registry
    # item of its own, because only the components which draw an icon pull it in -- and it
    # is the one file which names adwaita_react, so a project installing a component that
    # has no icon in it installs neither.
    items << {
      "name" => "icon",
      "type" => "registry:lib",
      "title" => "Icon",
      "description" => "The icon a GTK `icon-name` names, as the component which draws it, " \
        "from the Adwaita symbolic set.",
      "dependencies" => [ICONS_PACKAGE],
      "files" => [{ "path" => "registry/adwaita/lib/icon.tsx", "type" => "registry:lib" }],
    }

    components.sort.each do |name, component|
      slug = self.kebab(name)
      drawn = self.draws_icon?(component, component["tree"] ? self.parts(name, component) : [])

      items << {
        "name" => slug,
        "type" => "registry:ui",
        "title" => name,
        "description" => "#{name}#{component['gtk'] ? " (#{component['gtk']})" : ''}.",
        "registryDependencies" => ["adwaita-theme", "gtk-enums", "widget-props"] + (drawn ? ["icon"] : []),
        "dependencies" => ["class-variance-authority", "@base-ui/react"],
        "files" => [{ "path" => "registry/adwaita/ui/#{slug}.tsx", "type" => "registry:ui" }],
      }
    end

    registry["items"] = items
    File.write(path, "#{JSON.pretty_generate(registry)}\n")
  end
end

GenerateComponents.run(ARGV)
