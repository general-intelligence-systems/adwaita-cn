#!/usr/bin/env ruby
# frozen_string_literal: true

# 11-GENERATE-COMPONENTS(1)       General Commands Manual      11-GENERATE-COMPONENTS(1)
#
# NAME
#      bin/11-generate-components — a file per component, with its props and its classes
#
# SYNOPSIS
#      bin/11-generate-components [--force]
#
# DESCRIPTION
#      Writes one .tsx under registry/adwaita/ui/ for every buildable component in
#      bin/08-final-components.out/final-components.json, and registers each one in registry.json.
#
#      The shape is shadcn/ui's, on the Base UI base: a real element rather than a div,
#      `data-slot`, the element replaceable through Base UI's `render`, props merged onto
#      it with mergeProps, the classes in a cva when the component has style classes and
#      in a cn() when it does not, and a composite's parts as sibling functions in the
#      same file.
#
#      The classes are Adwaita's, including the states -- hover, active, disabled,
#      focus-visible, checked, selected -- which become Tailwind's state prefixes. A
#      component's style classes become cva variants: the ones which only change geometry
#      are sizes, and the rest are variants.
#
#      Read-only properties are left out: a prop which cannot be written is not a prop.
#
# OPTIONS
#      --force   Overwrite files which already exist.
#
# FILES
#      bin/08-final-components.out/final-components.json  which components exist, and what each accepts
#      registry/adwaita/ui/         the output
#      registry/adwaita/lib/        widget-props.ts, and widget.ts beside it
#      registry.json                one item per component
#
# EXIT STATUS
#      The bin/11-generate-components utility exits 0 on success, and >0 if an error occurs.
#
# SEE ALSO
#      bin/10-lint-rules, bin/12-component-variants
#
# adwaita-cn                       October 12, 2026             11-GENERATE-COMPONENTS(1)

require "json"
require "set"
require "fileutils"

require_relative "lib/classes"
require_relative "lib/enum_names"
require_relative "lib/registry_classes"

module GenerateComponents
  TYPES = {
    "string" => "string",
    "boolean" => "boolean",
    "number" => "number",
    "node" => "ReactNode",
    # A value the caller passes which the DOM has no place for: a GListModel, a
    # GtkAdjustment, a GtkExpression, a GVariant, a GdkRGBA. It is accepted and it is not
    # rendered. Before bin/07-gtk-schemas told these apart from a widget they were all
    # "node", and every one of them was written into the DOM as a child.
    "object" => "unknown",
    "void" => "void",
  }.freeze

  # The element a CSS node is, where the DOM has one that means the same thing. Anything
  # not named here is a div, which is what a GTK container is.
  ELEMENTS = {
    "appchooserbutton" => "button", "button" => "button", "checkbutton" => "button",
    "colorbutton" => "button", "fontbutton" => "button", "menubutton" => "button",
    "splitbutton" => "button", "switch" => "button", "tabbutton" => "button",
    "editablelabel" => "input", "entry" => "input",
    "spinbutton" => "input", "text" => "input",
    "textview" => "textarea",
    "buttoncontent" => "span", "image" => "span", "label" => "span",
    "windowtitle" => "span",
    "shortcut-label" => "kbd",
    "picture" => "img", "video" => "video",
    "separator" => "hr",
    "flowbox" => "ul", "gridview" => "ul", "iconview" => "ul", "list" => "ul",
    "listview" => "ul",
    "flowboxchild" => "li",
    "headerbar" => "header", "statusbar" => "footer",
  }.freeze

  # The GTK class a template node is, as an element, for the parts generated beside a
  # composite.
  # The element a template node renders as, by the widget class it is.
  #
  # A node read out of a selector rather than out of a template carries `css-node`, and
  # the name it was given is the CSS node capitalised -- which for some of them is a real
  # widget's name. `progressbar > text` became a node of class `Text`, this map renders a
  # Gtk.Text as an `<input>`, and a progress bar was drawn with a text field in it 13px
  # tall above its trough.
  #
  # What tells the two apart is whether the widget which owns the node is editable: a
  # GtkEntry really does build a GtkText and a GtkProgressBar really does not, and
  # `editable` is the property every GtkEditable carries and nothing else does. Only the
  # form controls are gated on it -- a `label`, an `image`, a `button` and a `separator`
  # node are that element whoever paints them.
  class << self
    # The nodes whose layout the node name cannot speak for, so the component names the
    # manager: `cn("box", "center")`.
    attr_accessor :conflicted
    attr_accessor :leaves
  end

  def self.element_for(node, props = {})
    found = PARTS.fetch(node.fetch("class"), "div")

    return "div" if node["css-node"] && VOID.include?(found) && !props.key?("editable")
    return "div" if node["css-node"] && found == "textarea" && !props.key?("editable")

    found
  end

  # The package the icons come from. Named once: it is in the generated lib file's import
  # and in the registry item which installs it, and those two have to agree.
  ICONS_PACKAGE = "adwaita_react"

  PARTS = {
    "Button" => "button", "ToggleButton" => "button", "CheckButton" => "button",
    "MenuButton" => "button", "Label" => "span", "Image" => "span",
    "Picture" => "img", "Separator" => "hr", "Entry" => "input", "Text" => "input",
    "TextView" => "textarea", "ListBox" => "ul", "ListBoxRow" => "li",
    "ProgressBar" => "div", "Spinner" => "span",
  }.freeze

  # The classes a template uses to hold other widgets. A composite's children go
  # into one of these rather than beside the template, which is where GTK puts
  # them: a PreferencesGroup's rows belong in its listbox, and an ActionRow's
  # suffixes in its suffixes box.
  CONTAINERS = %w[
    Bin Box Clamp ClampScrollable FlowBox Gizmo Grid ListBox Overlay Revealer
    ScrolledWindow Stack ToolbarView WrapBox
  ].to_set

  # The CSS nodes a widget draws its own content inside, for a tree which has no slot of its
  # own because it was read out of the stylesheet rather than out of a .ui file.
  CONTENT_SLOTS = %w[button box contents child].to_set

  # A template holds more than widgets: a gesture, an event controller, an adjustment or a
  # list model is a child object rather than markup, so it is not a part.
  NOT_WIDGETS = %w[
    Adjustment Breakpoint EnumListModel ListStore SignalListItemFactory StackPage
    StringList TextBuffer TreeListModel
  ].to_set

  NOT_WIDGET_PREFIXES = %w[Gesture EventController Drop Shortcut].freeze

  # Nodes the toolkit paints in order to NOT show them.
  #
  # `indicatorbin > mask` is filled black and then used as the alpha mask the indicator
  # is composited through, which is a GSK operation and not a thing a stylesheet does.
  # Rendered as an element it is what it says it is -- a black dot -- and there were
  # three of them across the mail application's header bar where the toolkit draws none.
  NOT_DRAWN = %w[mask].to_set

  # The classes a widget puts on itself from what it is holding. bin/08 marks them
  # `applied`, because the toolkit's source applies them rather than any application:
  # gtkbutton.c adds `.text-button` to every button whose child is a label. A component
  # which waited to be told would be the one shape no real button ever has -- every
  # button in a running application wears one of these -- so they are applied here from
  # the same thing the toolkit uses: whether it was given text, an icon, or both.
  # Each one as what it needs and what it rules out. The terms are dropped where the
  # component has no such prop: Gtk.CheckButton takes a label and no icon, so it is a
  # `.text-button` whenever it has a label and there is nothing to rule out.
  CONTENT = {
    "text-button" => { needs: :text, without: :icon },
    "image-button" => { needs: :icon, without: :text },
    "image-text-button" => { needs: %i[text icon], without: nil },
  }.freeze

  # Classes a property decides rather than the content: GTK gives an orientable widget
  # `.horizontal` unless it is vertical, which is the branch gtkwidget.c takes and the
  # default the property carries.
  BY_PROPERTY = {
    "horizontal" => { prop: "orientation", when: 'orientation !== "vertical"' },
    "vertical" => { prop: "orientation", when: 'orientation === "vertical"' },
  }.freeze

  # A layout manager, as the CSS which arranges children the same way.
  #
  # The stylesheet says nothing about this -- a GtkBox is a row because its layout
  # manager is a GtkBoxLayout, not because of any rule -- so without it every child of
  # every component falls into the document's default flow and a title and its
  # description come out on one line.
  # A grid aligns its children with `justify-self` and `align-self`, and a widget which lays
  # its child out in one -- a bin, an overlay, a clamp -- still has to honour the alignment
  # the child asked for. Without this an AdwButtonRow's contents, which the template sets to
  # `halign=center`, sat against the left edge of every row.
  GRID_ALIGNMENT = [
    # A grid track is as tall as its tallest child unless the child may shrink, and GTK's
    # children all may: an overlay in a window is the window's height and what it holds
    # scrolls inside it.
    "[&>*]:min-h-0",
    "[&>[data-halign=start]]:justify-self-start",
    "[&>[data-halign=center]]:justify-self-center",
    "[&>[data-halign=end]]:justify-self-end",
    "[&>[data-valign=start]]:self-start",
    "[&>[data-valign=center]]:self-center",
    "[&>[data-valign=end]]:self-end",
  ].join(" ").freeze

  LAYOUTS = {
    # Children in a line. Which way is the orientation property, handled below.
    "box" => "flex",
    # The child is given the whole allocation, and several children overlap.
    "bin" => "grid [&>*]:col-start-1 [&>*]:row-start-1 #{GRID_ALIGNMENT}",
    "overlay" => "grid [&>*]:col-start-1 [&>*]:row-start-1 #{GRID_ALIGNMENT}",
    # GtkCenterBox: the start widget at the start, the end widget at the end, and the
    # centre centred in the whole width rather than in what is left between them. Two
    # `1fr` tracks either side of an `auto` one is that statement -- `justify-between`
    # was not, because it centres the middle child between its siblings and a header
    # bar's title then moved whenever a button was added to one side.
    "center" => "grid [grid-template-columns:1fr_auto_1fr] items-center [&>*:first-child]:justify-self-start [&>*:last-child]:justify-self-end",
    # A clamp fills what it is given and limits the child, on a curve that no stylesheet
    # can state: between the tightening threshold and the maximum, AdwClampLayout eases
    # the child's width rather than stepping it. lib/clamp.ts does the arithmetic, and
    # the element itself is the column it centres.
    "clamp" => "grid",
    "grid" => "grid #{GRID_ALIGNMENT}",
    "fixed" => "relative [&>*]:absolute",
    "wrap" => "flex flex-wrap",
    # The sidebar's track and the content's, from lib/split-view.ts.
    "split" => "grid [&>*]:min-w-0",
    # The widget takes the whole of what it is given, and scrolls what will not fit. `min-h-0`
    # is what lets it: a flex item will not shrink below its content without it, so a scroller
    # in a page pushed the page open instead of scrolling.
    "fill" => "flex flex-col grow min-h-0",
    # The same, and what will not fit is scrolled rather than pushing the page open.
    #
    # A child which aligns itself is NOT stretched: `[&>*]:grow` is what a scrolled
    # window does with a child which fills it, and AdwStatusPage's box asks for
    # `valign=center` instead. Grown, it was as tall as the viewport and its contents sat
    # at the top of it -- the icon, the title and the button of every status page in the
    # registry were 115px above where the toolkit puts them.
    # A child which aligns itself is not stretched, and where it sits is stated ON THE
    # CONTAINER and never as a margin on the child. `my-auto` centres a child too, and it
    # is a margin: it replaced AdwStatusPage's own `my-9` and took 72px off the top and
    # bottom of every status page in the registry, pulling everything under it up the page.
    "scroll" =>
      "flex flex-col grow min-h-0 overflow-auto " \
      "[&>*:not([data-valign])]:grow [&>*:not([data-valign])]:min-h-0 " \
      "has-[>[data-valign=center]]:justify-center " \
      "has-[>[data-valign=end]]:justify-end has-[>[data-valign=start]]:justify-start",
    # Items across, wrapped, packed to the top of whatever height the view is given.
    "fill-grid" =>
      "grid [grid-template-columns:repeat(auto-fill,minmax(96px,1fr))] content-start grow min-h-0",
  }.freeze

  # The widgets which lay their children out in C rather than by naming a
  # GtkLayoutManager class.
  #
  # bin/05 reads the manager a class sets, and these set none: they measure and allocate
  # in their own source, so there is nothing in the toolkit's C for it to read and the
  # components came out with no arrangement at all -- a list box whose rows were inline,
  # an entry whose text and icons stacked, a switch with its slider beside it. What each
  # one does is written down here instead, as the layout it amounts to.
  #
  # `box-vertical` and `box-horizontal` are a box which is not a GtkBox: the widget runs
  # its children one way and nothing about it is a property a caller can turn.
  HAND_LAID = {
    # A row is its template's box, and the row itself gives that box everything.
    "ActionRow" => "bin", "ComboRow" => "bin", "EntryRow" => "bin",
    "ExpanderRow" => "bin", "SpinRow" => "bin", "SwitchRow" => "bin",
    "ButtonRow" => "bin", "PreferencesRow" => "bin", "ListBoxRow" => "bin",
    # The toast sits over the child rather than beside it.
    "ToastOverlay" => "overlay",
    # The sidebar and the content, side by side.
    "NavigationSplitView" => "split", "OverlaySplitView" => "split",
    # Two panes, the first of them `position` long.
    "Paned" => "split",
    # Rows, one under the next.
    "ListBox" => "box-vertical",
    # The text, with whatever icons the entry carries either side of it.
    "Entry" => "box-horizontal", "SearchEntry" => "box-horizontal",
    "PasswordEntry" => "box-horizontal",
    # A trough filling the widget, with the slider inside it.
    "Scale" => "bin", "Switch" => "bin",
    # The trough, under the text the bar can show.
    "ProgressBar" => "box-vertical",
    # The check, then the label.
    "CheckButton" => "box-horizontal",
    # The page's bars, with the content between them.
    "ToolbarView" => "box-vertical",
    # A stack shows ONE of its children, and that child is given the whole stack. Left with
    # no arrangement at all its child fell into the document's flow and was as tall as its own
    # content: the file grid in bin/apps/files came out 15px tall in a 574px pane.
    "Stack" => "bin", "ViewStack" => "bin", "Squeezer" => "bin", "Leaflet" => "bin",
    "MultiLayoutView" => "bin", "Carousel" => "bin",
    # A scroller, its viewport and the list inside it each fill what they are given: GTK
    # measures them against the window, and a `div` measures itself against its content.
    "ScrolledWindow" => "scroll", "Viewport" => "fill", "ListView" => "fill",
    "ColumnView" => "fill", "TabOverview" => "scroll", "TreeView" => "fill",
    "ListBase" => "fill",
    # A grid view runs its items across and wraps them, and fills what it is given.
    "GridView" => "fill-grid", "IconView" => "fill-grid",
    # A flow box runs its children across and wraps them. It sets no layout manager and
    # measures in its own C, so nothing in the sources says so and the eight photos in
    # bin/apps/photos came out in one column down the left of a 820px window.
    "FlowBox" => "wrap",
  }.freeze

  # The two lengths a wrapping container is spaced by: between its lines, and between
  # the children along one.
  GAPS = {
    "WrapBox" => %w[lineSpacing childSpacing],
    "FlowBox" => %w[rowSpacing columnSpacing],
  }.freeze

  # The prop a hand-laid widget gives whatever space is left once the rest is placed:
  # AdwToolbarView puts its top bars at the top and its bottom bars at the bottom, and
  # the content takes the remainder. Without it a toolbar view was as tall as its header
  # bar and every application stopped 594px short of its own window.
  FILLS = {
    "ToolbarView" => "content",
  }.freeze

  # What a container does with a child that asked for more than its natural size, and
  # with a child that asked to sit somewhere particular in what it was given.
  #
  # The container rather than the child, because only the container knows which way it
  # runs: `align-self` is the cross axis, so `valign` is `align-self` in a row and
  # `halign` is `align-self` in a column, and `hexpand` is `flex-grow` in a row where
  # `vexpand` is `flex-grow` in a column. lib/widget.ts writes the four as attributes
  # and these turn them into the rules which mean them here.
  #
  # EXPANSION PROPAGATES UP. gtk_widget_compute_expand asks a widget whether it or ANY
  # descendant expands, so AdwMessageDialog's body carrying `vexpand="True"` is what gives
  # the message area around it the window's height, and the response area the 80px left at
  # the foot. Matched on the child alone, nothing between the dialog and the label grew:
  # the heading, the body and the buttons were a stack of natural heights in the top left
  # corner of a 920x620 window, and the same in every dialog, window and popover.
  # GTK ALIGNS ON BOTH AXES AND FLEX DOES NOT.
  #
  # `halign` is horizontal whichever way the box runs, and `valign` is vertical. In flex only
  # the cross axis takes `align-self`; the main axis is auto margins. A row handled `valign`
  # with `self-*` and said nothing about `halign`, so `halign="end"` on a banner's close
  # button, on a row's switch, on a header's buttons did nothing at all and each of them sat
  # wherever the text before it finished.
  ALIGNMENT = {
    "row" => [
      "[&>[data-hexpand]]:grow",
      "[&>*:has([data-hexpand])]:grow",
      # The cross axis, which is down.
      "[&>[data-valign=start]]:self-start",
      "[&>[data-valign=center]]:self-center",
      "[&>[data-valign=end]]:self-end",
      "[&>[data-valign=baseline]]:self-baseline",
      # The main axis, which is across, and so is margin.
      "[&>[data-halign=start]]:mr-auto",
      "[&>[data-halign=center]]:mx-auto",
      "[&>[data-halign=end]]:ml-auto",
    ].join(" "),
    "col" => [
      "[&>[data-vexpand]]:grow",
      "[&>*:has([data-vexpand])]:grow",
      # The cross axis, which is across.
      "[&>[data-halign=start]]:self-start",
      "[&>[data-halign=center]]:self-center",
      "[&>[data-halign=end]]:self-end",
      # A FLEX CHILD WILL NOT SHRINK BELOW ITS CONTENT unless it is told it may, and GTK's
      # children all may: a window gives its child the window's height and the child scrolls
      # what will not fit. Without this the toolbar view came out 709px tall in a 620px
      # window and everything anchored to the bottom -- a toast, an action bar -- fell off it.
      "[&>*]:min-h-0",
      # The main axis, which is down.
      "[&>[data-valign=start]]:mb-auto",
      "[&>[data-valign=center]]:my-auto",
      "[&>[data-valign=end]]:mt-auto",
    ].join(" "),
  }.freeze

  # An element which cannot have children, so the text and the children are not rendered
  # into it.
  VOID = %w[input hr img].to_set

  # What the element does not say on its own.
  # A GtkScale is not an `<input type=range>`: it is a trough with a highlight and a handle in
  # it, and each of those is a node the stylesheet measures. Rendering it as an input made it a
  # void element, which holds nothing, so the generator dropped the whole tree -- a scale came
  # out as an empty rounded box with no trough, no fill and no handle. The element is a div and
  # the role says what it is.
  ROLES = {
    "range" => "slider", "scale" => "slider",
    "actionbar" => "toolbar", "banner" => "status", "bottom-sheet" => "dialog",
    "calendar" => "grid", "columnview" => "grid", "dialog" => "dialog",
    "infobar" => "alert", "inline-view-switcher" => "tablist", "levelbar" => "meter",
    "menubar" => "menubar", "notebook" => "tablist", "popover" => "dialog",
    "progressbar" => "progressbar", "spinner" => "status", "stackswitcher" => "tablist",
    "statuspage" => "status", "switch" => "switch", "tabbar" => "tablist",
    "toggle-group" => "group", "toolbarview" => "toolbar", "treeview" => "treegrid",
    "viewswitcher" => "tablist", "window" => "dialog",
  }.freeze

  # A property the DOM has an attribute for under another name.
  PLAIN = {
    "placeholderText" => "placeholder",
    "editable" => "contentEditable",
  }.freeze

  # The properties which are the control's own, and so belong on the element which IS the
  # control.
  #
  # A widget which builds a text node inside itself renders as the container and the text
  # node is the `<input>`: `placeholder` on the container is nothing at all, which is why
  # no entry in the registry showed its placeholder, no spin row its value and no search
  # entry its text. These go to the part instead, wherever it is in the tree.
  CONTROL_PROPS = {
    "placeholderText" => "placeholder",
    "text" => "defaultValue",
    "value" => "defaultValue",
    "fraction" => "defaultValue",
  }.freeze

  # `data-[state=checked]` is what Adwaita's checked rules select on, and GTK calls that
  # property `active`; `selected` is the same statement about a row. Both only when the
  # property is a boolean: Gtk.ComboBox's `active` is the index of a row.
  STATES = {
    "active" => ['"data-state": active ? "checked" : "unchecked"', '"aria-checked": active'],
    "selected" => ['"data-selected": selected ? "" : undefined', '"aria-selected": selected'],
  }.freeze

  TYPE_ATTRS = {
    "editablelabel" => "text", "entry" => "text", "range" => "range",
    "scale" => "range", "spinbutton" => "number", "text" => "text",
  }.freeze

  # A property the toolkit sizes a widget with. The browser has the same statement as a
  # style, and writing it as a data attribute instead left it inert: an AdwClamp with
  # `maximum-size` of 400 is 400px wide in GTK and was the full width of whatever held
  # it here, and an AdwAvatar with a `size` of 32 has a box in GTK and measured nothing
  # at all here, so every application overflowed its window and the list of people had
  # no faces in it.
  #
  # The value is in pixels, which is what these properties are in: Adw.Avatar's `size`
  # and Adw.Clamp's `maximum-size` are both documented as pixels.
  GEOMETRY = {
    # NOT `width` and `height`. Adw.Avatar's `size` is the size it asks for, and a widget
    # which asked for 32px still fills the 50px row it was put in: the toolkit gives the
    # avatar in a list row a 32x50 box. Pinning both made it 32x32 and left it floating
    # in the middle of the row.
    "Avatar" => { "size" => %w[minWidth minHeight] },
  }.freeze

  # A clamp does not take its maximum size itself: it fills what it is given and limits
  # the child inside it, which keeps its own width when that is under the maximum and is
  # centred in the rest. Putting the maximum on the clamp made the clamp 400px wide in a
  # 512px space, and stretching the child made the column 400 wide where the toolkit
  # lays it out at 349, which moved everything in the window left by 75px.
  CLAMPED = %w[Clamp ClampScrollable ClampLayout].freeze

  # The child stretches to the column, and the column is the width lib/clamp.ts works
  # out. A `max-width` cannot be the statement here: between the tightening threshold
  # and the maximum the layout manager eases the width rather than capping it, and a
  # cap gave a 480px clamp a 480px child where the toolkit gives it 443.
  CLAMP_CLASSES = "[&>*]:min-w-0 [&>*]:col-start-2"

  # The split views, which size their sidebar the same way: a fraction of the whole,
  # clamped between a minimum and a maximum, neither of which a grid can state.
  SPLIT = %w[NavigationSplitView OverlaySplitView].freeze

  # The components whose two panes are sized by a `position` rather than by a fraction.
  PANED = %w[Paned].freeze

  # A TEMPLATE WHICH NAMES ANOTHER TEMPLATED WIDGET BUILDS THAT WIDGET'S OWN TREE TOO.
  #
  # adw-expander-row.ui names an AdwActionRow and binds the row's title onto it, and
  # adw-action-row.ui is the template which builds the label that title is drawn in. Stopping
  # at the named widget left the nested template out: an expander row rendered an empty pill,
  # and the sixteen other trees which name an action row were missing the same labels.
  #
  # The nested tree's own children go first and whatever the outer template put in the node
  # goes into the nested template's slot, which is where the widget itself would have put it.
  def self.expand!(node, components, seen = [])
    klass = node["class"]
    inner = components.dig(klass.to_s, "tree")

    unless inner.nil? || seen.include?(klass) || (inner["children"].to_a.empty? && inner["slots"].to_a.empty?)
      copy = Marshal.load(Marshal.dump(inner))
      held = (node["children"] || []) + (node.fetch("slots", {}).values)
      slot = self.slot(copy, derived: components.dig(klass, "template").nil?)

      # WHERE THE NESTED WIDGET'S OWN PROPERTIES WENT IS NOT THE OUTER WIDGET'S BUSINESS.
      # AdwShortcutsDialog names an AdwHeaderBar, whose template puts its `title-widget`
      # somewhere; spliced in unchanged the dialog rendered `{titleWidget}` -- a prop it does
      # not have and TypeScript will not compile.
      self.each_node(copy) do |one|
        one.delete("takes") unless one.equal?(slot)
      end

      # WHERE THE OUTER TEMPLATE PUT ITS CHILDREN IS NOW INSIDE THE NESTED ONE. The node which
      # took them is gone into the widget it named, so the marker moves to the node that
      # widget puts its own children in -- otherwise a preferences dialog had nowhere to
      # render the pages it was given and drew nothing at all.
      slot["takes"] = node["takes"] if slot && node["takes"]

      if slot && !held.empty?
        slot["children"] = (slot["children"] || []) + held
        node["children"] = copy["children"] || []
        node["slots"] = copy["slots"] || {}
      else
        node["children"] = (copy["children"] || []) + (node["children"] || [])
        node["slots"] = copy.fetch("slots", {}).merge(node.fetch("slots", {}))
      end

      node["properties"] = copy.fetch("properties", {}).merge(node.fetch("properties", {}))
    end

    deeper = seen + [klass]

    (node["children"] || []).each{|one| self.expand!(one, components, deeper) }
    node.fetch("slots", {}).each_value{|one| self.expand!(one, components, deeper) }
  end

  def self.run(argv)
    root = File.expand_path("..", __dir__)
    force = !argv.delete("--force").nil?
    final = JSON.parse(File.read(File.join(root, "bin/08-final-components.out/final-components.json")))
    flags = final.fetch("enums").select{|_name, enum| enum.fetch("flags")}.keys.to_set
    self.enum_names = EnumNames.map(final.fetch("enums"))
    components = final.fetch("components").slice(*final.fetch("buildable"))
    self.components_by_name = final.fetch("components")

    self.write(root, "icons.css", self.icons_css(root, self.named_icons(final)), true)
    self.write(root, "variables.css", self.variables_css(final.fetch("variables", {})), true)

    shared = final.fetch("widget")
    self.write(root, "lib/widget-props.ts", self.widget_props(shared, flags), force)
    self.write(root, "lib/stack.ts", STACK_TS, true)
    self.write(root, "lib/view-pages.ts", VIEW_PAGES_TS, true)
    self.write(root, "lib/style-classes.ts", self.style_classes_ts(final.fetch("styleClasses", [])), true)
    self.write(root, "lib/utils.ts", UTILS_TS, true)
    self.leaves = self.leaf_nodes(components)
    self.conflicted = RegistryClasses.conflicted(self.structure(components))
    self.write(root, "lib/adwaita-classes.ts", self.classes_ts(self.table_for(final, components)), true)

    written = []
    skipped = []

    components.sort.each do |name, component|
      file = "ui/#{self.kebab(name)}.tsx"
      source = self.component(name, component, flags)

      if self.write(root, file, source, force)
        written << name
      else
        skipped << name
      end
    end

    self.prune(root, components)
    self.register(root, components)

    puts("written: #{written.size}")
    puts("left alone: #{skipped.size}#{skipped.empty? ? '' : " (#{skipped.join(', ')})"}")
  end

  # The components which are no longer components. A widget whose only structure came from the
  # stylesheet's own over-matching -- AdwLinkRow with thirteen children it does not have,
  # AdwViewSwitcherButton with a colour swatch in it -- is not buildable once the match is
  # honest, and the file it had written stays behind and is imported by applications and by
  # the lint as though it still were.
  def self.prune(root, components)
    directory = File.join(root, "registry/adwaita/ui")
    return unless Dir.exist?(directory)

    wanted = components.keys.map{|name| "#{self.kebab(name)}.tsx" }.to_set
    gone = Dir.children(directory).select{|one| one.end_with?(".tsx") && !wanted.include?(one) }

    gone.sort.each do |one|
      File.delete(File.join(directory, one))
      warn("removed registry/adwaita/ui/#{one}: no longer a component")
    end
  end

  # True when the file was written, false when it was already there.
  def self.write(root, relative, source, force)
    path = File.join(root, "registry/adwaita", relative)

    if File.exist?(path) && !force
      false
    else
      FileUtils.mkdir_p(File.dirname(path))
      File.write(path, source)
      true
    end
  end

  # Adwaita's own variables, as the stylesheet which declares them.
  #
  # Hand-copying them was the mistake: the registry's adwaita.css declared 41 of the 144
  # the sheet defines, and every rule naming one of the rest resolved to nothing -- a
  # banner with no background, a card with no shade, a row with no separator, a sidebar
  # with no colour. They are read out of the same sheet the measurements come from, so
  # they cannot fall behind it.
  #
  # adwaita.css imports this and then states its own, which is what makes that file the
  # place to point the components at a brand's palette.
  def self.variables_css(variables)
    light = variables.fetch("light", {}).sort
    dark = variables.fetch("dark", {}).sort

    <<~CSS
      /* Generated by bin/11-generate-components. Do not edit.
       *
       * Every variable libadwaita's stylesheet defines, which is what its own rules are
       * written against. Override them in adwaita.css, which is loaded after this.
       */
      :root {
      #{light.map{|name, value| "  #{name}: #{value};" }.join("\n")}
      }

      @media (prefers-color-scheme: dark) {
        :root:not([data-theme="light"]) {
      #{dark.map{|name, value| "    #{name}: #{value};" }.join("\n")}
        }
      }

      :root[data-theme="dark"] {
      #{dark.map{|name, value| "  #{name}: #{value};" }.join("\n")}
      }
    CSS
  end

  # The icon set, as the stylesheet which draws it.
  #
  # `icon-name` was being written out as a class name and nothing defined those classes,
  # so every named icon in the registry drew nothing: an empty circle where the toolkit
  # has a back arrow, a close button, a menu, an expander, a checkmark. GTK draws a named
  # icon out of the Adwaita theme, which bin/01 now vendors.
  #
  # As a mask and not as an image, because that is what symbolic means: GTK recolours a
  # symbolic icon to the widget's own colour, so a button's icon is white on a suggested
  # action and grey when it is disabled. `background-color: currentColor` through a mask
  # is the same statement, and an `<img>` would have been a fixed black.
  # The icons the STYLESHEET names, as the masks it draws them with.
  #
  # Not every icon -- only the ones Adwaita's own `-gtk-icon-source` rules reach for: a
  # combo box's arrow, a check button's tick, the dash of an indeterminate one. Those are
  # chosen by a selector and not by a caller, so they stay a CSS mask; an icon a caller
  # NAMES goes through `@/lib/icon` and the adwaita_react package instead. Shipping the
  # whole set here as well was 800KB of data URIs for the dozen the sheet actually uses,
  # and a second copy of artwork the package already has.
  #
  # The source is icons/, which bin/16-icons normalises, rather than the raw
  # vendored files: one tree of artwork behind both ways of drawing it.
  def self.icons_css(root, named)
    directory = File.join(root, "icons")

    declared = named.sort.filter_map do |name|
      path = File.join(directory, "#{self.icon_file(name)}.svg")

      next warn("icons.css: #{name} is named by the stylesheet and is not in icons/") unless File.exist?(path)

      "    --icon-#{self.css_name(name)}: url(#{self.data_uri(File.read(path)).inspect});"
    end

    <<~CSS
      /* Generated by bin/11-generate-components. Do not edit.
       *
       * The icons Adwaita's own rules draw, as the masks they are. An icon a caller names
       * goes through `@/lib/icon` instead, which draws it from the adwaita_react package.
       */
      :root {
      #{declared.join("\n")}
      }

      /* An icon the node paints OVER ITS OWN BACKGROUND, which is what the stylesheet's
       * `-gtk-icon-source` is.
       *
       * A node cannot be its own background and its own mask at once: masking the
       * element takes the background with it, so a checked check button -- which is an
       * accent-coloured box with a white tick on it -- came out as a blue tick on
       * nothing, and so did every radio, every dash and every arrow drawn on a button.
       * The mark goes on a pseudo-element, where it covers the background instead of
       * replacing it.
       */
      @utility adw-icon-source {
        position: relative;

        &::after {
          content: "";
          position: absolute;
          inset: 0;
          background-color: currentColor;
          /* Masked out entirely when no icon has been named. `var(--adw-icon)` alone is
           * an invalid value when the variable is unset, which drops the mask and leaves
           * the pseudo-element painting a solid block of the text colour -- a black
           * square where a combo row's arrow belongs. */
          mask-image: var(--adw-icon, linear-gradient(transparent, transparent));
          mask-repeat: no-repeat;
          mask-position: center;
          mask-size: var(--adw-icon-size, 16px) var(--adw-icon-size, 16px);
        }
      }
    CSS
  end

  # The file in icons/ an icon name resolves to. bin/16-icons drops `-symbolic`,
  # which every icon in the set carries, and keeps `-rtl`, which is a different drawing.
  def self.icon_file(name) = name.sub(/-symbolic(?=(-rtl|-ltr)?\z)/, "")

  # Every icon the generated rules name, which is what icons.css has to declare.
  def self.named_icons(final)
    final.to_json.scan(/--adw-icon:var\(--icon-([a-z0-9-]+)\)/).flatten.uniq
  end

  # A variable name for an icon. `application-rss+xml-symbolic` is a real icon name and
  # `+` is not an identifier character, so the variable is named after it rather than
  # with it.
  def self.css_name(name) = name.gsub(/[^a-zA-Z0-9_-]/, "-")

  # The same name as a class selector, where the character has to be escaped rather than
  # replaced: it is the class the element actually carries, because it is the icon name
  # the application wrote.
  def self.css_escape(name) = name.gsub(/[^a-zA-Z0-9_-]/) { "\\#{::Regexp.last_match(0)}" }

  # An SVG as a URL, with the few characters which cannot go in one escaped. Not base64:
  # the markup stays readable, and it compresses better than base64 does.
  def self.data_uri(svg)
    cleaned = svg.gsub(/<\?xml.*?\?>/m, "").gsub(/<!--.*?-->/m, "").gsub(/\s+/, " ").strip

    "data:image/svg+xml,#{cleaned.gsub('%', '%25').gsub('"', "'").gsub('#', '%23')
      .gsub('<', '%3C').gsub('>', '%3E')}"
  end

  def self.kebab(name)
    name.gsub(/([a-z0-9])([A-Z])/, '\1-\2').downcase
  end

  # `subtitle-lines` -> `subtitleLines`.
  def self.camel(name)
    parts = name.to_s.split(/[-_]/)

    parts.first.to_s + parts.drop(1).map(&:capitalize).join
  end

  # The components which show ONE of their children, and the file which picks it.
  STACKS = %w[Stack ViewStack Leaflet Squeezer MultiLayoutView Notebook].to_set

  # Adwaita's own class names, for `cn` to hold aside.
  #
  # A component writes the class the stylesheet addresses as well as the measurements it
  # resolves to, and a few of those names read as Tailwind utilities: `text-button` is a
  # `text-` class to tailwind-merge, so putting it on a button dropped the
  # `text-[var(--destructive-color)]` that `.destructive-action` had just set and every
  # Delete button in the registry came out grey. `hidden`, `block`, `border`, `inline`,
  # `top`, `bottom`, `left` and `right` are the same hazard.
  def self.style_classes_ts(names)
    <<~TS
      // Generated by bin/11-generate-components. Do not edit.
      //
      // Every class name Adwaita's stylesheet addresses. `cn` keeps these out of
      // tailwind-merge, which would otherwise read `text-button` as a text colour and
      // drop the colour the class beside it had just set.

      export const STYLE_CLASSES: ReadonlySet<string> = new Set([
      #{names.map{|one| "  #{one.inspect}," }.join("\n")}
      ])
    TS
  end

  UTILS_TS = <<~'TS'
    // Generated by bin/11-generate-components. Do not edit.

    import { type ClassValue, clsx } from "clsx"
    import { twMerge } from "tailwind-merge"

    import { NODES, SCOPED, UNIVERSAL } from "./adwaita-classes"
    import { STYLE_CLASSES } from "./style-classes"

    // Adwaita's names in, Tailwind out.
    //
    // A component says what it is and what it carries, the way GTK does:
    //
    //     cn("button", "flat circular")
    //
    // The first argument is the CSS node, which is the context the names after it resolve
    // in -- `.flat` is not the same thing on a button as on a split button, and the node is
    // what tells them apart. Nothing is calculated here: the table holds what the stylesheet
    // says about every name it addresses, including what it says about the widgets INSIDE
    // one, which rides along as an arbitrary variant.
    //
    // THE NAME IS KEPT as well as resolved. A contextual rule reaches its subject through the
    // class that subject carries -- `.navigation-sidebar > listview.header > header` lives on
    // the sidebar as `[&>[data-node=listview].header>[data-node=header]]:m-3` -- so a list
    // view which resolved `.header` and then dropped it is a list view that rule cannot find.
    //
    // A first argument which is not a node is classes like any other, so the structural calls
    // -- `cn("flex flex-col", className)` -- still read the same.
    //
    // tailwind-merge is given only the utilities: `text-button` is one of Adwaita's names and
    // a `text-` utility to tailwind-merge, which dropped the colour sitting beside it.
    export function cn(...inputs: ClassValue[]) {
      const [first, ...rest] = inputs
      const node = typeof first === "string" && NODES[first] !== undefined ? first : null
      const tokens = clsx(node === null ? inputs : rest).split(" ").filter(Boolean)

      const names: string[] = []
      const utilities: string[] = []

      // The node is NOT written. It is `data-node`, which is what every rule selects it by,
      // and writing it too put `.box` on every box and `.button` on every button -- markup the
      // toolkit does not have, which any rule written against those classes then matched.
      if (node !== null) utilities.push(NODES[node])

      for (const token of tokens) {
        const scoped = node === null ? undefined : SCOPED[`${node}.${token}`]
        const resolved = scoped ?? UNIVERSAL[token]

        if (resolved !== undefined) {
          // ONLY A REAL STYLE CLASS IS WRITTEN. A name may resolve without being a class
          // Adwaita states -- the layout manager a node is arranged by is one -- and writing
          // it put `.box` on every box and `.button` on every button, which is markup the
          // toolkit does not have and which any rule written against it would match wrongly.
          // A name is written only when it is a class Adwaita states AND is not the name of a
          // node: the manager a node is arranged by resolves like any other name and is not a
          // class the toolkit puts on anything.
          if (STYLE_CLASSES.has(token) && NODES[token] === undefined) names.push(token)
          utilities.push(resolved)
        } else if (STYLE_CLASSES.has(token) && NODES[token] === undefined) {
          names.push(token)
        } else {
          utilities.push(token)
        }
      }

      const merged = twMerge(utilities.join(" ").split(" ").filter(Boolean).join(" "))

      return [...new Set(names), merged].join(" ").trim()
    }
  TS

  # The table, with what the registry knows folded into what the stylesheet says.
  #
  # `.horizontal` and `.vertical` are GTK's own names -- it puts one of them on every
  # orientable widget -- so the direction a box runs in is registered under the name the
  # toolkit already uses for it rather than restated on each box.
  def self.table_for(final, components)
    table = RegistryClasses.table(final, self.structure(components), self.measurements(components))

    HAND_LAID_MEASURE.each do |name, utilities|
      found = table.fetch("universal")
      found[name] = [found[name], utilities].compact.reject(&:empty?).join(" ")
    end

    {
      "horizontal" => ALIGNMENT.fetch("row"), "vertical" => ALIGNMENT.fetch("col"),
      LAY_ROW => ALIGNMENT.fetch("row"), LAY_COL => ALIGNMENT.fetch("col"),
    }
      .each do |name, utilities|
        found = table.fetch("universal")
        direction = [LAY_ROW, "horizontal"].include?(name) ? "flex-row" : "flex-col"

        found[name] = [found[name], direction, utilities].compact.reject(&:empty?).join(" ")
      end

    table["universal"] = table.fetch("universal").sort.to_h
    table
  end

  # The table cn resolves through, as TypeScript. Written as three flat objects rather than
  # one nested one so that a lookup is a property access and the whole thing minifies to the
  # strings it holds.
  def self.classes_ts(table)
    sections = {
      "NODES" => [table.fetch("nodes"), "Every CSS node a component renders as, and what Adwaita says about it."],
      "SCOPED" => [table.fetch("scoped"), "A node's own style classes, keyed `node.class`: `.flat` is not the same thing on a button as on a split button."],
      "UNIVERSAL" => [table.fetch("universal"), "The classes Adwaita states without naming a widget, which go on whichever widget is given them."],
    }

    written = sections.map do |constant, (entries, note)|
      body = entries.map{|key, value| "  #{key.inspect}: #{value.inspect}," }.join("\n")

      <<~TS.strip
        // #{note}
        export const #{constant}: Readonly<Record<string, string>> = {
        #{body}
        }
      TS
    end

    <<~TS
      // Generated by bin/11-generate-components. Do not edit.
      //
      // Adwaita's class names, against the Tailwind each one resolves to.
      //
      // bin/03-adwaita-tailwind reads the stylesheet and turns its declarations into Tailwind;
      // this is that output, keyed by the name Adwaita addresses rather than distributed over the
      // components by guesswork. A rule the stylesheet states about a widget because of where it
      // is belongs to the compound that owns it and rides along as an arbitrary variant, so
      // there is no stylesheet left for a component to need.

      #{written.join("\n\n")}
    TS
  end

  STACK_TS = <<~'TS'
    // Generated by bin/11-generate-components. Do not edit.
    //
    // A GtkStack shows ONE of its children. Every other toolkit widget in this registry draws
    // everything it is given, so the components rendered a stack's pages all at once: the file
    // grid and the file list in bin/apps/files were drawn one under the other, and a view stack
    // showed every page of a preferences window at the same time.
    //
    // Which one shows is `visible-child-name`, matched against the child's own `name` -- the
    // property GTK matches it against too. With no name on either side the first child shows,
    // which is what an unset `visible-child-name` means in GTK.

    import * as React from "react"

    export function visibleChild(children: React.ReactNode, name?: string): React.ReactNode {
      const list = React.Children.toArray(children).filter(React.isValidElement)

      if (list.length === 0) {
        return children
      }

      if (name === undefined) {
        return list[0]
      }

      const found = list.find((child) => {
        const props = child.props as { name?: string } | null

        return props?.name === name
      })

      return found ?? list[0]
    }
  TS

  # `Button` -> `buttonVariants`.
  def self.variants_name(name)
    "#{name.sub(/\A./, &:downcase)}Variants"
  end

  # `suggested-action` -> `SuggestedAction`.
  def self.pascal(name)
    name.to_s.split(/[-_]/).map{|part| part.sub(/\A./, &:upcase)}.join
  end

  def self.annotation(attributes, flags)
    if attributes.fetch("type") == "enum"
      name = self.enum_names.fetch(attributes.fetch("enum"), attributes.fetch("enum").split(".").last)

      flags.include?(attributes.fetch("enum")) ? "#{name}[]" : name
    else
      TYPES.fetch(attributes.fetch("type"), "unknown")
    end
  end

  def self.declaration(prop, attributes, flags)
    comment = "  /** #{attributes.fetch('gir') || 'object'}, from #{attributes.fetch('from')} */"
    "#{comment}\n  #{prop}?: #{self.annotation(attributes, flags)}"
  end

  def self.widget_props(shared, flags)
    lines = shared.sort.map{|prop, attributes| self.declaration(prop, attributes, flags)}
    enums = self.enums_used(shared)

    <<~TS
      // Generated by bin/11-generate-components. Do not edit.
      //
      // Gtk.Widget's own writable properties, which every widget has. lib/widget.ts
      // resolves them to the className, style and attributes which say the same thing.

      import type { ReactNode } from "react"
      #{enums.empty? ? '' : "import type { #{enums.join(', ')} } from \"./enums\"\n"}
      export interface WidgetProps {
      #{lines.join("\n\n")}
      }
    TS
  end

  def self.enums_used(props)
    props.values
      .select{|attributes| attributes.fetch("type") == "enum"}
      .map{|attributes| self.enum_names.fetch(attributes.fetch("enum"), attributes.fetch("enum").split(".").last)}
      .uniq
      .sort
  end

  # The TypeScript name of every enumeration, by the same rule bin/09-gtk-enums declares them
  # under: a bare name where it is unambiguous and the namespace in front of it where two
  # namespaces claim one.
  class << self
    attr_accessor :enum_names
  end
  self.enum_names = {}

  # The style classes a caller chooses between. The ones the toolkit applies from the
  # component's own content are not a choice, so they are not props.
  def self.offered(component)
    automatic = self.automatic(component)

    self.content(component).then do |applied|
      component.fetch("variants", {}).reject{|style, _| applied.key?(style) || automatic.include?(style) }
    end
  end

  # How the component arranges its children, read from the layout manager its source
  # sets. A box also takes its direction from its orientation and its gap from its
  # spacing, which are properties rather than rules.
  # A component's layout, AS NAMES.
  #
  # What a layout manager does is a fact about the CSS node -- every `box` runs its children
  # in a line -- so it is generated into the table against that node and not restated on each
  # component which renders as one. What is left is the direction, and GTK already has a name
  # for that: it puts `.horizontal` or `.vertical` on every orientable widget, which is the
  # name the table holds and the name a component writes.
  def self.layout(name, component)
    return "" if LEAVES.include?(self.element(component)) || (self.leaves || Set.new).include?(component["node"])

    kind = self.layout_kind(name, component)
    node = component["node"]
    manager = self.manager(kind)
    named = (self.conflicted || Set.new).include?(node) && !manager.empty? ? "#{manager.inspect}, " : ""

    return named unless kind.to_s.start_with?("box")

    props = component.fetch("props", {})

    orientable = node == "box"

    if props.key?("orientation") && !kind.include?("-")
      return "#{named}(orientation === \"vertical\" ? #{(orientable ? 'vertical' : LAY_COL).inspect} : #{(orientable ? 'horizontal' : LAY_ROW).inspect}), "
    end

    vertical = kind == "box-vertical" || component["direction"] == "vertical"

    "#{named}#{(vertical ? (orientable ? 'vertical' : LAY_COL) : (orientable ? 'horizontal' : LAY_ROW)).inspect}, "
  end

  # The utilities a node's layout manager is worth, which is what goes in the table against
  # that node. The direction is not here: it is `.horizontal` and `.vertical`, which are
  # names, and a node is both over its lifetime.
  def self.layout_utilities(kind, single_child: false, gizmo: false)
    return "#{LAYOUTS.fetch('clamp')} #{CLAMP_CLASSES}" if kind == :clamped

    LAYOUTS[kind.to_s.sub(/-(vertical|horizontal)\z/, "")] ||
      (single_child ? LAYOUTS.fetch("bin") : nil) ||
      (gizmo ? LAYOUTS.fetch("box") : nil) ||
      ""
  end

  # Whether this node is one the DOM lays nothing out inside: an <input>, a <textarea>, or
  # any other element which has no children to arrange.
  LEAVES = %w[input textarea img hr svg br].freeze

  # Every node name which is rendered as a leaf element somewhere in the registry.
  def self.leaf_nodes(components)
    found = Set.new

    components.each_value do |component|
      node = component["node"]

      found << node if !node.to_s.empty? && LEAVES.include?(self.element(component))

      tree = component["tree"]

      next if tree.nil?

      self.each_node(tree) do |one|
        found << one["node"] if !one["node"].to_s.empty? && self.laid_out?(one)
      end
    end

    found
  end

  def self.laid_out?(node)
    LEAVES.include?(self.element_for(node))
  end

  # The direction a layout runs, as a name which is NOT one of Adwaita's classes: it resolves
  # to the same utilities as `.horizontal` and `.vertical` and is never written to the DOM,
  # because the toolkit writes those two only on a widget which is orientable.
  LAY_ROW = "lay-row"
  LAY_COL = "lay-col"

  # The layout manager, by the name GTK gives it.
  def self.manager(kind, single_child: false, gizmo: false)
    return "clamp" if kind == :clamped

    normalised = kind.to_s.sub(/-(vertical|horizontal)\z/, "")

    return normalised if LAYOUTS.key?(normalised)
    return "bin" if single_child
    return "box" if gizmo

    ""
  end

  # The nodes the hand-laid bodies name which no tree reaches, and what each is worth. They
  # are here rather than in those bodies for the same reason as everything else: a component
  # writes names, and what a name means is in one place.
  HAND_LAID_MEASURE = {
    "toolbar-view-content" => "order-2 flex grow flex-col [&>*]:grow [&>*]:min-h-0 min-h-0",
    "inline-view-switcher" => "flex",
    "toast" => "items-center justify-self-center self-end",
    "separator" => "self-stretch my-1.5",
    "viewswitcher" => "my-[-3px] min-h-1.5",
    "toggle-group" => "items-center grow",
    "info-bar-box" => "items-center",
    "info-bar-content" => "items-center grow",
    "toast-widget-inner" => "flex items-center",
    "view-switcher-toggle" => "grow basis-0",
    "view-switcher-bin" => "grow flex items-center justify-center",
    "centerbox" => "grid [grid-template-columns:1fr_auto_1fr] items-center",
    "start" => "",
    "end" => "justify-self-end",
    "fills" => "grow min-h-0",
    "scrolls" => "overflow-auto",
    "sidebar-row" => "items-center grow gap-3 px-3",
    "sidebar-row-text" => "grow justify-center",
  }.freeze

  # What a node measures wherever it is rendered: the thickness a trough takes from the
  # slider in it, the width a switch's track takes from its own, the way a label places its
  # text, the room a text node gives itself, the icon an image centres. Facts about the node,
  # so they belong to the node in the table rather than to each component which draws one.
  def self.measurements(components)
    found = Hash.new{|key, value| key[value] = [] }
    # A node name which is a container somewhere is never the <input>. GTK's `entry` is the
    # box around the text and `text` is the text, but the tree reaches an `entry` node whose
    # own element is an <input> -- and `basis-0 grow` registered against `entry` made every
    # entry take the whole column it sat in.
    containers = components.each_value.filter_map{|one| one["node"] unless one["tree"].nil? }.to_set

    components.each_value do |component|
      tree = component["tree"]
      root = component["node"]

      next if tree.nil?

      self.each_node(tree) do |one|
        node = one["node"]

        next if node.to_s.empty?

        found[node] << self.trough_classes(one)
        found[node] << self.track_part(one)
        # The <input> ITSELF fills the entry around it. The entry does not fill what IS
        # around it: `basis-0 grow` on the entry made it take every spare pixel of the
        # column it sat in, which is an entry 71px tall against the toolkit's 34.
        found[node] << TEXT_CLASSES if LEAVES.include?(self.element_for(one)) && !containers.include?(node)
        found[node] << LABEL_CLASSES if self.label_node?(one)
        found[node] << "self-center" if self.icon_part?(one)
        # THE WINDOW CONTROLS ARE ALWAYS OUTERMOST. GTK packs them at the very edge and
        # whatever the application packs sits inside them; rendered in tree order the close
        # button came out to the left of the header bar's own buttons.
        found[node] << "order-last" if node == "windowcontrols"
        # A SCROLLED WINDOW SCROLLS. GTK gives it whatever the window has and the child
        # scrolls inside it; left to grow in the document's flow it took the height of its
        # content instead -- 663px of page in a 620px window, which put the toast overlay's
        # toast below the bottom edge where nothing could see it.
        found[node] << "overflow-auto min-h-0" if node == "scrolledwindow"
      end

    end

    HAND_LAID_MEASURE.each{|node, utilities| found[node] << utilities }

    found.transform_values{|list| list.compact.reject(&:empty?) }
  end

  # Every node under this one, with the path of CSS nodes which reaches it.
  def self.each_path(node, path, &block)
    node.fetch("children", []).each do |child|
      name = child["node"]
      reached = name.to_s.empty? ? path : path + [[">", name]]

      block.call(child, reached)
      self.each_path(child, reached, &block)
    end
  end

  # Every node the registry renders, against what its layout manager does, so that the table
  # can carry it. Collected over every component and every node in every tree, because the
  # same node is reached both ways.
  def self.structure(components)
    found = Hash.new{|key, value| key[value] = [] }
    # A node name which is EVER an <input> or a <textarea> takes no layout anywhere. The
    # table is keyed by the node, and GTK's `text` is an <input> in an entry and a <div>
    # elsewhere, so a layout registered for the one reaches the other -- and `display: flex`
    # on an <input> measured 71px against the toolkit's 34.
    leaves = self.leaf_nodes(components)

    components.each do |name, component|
      node = component["node"]

      unless node.to_s.empty? || LEAVES.include?(self.element(component)) || leaves.include?(node)
        kind = self.layout_kind(name, component)
        found[node] << [self.manager(kind), self.layout_utilities(kind)]
      end

      tree = component["tree"]

      next if tree.nil?

      self.each_node(tree) do |one|
        inner = one["node"]

        next if inner.to_s.empty?
        # A NODE WHICH IS AN <input> ARRANGES NOTHING. GTK's `text` node has children and
        # the DOM's does not, so a layout manager on it is a layout manager on a replaced
        # element: Chrome gave `display: flex` on an <input> a height of 71px where the
        # toolkit's entry is 34, which is every entry in the registry twice too tall.
        next if self.laid_out?(one) || leaves.include?(inner)

        kind = CLAMPED.include?(one.fetch("class")) ? :clamped : self.node_layout(one)

        single = self.single_child?(one)
        gizmo = one.fetch("class") == "Gizmo" && !single

        found[inner] << [
          self.manager(kind, single_child: single, gizmo: gizmo),
          self.layout_utilities(kind, single_child: single, gizmo: gizmo),
        ]
      end
    end

    found
  end

  # The layout this component arranges its children with: the manager its source names,
  # or what its C does where it names none.
  def self.layout_kind(name, component)
    HAND_LAID.fetch(name) do
      if component["items"]
        # A component which builds one node per item holds the caller's items, however
        # little is left in its own tree. Read as a box around one thing it became a
        # grid, and a toggle group's three toggles were drawn on top of one another.
        "#{component['layout']}#{component['direction'] == 'vertical' ? '-vertical' : ''}"
      elsif self.single_child?(component)
        # A box holding one thing is that thing's whole allocation: GtkBoxLayout brings
        # every child up to its natural size before it gives anything away, and with one
        # child there is nobody to give it away to. As a row of one it was as wide as its
        # contents instead, so AdwPreferencesPage's scrolled window -- and the clamp
        # measuring itself inside it -- were 261px wide in a 480px page.
        "bin"
      elsif component["layout"].nil?
        # A WIDGET WHICH HOLDS SOMETHING ALWAYS ALLOCATES IT. GTK names a layout manager
        # for the widgets which arrange several children and leaves the rest to their own
        # C, which hands the child the whole allocation -- so a component with none got no
        # CSS layout at all and everything inside it fell into the document's flow, at the
        # top left, at its own natural size.
        #
        # That is AdwMessageDialog's heading, body and buttons piled into the corner of a
        # 920x620 window where the toolkit centres them and puts the buttons along the
        # foot, and the same for every window, dialog, popover and revealer in the
        # registry: 37 components, which is most of what an application is built out of.
        #
        # A leaf -- a label, an image, a separator -- holds nothing and is left alone.
        self.holds_children?(component) ? "bin" : nil
      else
        "#{component['layout']}#{component['direction'] == 'vertical' ? '-vertical' : ''}"
      end
    end.to_s
  end

  # Whether this component has anything to lay out: a tree with widget children, or a
  # place for the caller's own.
  def self.holds_children?(component)
    tree = component["tree"]

    return false if tree.nil?

    (tree.fetch("slots", {}).values + tree.fetch("children", []))
      .any?{|child| self.widget_node?(child) }
  end

  # A template whose root holds exactly one widget, which is therefore given all of it.
  def self.single_child?(component)
    tree = component["tree"]

    return false if tree.nil?

    children = (tree.fetch("slots", {}).values + tree.fetch("children", []))
      .select{|child| self.widget_node?(child) }

    children.length == 1
  end

  # The content classes, as the conditional they are: a button holding only a label is
  # `.text-button`, and the stylesheet gives that 17px of horizontal padding where a bare
  # button has 10px.
  def self.content_classes(component)
    props = component.fetch("props", {})
    text = (component.fetch("text", []) & props.keys).first
    icon = props.key?("iconName") ? "iconName" : nil
    named = { text: text, icon: icon }

    found = self.content(component).filter_map do |style, variant|
      # The class itself, and the measurements it resolves to. The name even where it
      # resolves to nothing on this node: `.horizontal` carries no declarations of its
      # own on a box, and `box.linked.horizontal > button` is written against it.
      value = AdwaitaClasses.expression(variant["classes"], 8, name: style)

      if BY_PROPERTY.key?(style)
        rule = BY_PROPERTY.fetch(style)

        next unless props.key?(rule.fetch(:prop))

        next "#{rule.fetch(:when)} && #{value}"
      end

      rule = CONTENT.fetch(style)
      needs = Array(rule.fetch(:needs)).map{|one| named[one] }

      next if needs.any?(&:nil?)

      without = named[rule[:without]]
      terms = needs + (without ? ["!#{without}"] : [])

      "#{terms.join(' && ')} && #{value}"
    end

    found.empty? ? "" : "#{found.join(', ')}, "
  end

  # The classes the widget puts on itself and nothing takes off, and the ones a property
  # of its own turns on and off. bin/05 reads both off the call site in the toolkit's C:
  # `.toggle` is added in gtk_toggle_button_init, and `.flat` in the branch of
  # gtk_button_set_has_frame where `has-frame` is false.
  #
  # Written as the class and the measurements both, because the stylesheet addresses the
  # class: `window.background` is where a window's own background colour is stated, and a
  # Window which carried neither was drawn on whatever it happened to sit on.
  def self.applied_classes(component)
    found = component.fetch("always", []).map do |style|
      AdwaitaClasses.expression(component.dig("variants", style, "classes"), 8, name: style)
    end

    component.fetch("byProperty", {}).each do |prop, polarities|
      polarities.each do |polarity, styles|
        styles.each do |style|
          value = AdwaitaClasses.expression(component.dig("variants", style, "classes"), 8, name: style)
          found << "#{polarity == 'false' ? "#{prop} === false" : prop} && #{value}"
        end
      end
    end

    found.empty? ? "" : "#{found.join(', ')}, "
  end

  # The style classes which are not the caller's to choose at all, so they are not
  # offered as variants. Only the unconditional ones: `.flat` is `has-frame` being false
  # and a caller setting that gets it, but a caller may also just ask for a flat button,
  # which is what `gtk_widget_add_css_class (button, "flat")` is in every application
  # that writes it.
  def self.automatic(component) = component.fetch("always", []).to_set

  # The classes this component applies itself: the ones its content decides, and the ones
  # a property decides. Neither is a prop, because neither is the caller's to choose.
  def self.content(component)
    component.fetch("variants", {}).select do |style, variant|
      (CONTENT.key?(style) || BY_PROPERTY.key?(style)) && variant.fetch("applied", false)
    end
  end

  # The element the component renders as.
  #
  # A widget which builds nodes inside itself is the container and not the leaf: Gtk.Entry
  # is `entry > text`, and the text is the `<input>`. Rendering the entry itself as one
  # put the parts inside a void element, which React refuses outright -- the whole
  # application threw and the page showed nothing where it had been.
  def self.element(component)
    found = ELEMENTS.fetch(component["node"], "div")

    component["tree"] && VOID.include?(found) ? "div" : found
  end

  # What a widget's own C does that nothing declarative states.
  #
  # A tree says which nodes a widget builds and the stylesheet says what each one
  # measures, and between them that is every widget here but a few. AdwAvatar is one of
  # the few: adw-avatar.c picks one of fourteen colours by hashing the text, shows the
  # label or the icon depending on `show-initials`, and neither the template nor any
  # rule in Adwaita says so. Generated as structure alone it is a correctly sized,
  # correctly rounded, entirely invisible box -- which is what every avatar in
  # bin/apps/mail and bin/apps/library was.
  #
  # The body here REPLACES the generated one. It is the last resort and the table is
  # meant to stay short: anything which can be read out of a source belongs in bin/08.
  OWN_BEHAVIOUR = {
    # `adw_preferences_group_add` sorts what it is given: an AdwPreferencesRow goes into
    # the group's list box -- which is the card the rows are drawn in -- and anything else
    # is appended to the group's own box BELOW that card. bin/apps/software adds a
    # progress bar, a level bar, a spinner and one row, and the toolkit draws the row in
    # the card with the other three under it; rendered in the order they were written they
    # were all inside the card and the row was last.
    "PreferencesGroup" => {
      body: <<~'TSX'.chomp,
        function PreferencesGroup({ className, render, variant = "default", description, headerSuffix, title, separateRows, children, ...props }: PreferencesGroupProps) {
          const { hidden, className: widgetClassName, style, attributes: widgetAttributes, rest } = widget(props)

          // The mark the generator puts on every component which descends from
          // AdwPreferencesRow. A child it cannot read -- a fragment, a bare element -- is
          // not a row, which is the answer gtk_widget_is_ancestor would give for it too.
          const all = React.Children.toArray(children)
          const isRow = (one: React.ReactNode) =>
            React.isValidElement(one) &&
            (one.type as { isPreferencesRow?: boolean })?.isPreferencesRow === true
          const rows = all.filter(isRow)
          const loose = all.filter((one) => !isRow(one))

          const defaultProps = {
            "data-slot": "preferences-group",
            "data-node": "preferencesgroup",
            "data-variant": variant,
            "data-separate-rows": separateRows,
            className: cn("preferencesgroup", "group/preferences-group", preferencesGroupVariants({ variant }), widgetClassName, className),
            style,
            children: (
              <>
                <PreferencesGroupBox>
                  <PreferencesGroupHeaderBox>
                    <PreferencesGroupBox2>
                      {title ? (
                        <PreferencesGroupTitle>{title}</PreferencesGroupTitle>
                      ) : null}
                      {description ? (
                        <PreferencesGroupDescription>{description}</PreferencesGroupDescription>
                      ) : null}
                    </PreferencesGroupBox2>
                  </PreferencesGroupHeaderBox>
                  <PreferencesGroupListboxBox>
                    {rows.length > 0 ? (
                      <PreferencesGroupListbox>
                        {rows}
                      </PreferencesGroupListbox>
                    ) : null}
                    {loose}
                  </PreferencesGroupListboxBox>
                </PreferencesGroupBox>
                {headerSuffix}
              </>
            ),
            ...widgetAttributes,
          }

          return useRender({
            defaultTagName: "div",
            enabled: !hidden,
            render,
            props: mergeProps<"div">(defaultProps, rest),
          })
        }
      TSX
    },
    # GtkInfoBar is a revealer around a row of three: the content area holding what the
