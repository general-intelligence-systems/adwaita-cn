#!/usr/bin/env ruby
# frozen_string_literal: true

# 14-APP-SCREENSHOTS(1)            General Commands Manual            14-APP-SCREENSHOTS(1)
#
# NAME
#      bin/14-app-screenshots — each application, the toolkit beside the components
#
# SYNOPSIS
#      bin/14-app-screenshots [--app NAME]
#
# DESCRIPTION
#      Builds every application in bin/apps/ twice -- once with libadwaita and
#      once from the registry's components -- and writes one PNG per application with
#      the two beside each other.
#
#      THE SIDE-BY-SIDE IS THE ONLY OUTPUT. Neither side's own PNG is kept: a shot of
#      one half on its own is not a comparison, and the pair of directories they used
#      to go in were two more things to keep in step.
#
#      Both sides are drawn at the size the manifest gives the application, so the two
#      halves of a shot are the same window twice.
#
# OPTIONS
#      --app NAME   One application rather than all of them.
#
# FILES
#      bin/apps/manifest.json        the applications
#      bin/apps/<name>/app.c         the toolkit's build of each `main` scene
#      bin/apps/<name>/app.rb        the toolkit's build of its dialogs
#      bin/apps/<name>/App.tsx       the registry's build
#      bin/14-app-screenshots.out/web/                 the built page, from vite
#      bin/14-app-screenshots.out/<name>.png the output
#
# EXIT STATUS
#      0 when every application was shot on both sides, 1 when any was not.
#
# SEE ALSO
#      bin/15-app-report
#
# adwaita-cn                        October 13, 2026                14-APP-SCREENSHOTS(1)

require "fileutils"
require "json"
require "tmpdir"
require "webrick"

# Written as it goes, rather than when the buffer happens to fill. A run's output is a
# line per scene and the whole of it was being lost when stdout was a pipe: the work was
# done and the shots were written, and what reached the terminal was nothing at all.
$stdout.sync = true

# Before the toolkit is loaded, because this picks the backend GDK will open.
require_relative "lib/offscreen"
Offscreen.start

require "gtk4"
require "adwaita"
require "ferrum"

require_relative "lib/staging"

# Requiring the bindings does not load libadwaita's stylesheet; adw_init() does.
Adwaita.init
Offscreen.match_desktop

# The components render in whatever scheme the page asks for, and the toolkit otherwise
# follows the desktop's. A dark window beside a light page is a difference which says
# nothing about either.
Adwaita::StyleManager.default.color_scheme = Adwaita::ColorScheme::FORCE_LIGHT

# A GTK critical is not a reason to lose the run.
GLib::Log.always_fatal = GLib::Log::LEVEL_ERROR

module AppScreenshots
  ROOT = File.expand_path("..", __dir__)
  PORT = 7416

  # Wide enough for the widest case beside its toolkit twin. The height is only what the
  # window opens at; `fit` grows it to the page before anything is shot.
  VIEWPORT_WIDTH = 1600
  VIEWPORT_HEIGHT = 2000
  VIEWPORT_MARGIN = 64
  # A script's output sits beside it, under its own name: bin/14-app-screenshots.out.
  OUTPUT = "#{__FILE__}.out"

  # The gutter around and between the halves, and the strip above them which says
  # which half is which.
  PAD = 16
  LABEL = 28

  def self.run(argv)
    only = argv.each_cons(2).find{|flag, _| flag == "--app" }&.last
    wanted = apps.select{|one| only.nil? || one.fetch("name") == only }

    abort("no such application: #{only}") if wanted.empty?

    FileUtils.mkdir_p(OUTPUT)

    Dir.mktmpdir do |scratch|
      scenes = Staging.scenes(wanted)
      theirs = toolkit(scenes, scratch)
      ours = components(scenes, scratch)

      # One PNG per application, not per scene: an application is one thing, and its
      # dialogs are part of it. Each scene is a row of that application's sheet.
      failed = wanted.reject do |one|
        name = one.fetch("name")
        rows = one.fetch("scenes").map do |scene|
          Staging.shot(one, scene).then{|shot| [scene.fetch("name"), theirs[shot], ours[shot]] }
        end

        compose(name, rows).then do |error|
          error.nil? ? puts("#{name}: #{relative(name)} (#{rows.length} #{rows.length == 1 ? 'scene' : 'scenes'})") : puts("#{name}: #{error}")
          error.nil?
        end
      end

      exit(failed.empty? ? 0 : 1)
    end
  end

  def self.relative(name) = File.join(OUTPUT, "#{name}.png").delete_prefix("#{ROOT}/")

  # ── the toolkit ──────────────────────────────────────────────────────────

  # One PNG per scene, or nil where the window could not be built.
  #
  # TWO SOURCES, because the toolkit side is built in two languages. Each application's
  # `main` scene is bin/apps/<name>/app.c, shot by the same C program which walks it, so a
  # shot and a measurement are of one window rather than of two builds of it. The dialogs
  # are scenes no app.c has yet, and those are still staged here through app.rb.
  def self.toolkit(scenes, scratch)
    painted = compiled(scratch)

    remaining = scenes.reject{|one, scene| painted.key?(Staging.shot(one, scene)) }

    return painted if remaining.empty?

    app = Gtk::Application.new("dev.adwaita-cn.app-screenshots", :default_flags)
    app.signal_connect("activate") do
      remaining.each{|one, scene| painted[Staging.shot(one, scene)] = paint(app, one, scene, scratch) }
      renderer_done
      app.quit
    end
    app.run([])

    painted
  end

  # The scenes bin/apps/*/app.c builds, shot by bin/lib/app-trees.c.
  #
  # RUN BEFORE THE RUBY TOOLKIT SIDE, and in a process of its own. Both halves want a
  # GtkApplication and GTK is initialised once per process, so the C cannot be a library
  # called from here; it is a program, run on the display this script already made.
  #
  # The font, the scaling and the decoration layout go with it. GtkSettings is per
  # process, so what Offscreen.match_desktop applied here reaches nothing over there, and
  # a scene laid out in GTK's fallback font is a different width in every label.
  def self.compiled(scratch)
    binary = File.join(scratch, "app-trees")
    sources = [File.join(ROOT, "bin/lib/app-trees.c"), *Dir.glob(File.join(ROOT, "bin/apps/*/app.c")).sort]

    return {} if sources.length < 2

    flags = `pkg-config --cflags --libs gtk4 libadwaita-1`.strip.split

    unless system("gcc", "-O2", "-o", binary, *sources, *flags, out: File::NULL, err: File::NULL)
      warn("app.c did not build; the toolkit side falls back to app.rb")
      return {}
    end

    directory = File.join(scratch, "compiled")
    FileUtils.mkdir_p(directory)

    unless system(Offscreen.env, binary, "--png", directory, out: File::NULL)
      warn("app-trees did not run; the toolkit side falls back to app.rb")
      return {}
    end

    Dir.glob(File.join(directory, "*.png")).to_h{|path| [File.basename(path, ".png"), path] }
  end

  def self.paint(app, one, scene, scratch)
    name = Staging.shot(one, scene)
    path = File.join(scratch, "gtk-#{name}.png")

    Staging.stage(app, one, scene) do |content|
      size(one, scene, content).then do |width, height|
        Gtk::Snapshot.new.then do |snapshot|
          # The window's own background, over the whole rectangle, before the widget.
          # A render node is bounded by what was painted into it, and an application
          # which leaves its edges transparent came out cropped -- 451x515 for a window
          # GTK had allocated at 480x640, which is a different picture, not a smaller
          # one.
          snapshot.append_color(background, Graphene::Rect.new(0, 0, width, height))

          Gtk::WidgetPaintable.new(content).snapshot(snapshot, width, height)

          node = snapshot.to_node
          return nil if node.nil?

          renderer.render_texture(node, nil).save_to_png(path)
          path
        end
      end
    end
  rescue StandardError => e
    warn("#{name}: #{e.class}: #{e.message.lines.first.to_s.strip}")
    nil
  end

  # The rectangle to paint into.
  #
  # The manifest's, except in overlay mode: a dialog's card and a popover are whatever
  # size their own contents ask for, and painting one into the host window's rectangle
  # stretched it to fill a window it never covered.
  def self.size(one, scene, content)
    return [one.fetch("width"), one.fetch("height")] unless scene.fetch("mode", "content") == "overlay"

    [content.width, content.height]
  end

  # The window background, as libadwaita's stylesheet gives it. Read off a realised
  # window rather than written down, so it follows the scheme the run forces.
  def self.background
    @background ||= Gdk::RGBA.parse("#fafafb")
  end

  # Realised once and reused: realising a renderer per shot is most of the time a run
  # takes. One still realised at teardown is a GSK assertion failure, after every shot
  # has already been taken.
  def self.renderer = @renderer ||= Gsk::CairoRenderer.new.tap{|one| one.realize(nil) }

  def self.renderer_done
    @renderer&.unrealize
    @renderer = nil
  end

  # ── the components ───────────────────────────────────────────────────────

  def self.components(scenes, scratch)
    serving do |page|
      scenes.to_h do |one, scene|
        name = Staging.shot(one, scene)

        [name, shoot(page, name, File.join(scratch, "web-#{name}.png"))]
      end
    end
  end

  def self.shoot(page, name, path)
    selector = "[data-shot=#{name.to_json}]"

    return nil if page.evaluate("!!document.querySelector(#{selector.to_json})") != true

    page.screenshot(path: path, selector: selector, scale: 1)
    path
  rescue StandardError => e
    warn("#{name}: #{e.message.lines.first.to_s.strip}")
    nil
  end

  # The page, built from the registry's own sources before it is served.
  #
  # Here rather than by hand: both this and the other of the pair serve
  # bin/14-app-screenshots.out/web, and neither of them built it, so a run after a change
  # to a component reported the page as it had been the last time somebody remembered to
  # run vite. A comparison of a stale build is a comparison of nothing.
  def self.vite
    command = ["pnpm", "exec", "vite", "build", "-c", "vite.comparison.config.ts", "--logLevel", "warn"]

    Dir.chdir(ROOT) do
      system(*command, out: File::NULL) || abort("#{command.join(' ')} failed")
    end
  end

  def self.serving
    self.vite

    server = WEBrick::HTTPServer.new(
      Port: PORT,
      DocumentRoot: File.join(ROOT, "bin/14-app-screenshots.out/web"),
      Logger: WEBrick::Log.new(File::NULL),
      AccessLog: [],
    )
    Thread.new{server.start}

    browser = Ferrum::Browser.new(
      browser_path: ENV.fetch("BROWSER_PATH", nil),
      headless: true,
      window_size: [VIEWPORT_WIDTH, VIEWPORT_HEIGHT],
      timeout: 60,
      browser_options: { "force-device-scale-factor" => "1", "hide-scrollbars" => nil },
    )

    begin
      browser.go_to("http://127.0.0.1:#{PORT}/")
      browser.network.wait_for_idle(timeout: 30)
      self.fit(browser)
      yield(browser)
    ensure
      browser.quit
      server.shutdown
    end
  end

  # The viewport, grown to the page.
  #
  # A SHOT BELOW THE FOLD IS BLANK. The window was opened at a height picked to be larger
  # than the page could plausibly be, and the page outgrew it: every case is stacked down one
  # document, and at 42 of them it ran past 20,000px. Chromium renders what is in the
  # viewport, so the cases past the end came back as empty rectangles -- a preferences window
  # with its pages in it photographed as a blank panel, which reads as a broken component and
  # is a short window.
  #
  # Measured rather than raised: the next case added would run past a bigger guess too.
  def self.fit(browser)
    height = browser.evaluate(<<~JS)
      Math.max(
        document.documentElement.scrollHeight,
        document.body.scrollHeight,
      )
    JS

    return unless height.is_a?(Numeric) && height.positive?

    browser.resize(width: VIEWPORT_WIDTH, height: height.ceil + VIEWPORT_MARGIN)
  end

  # ── the two, side by side ────────────────────────────────────────────────

  # nil when the sheet was written, and the reason when it was not.
  #
  # One row per scene: the application's own window first, then each dialog it opens,
  # the toolkit's on the left and the components' on the right.
  def self.compose(name, rows)
    drawn = rows.map{|scene, left, right| [scene, surface(left), surface(right)] }

    missing = drawn.select{|_, left, right| left.nil? || right.nil? }
    return missing.map{|scene, left, _| "#{scene}: #{left.nil? ? 'the toolkit drew nothing' : 'the components rendered nothing'}" }.join("; ") unless missing.empty?

    theirs = drawn.map{|_, left, _| left.width }.max
    ours = drawn.map{|_, _, right| right.width }.max

    width = PAD + theirs + PAD + ours + PAD
    height = drawn.sum{|_, left, right| LABEL + [left.height, right.height].max + PAD }

    Cairo::ImageSurface.new(:argb32, width, height).then do |surface|
      Cairo::Context.new(surface).then do |cr|
        cr.set_source_rgb(1, 1, 1)
        cr.paint

        drawn.inject(0) do |y, (scene, left, right)|
          half(cr, left, PAD, y, "#{scene} — libadwaita #{left.width}x#{left.height}")
          half(cr, right, PAD + theirs + PAD, y, "#{scene} — adwaita-cn #{right.width}x#{right.height}")

          y + LABEL + [left.height, right.height].max + PAD
        end
      end

      surface.write_to_png(File.join(OUTPUT, "#{name}.png"))
    end

    nil
  rescue StandardError => e
    "#{e.class}: #{e.message.lines.first.to_s.strip}"
  end

  def self.surface(path) = path.nil? ? nil : Cairo::ImageSurface.from_png(path)

  # One half of one row: the shot, a hairline around it so its edge is visible against
  # the page, and which half it is and what size above it.
  def self.half(cr, surface, x, y, caption)
    cr.save
    cr.set_source_rgb(0.4, 0.4, 0.4)
    cr.select_font_face("sans-serif", Cairo::FONT_SLANT_NORMAL, Cairo::FONT_WEIGHT_NORMAL)
    cr.font_size = 12
    cr.move_to(x, y + LABEL - 10)
    cr.show_text(caption)
    cr.restore

    cr.set_source(surface, x, y + LABEL)
    cr.rectangle(x, y + LABEL, surface.width, surface.height)
    cr.fill

    cr.set_source_rgb(0.75, 0.75, 0.75)
    cr.line_width = 1
    cr.rectangle(x - 0.5, y + LABEL - 0.5, surface.width + 1, surface.height + 1)
    cr.stroke
  end

  def self.apps
    @apps ||= JSON.parse(File.read(File.join(ROOT, "bin/apps/manifest.json"))).fetch("apps")
  end
end

AppScreenshots.run(ARGV)
