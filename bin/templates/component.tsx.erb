// <%= c.name %> — <%= c.library %>.<%= c.name %>
//
// Generated by bin/05-components from bin/01-fetch-adwaita.out/widgets.json and
// bin/03-adwaita-tailwind.out/scss-widgets.json: what a running GTK said this widget
// builds, and what libadwaita's stylesheet says about every name it addresses.
// Do not edit.

import * as React from "react"
import { mergeProps } from "@base-ui/react/merge-props"
import { useRender } from "@base-ui/react/use-render"
<% if c.cva? -%>
import { cva, type VariantProps } from "class-variance-authority"
<% end -%>

import { cn } from "@/lib/utils"
<% if icon -%>
import { Icon } from "@/lib/icon"
<% end -%>
import { widget } from "@/lib/widget"
import type { WidgetProps } from "@/lib/widget-props"
<% unless c.enums.empty? -%>
import type { <%= c.enums.join(", ") %> } from "@/lib/enums"
<% end -%>
<% if c.cva? -%>

// Adwaita's own style classes for this node, as the two things a caller chooses
// between: a variant changes how it looks and a size changes how big it is. Both
// are the names the stylesheet states -- `cn` resolves them to utilities -- so a
// rule written against `.suggested-action` still finds the element carrying it.
const <%= camel %>Variants = cva("", {
  variants: {
<% unless c.variants.empty? -%>
    variant: {
      default: "",
<% c.variants.each do |v| -%>
      /** .<%= v.key %> */
      <%= v.name %>: "<%= v.key %>",
<% end -%>
    },
<% end -%>
<% unless c.sizes.empty? -%>
    size: {
      default: "",
<% c.sizes.each do |s| -%>
      /** .<%= s.key %> */
      <%= s.name %>: "<%= s.key %>",
<% end -%>
    },
<% end -%>
  },
  defaultVariants: { <%= variant_defaults %> },
})
<% end -%>

export interface <%= c.name %>Props
  extends Omit<useRender.ComponentProps<"<%= c.element %>">, keyof WidgetProps<%= omitted %>>,
<% if c.cva? -%>
    VariantProps<typeof <%= camel %>Variants>,
<% end -%>
    WidgetProps {
<% c.props.each do |p| -%>
  /** <%= p.gtype %>, from <%= p.owner %> */
  <%= p.name %>?: <%= p.type %>

<% end -%>
}

function <%= c.name %>({ className, render, <%= destructured %>children, ...props }: <%= c.name %>Props) {
  const { hidden, className: widgetClassName, style, attributes: widgetAttributes, rest } = widget(props)

  // Named rather than passed inline: a fresh object literal handed straight to mergeProps
  // is excess-property checked against the element's props, which no data attribute of
  // ours is one of.
  const defaultProps = {
    "data-slot": "<%= c.slug %>",
    "data-node": "<%= c.node %>",
<% data_attributes.each do |a| -%>
    <%= a %>,
<% end -%>
    className: cn(<%= classes %>, widgetClassName, className),
    style<%= style_extra %>,
<% unless c.void? -%>
    children: (
      <>
<%= children %>
      </>
    ),
<% end -%>
    ...widgetAttributes,
  }

  return useRender({
    defaultTagName: "<%= c.element %>",
    enabled: !hidden,
    render,
    props: mergeProps<"<%= c.element %>">(defaultProps, rest),
  })
}
<% parts.each do |part| -%>
<% if part.element == "Icon" -%>

function <%= part.function %>({ className, name = "<%= part.icon %>", ...props }: React.ComponentProps<typeof Icon>) {
  return (
    <Icon
      name={name}
      data-slot="<%= Components.kebab(part.function) %>"
      data-node="<%= part.node %>"
      className={cn(<%= part.classes.map { |k| %("#{k}") }.join(", ") %>, className)}
      {...props}
    />
  )
}
<% else -%>

function <%= part.function %>({ className, ...props }: React.ComponentProps<"<%= part.element %>">) {
  return (
    <<%= part.element %>
      data-slot="<%= Components.kebab(part.function) %>"
      data-node="<%= part.node %>"
      className={cn(<%= part.classes.map { |k| %("#{k}") }.join(", ") %>, className)}
      {...props}
    />
  )
}
<% end -%>
<% end -%>

export { <%= c.name %><%= c.cva? ? ", #{camel}Variants" : "" %> }
