// <%= name %><%= gtk ? " — #{gtk}" : "" %>
//
// Generated by bin/11-generate-components from bin/04-components.out/components.json,
// which is what a running GTK said about this widget: the properties it takes, the CSS
// nodes it draws and the selector each of those is addressed by.

import * as React from "react"
import { mergeProps } from "@base-ui/react/merge-props"
import { useRender } from "@base-ui/react/use-render"

import { cn } from "@/lib/utils"
<% if draws_icon %>import { Icon } from "@/lib/icon"
<% end %>import { widget } from "@/lib/widget"
import type { WidgetProps } from "@/lib/widget-props"
<% unless enums.empty? %>import type { <%= enums.join(", ") %> } from "@/lib/enums"
<% end %>
export interface <%= name %>Props
  extends Omit<useRender.ComponentProps<"<%= element %>">, keyof WidgetProps<%= omitted %>>,
    WidgetProps {
<% props.each do |prop| %>  /** <%= prop[:comment] %> */
  <%= prop[:name] %>?: <%= prop[:type] %>

<% end %>}

function <%= name %>({ className, render, <%= destructured %>children, ...props }: <%= name %>Props) {
  const { hidden, className: widgetClassName, style, attributes: widgetAttributes, rest } = widget(props)

  // Named rather than passed inline: a fresh object literal handed straight to mergeProps
  // is excess-property checked against the element's props, which no data attribute of
  // ours is one of.
  const defaultProps = {
    "data-slot": "<%= slot %>",
    "data-node": "<%= node %>",
<% attributes.each do |attribute| %>    <%= attribute %>,
<% end %>    className: cn("<%= node %>"<%= written_classes %>, widgetClassName, className),
    style,
    children: (
      <>
<%= children %>
<% slots.each do |slot| %>        {<%= slot %>}
<% end %>        {children}
      </>
    ),
    ...widgetAttributes,
  }

  return useRender({
    defaultTagName: "<%= element %>",
    enabled: !hidden,
    render,
    props: mergeProps<"<%= element %>">(defaultProps, rest),
  })
}

export { <%= name %> }
