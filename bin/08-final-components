    "toolbar" => { summary: "A horizontal box given a toolbar's padding and spacing.", widgets: %w[Box], combines: %w[osd], shared: %w[HeaderBar ActionBar SearchBar] },

    # Spacers.
    "spacer" => { summary: "Makes a separator invisible, so it acts as whitespace.", widgets: %w[Separator] },

