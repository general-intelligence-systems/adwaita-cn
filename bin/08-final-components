    # Boxed lists and cards.
    "boxed-list" => { summary: "A boxed list. Set selection-mode to none.", widgets: %w[ListBox] },
    "boxed-list-separate" => { summary: "A boxed list whose rows are separate cards.", widgets: %w[ListBox] },
