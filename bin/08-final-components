    "title-3" => { summary: "The third of the four title levels.", widgets: :any, mostly: %w[Label] },
    "title-4" => { summary: "The smallest of the four title levels.", widgets: :any, mostly: %w[Label] },
    "heading" => { summary: "The standard style for a UI heading at the default text size.", widgets: :any, mostly: %w[Label] },
    "document" => { summary: "The document font, for the app's main content.", widgets: :any, mostly: %w[Label], combines: %w[body] },
    "body" => { summary: "Increased line height, for descriptions and dialog body text.", widgets: :any, mostly: %w[Label], combines: %w[document] },
    "caption-heading" => { summary: "Smaller text, for a heading accompanying body text.", widgets: :any, mostly: %w[Label] },
    "caption" => { summary: "Smaller text, for sub-text accompanying body text.", widgets: :any, mostly: %w[Label] },
