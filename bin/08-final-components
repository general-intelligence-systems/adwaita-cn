    "linked" => { summary: "Makes a box's children appear as a single group. The box must have no spacing.", widgets: %w[Box], contains: %w[Button MenuButton DropDown ColorDialogButton FontDialogButton TabButton Entry PasswordEntry SearchEntry SpinButton] },

