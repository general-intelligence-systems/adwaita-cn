#!/usr/bin/env ruby
# frozen_string_literal: true

# 08-FINAL-COMPONENTS(1)           General Commands Manual           08-FINAL-COMPONENTS(1)
#
# NAME
#      bin/08-final-components — the component list, joined from the passes before it
#
# SYNOPSIS
#      bin/08-final-components > bin/08-final-components.out/final-components.json
#
# DESCRIPTION
#      Loads the catalogue from bin/05-adwaita-components, the templates from
#      bin/06-component-trees, the introspection schemas from bin/07-gtk-schemas and the
#      selector map from bin/03-adwaita-tailwind, and joins them into one entry per
#      component: what it is, what it accepts, what it renders as, and what the stylesheet
#      draws it with.
#
#      IT DECIDES NOTHING ON ITS OWN. Which widgets exist, which CSS node each renders as
#      and which style classes it carries are read from the toolkit's source by
#      bin/05-adwaita-components. Properties, enumerations and parentage are read from the
#      introspection data by bin/07-gtk-schemas. The measurements are read from the
#      stylesheet by bin/03-adwaita-tailwind. This pass looks nothing up for itself.
#
#      A variant is a style class the stylesheet draws on a component's node, or one the
#      widget puts on itself. `.text-button` is the second kind: no application writes it
#      and no page documents it, and GtkButton adds it to every button holding a label.
#
# FILES
#      bin/05-adwaita-components.out/components.json         the catalogue, from 05
#      bin/06-component-trees.out/trees.json              the templates, from 06
#      bin/07-gtk-schemas.out/schemas.json                the schemas, from 07
#      bin/03-adwaita-tailwind.out/widgets.json            the selector map, from 03
#      bin/03-adwaita-tailwind.out/widgets-contexts.json   the same, keyed by context
#      bin/08-final-components.out/final-components.json   the output
#
# EXIT STATUS
#      The bin/08-final-components utility exits 0 on success, and >0 if an error occurs.
#
# SEE ALSO
#      bin/05-adwaita-components, bin/06-component-trees, bin/07-gtk-schemas
#
# adwaita-cn                         October 13, 2026                08-FINAL-COMPONENTS(1)

require "json"
require "set"

module FinalComponents
  ROOT = File.expand_path("..", __dir__)

  # Classes which show text, for reading a template's bindings.
  LABELS = %w[Label FadingLabel Inscription].freeze

  # Classes a shared helper applies rather than any one widget's file, keyed by the
  # property which decides them. gtk_widget_update_orientation in gtkwidget.c puts
  # `.horizontal` or `.vertical` on any widget implementing Gtk.Orientable, so no
  # widget's own source mentions them and the property is what says who carries them.
  BY_PROPERTY = { "orientation" => %w[horizontal vertical] }.freeze

  # The orientable widgets, by name, filled in as each one's props are read.
  #
  # gtk_widget_update_orientation puts `.horizontal` or `.vertical` on every one of
  # them, always, and the default is horizontal -- so a path built without it addresses
  # a widget no running application has. Every rule the stylesheet states through that
  # class was therefore unreachable: `progressbar.horizontal > trough` carries the only
  # statement of a progress bar's 8px height and 150px minimum width, and
  # `levelbar.horizontal trough > block` the only one of a level bar's block, so both
  # came out of the generator as nodes with a colour and no size at all. 83 rules
  # across 13 widgets were being dropped this way.
  def self.orientable = @orientable ||= Set.new

  # The class a node carries for its orientation, as a selector segment.
  #
  # Horizontal unless the template says otherwise, because that is the branch
  # gtk_widget_update_orientation takes for the property's own default.
  def self.orientation(klass, styles = [])
    return "" unless self.orientable.include?(klass)
    return "" if (styles & %w[horizontal vertical]).any?

    ".horizontal"
  end

  def self.run(_argv)
    catalogue = self.read("bin/05-adwaita-components.out/components.json")
    trees = self.read("bin/06-component-trees.out/trees.json")
    schemas = self.read("bin/07-gtk-schemas.out/schemas.json")
    widgets = self.read("bin/04-gtk-tailwind.out/gtk-widgets.json").merge(self.read("bin/03-adwaita-tailwind.out/widgets.json"))
    contexts = self.read("bin/04-gtk-tailwind.out/gtk-widgets-contexts.json")
      .merge(self.read("bin/03-adwaita-tailwind.out/widgets-contexts.json"))

    classes = schemas.fetch("classes")
    enums = schemas.fetch("enums")
    shared = self.own_props(classes.fetch("Widget"), {})
    source = catalogue.fetch("widgets")

    # `Button` in the schemas is `GtkButton` in the source: one is the name the
    # documentation uses and the other the name the C defines.
    qualified = classes.to_h{|name, schema| [name, schema.fetch("class").sub(".", "")] }

    self.read_templates(trees)

    # The CSS nodes which are widgets of their own, so that `node_tree` can tell what a
    # widget builds inside itself from what gets put into it: `list > row` is in the
    # stylesheet, but a row is a GtkListBoxRow an application adds, not a part a list box
    # comes with -- read as structure it gave every list box an empty 40px row above
    # whatever was actually in it.
    @widget_nodes = source.values.filter_map{|one| one["node"] }.to_set

    names = classes.keys | trees.fetch("referenced").keys | trees.fetch("trees").keys

    components = names.sort.to_h do |name|
      [name, self.entry(name, qualified[name], classes, source, shared, enums, widgets, contexts, trees)]
    end

    self.annotate_trees(components, contexts, widgets)

    buildable = components.reject do |_name, entry|
      %w[abstract behaviour private].include?(entry.fetch("kind"))
    end

    File.write(self.output("final-components.json"), "#{JSON.pretty_generate({
      "versions" => schemas.fetch("versions"),
      "counts" => components.group_by{|_name, entry| entry.fetch("kind") }.transform_values(&:size)
        .merge("variants" => components.values.sum{|entry| entry.fetch("variants").length }),
      "buildable" => buildable.keys.sort,
      "enums" => self.referenced(buildable, enums),
      "widget" => shared,
      "components" => components,
      "universal" => self.universal(contexts),
      "styles" => self.style_sheet(contexts),
      "variables" => self.read("bin/03-adwaita-tailwind.out/variables.json"),
    })}\n")
    warn("wrote bin/08-final-components.out/final-components.json")
  end

  def self.read(relative) = JSON.parse(File.read(File.join(ROOT, relative)))

  # One component, joined. Everything here is looked up; nothing is decided.
  def self.entry(name, qualified, classes, source, shared, enums, widgets, contexts, trees)
    schema = classes[name]
    own = self.source_for(name, qualified, source)
    props = schema.nil? ? {} : self.own_props(schema, shared)
    self.orientable << name if props.key?("orientation")
    node = own && own["node"]
    tree = self.tree_for(name, classes, trees)
    found = self.enums_of(props)

    structure = self.structure(name, node, tree, contexts, props)

    {
      "kind" => self.kind(name, schema, classes, structure["tree"]),
      "gtk" => schema&.fetch("class"),
      "parent" => schema && schema["parent"],
      "props" => props,
      "accepts" => schema.nil? ? {} : self.accepts(schema),
      "text" => self.text(name, props, source, qualified, classes, tree, trees),
      "enums" => found,
      "flags" => found.select{|one| enums.dig(one, "flags") },
      "node" => node,
      "nodes" => [node].compact,
      "source" => own && own["source"],
      # Which of the template's children this widget's own source hides, and under what.
      # Merged up the ancestry because the template is: an AdwSpinRow is built from
      # adw-action-row.ui and hides what AdwActionRow hides.
      "hides" => self.hides(name, classes, source, qualified),
      "layout" => own && own["layout"],
      "direction" => own && own["direction"],
      "classes" => node ? self.lookup(self.ambient(name, node) + ["#{node}#{self.orientation(name)}"], contexts, widgets) : {},
      "variants" => self.variants(name, node, own, source, classes, contexts, props),
    }.merge(structure)
  end

  # The widgets which build their insides in C, where the stylesheet does not spell the
  # structure out either.
  #
  # A .ui is read by bin/06 and a chain of bare CSS nodes by `node_tree` below, and
  # AdwHeaderBar is neither: it builds a GtkCenterBox holding three gizmos in its init,
  # and the selectors which style them -- `headerbar > windowhandle > box > box.start` --
  # name a style class, so they are read as a variant rather than as a node. The header
  # bar therefore had nowhere to put the title it was given and rendered it over the top
  # of its own buttons.
  #
  # `takes` is which of the widget's properties goes in that node, with `children` for
  # whatever the application packs into it.
  # The containers a template keeps for a caller, as the property each one is.
  #
  # adw-action-row.ui builds `prefixes` and `suffixes` hidden and the row shows whichever
  # is filled; `adw_action_row_add_prefix` puts a widget in the first. Without a prop for
  # it an application had nowhere to put the avatar the toolkit's side puts in the
  # prefixes box, and it went in the suffixes instead -- the same row with its face on
  # the wrong end.
  TEMPLATE_TAKES = { "prefixes" => "prefix", "suffixes" => "children" }.freeze

  CONSTRUCTED = {
    # The content, then the revealer which holds the top bars, then the one which holds
    # the bottom bars -- in that order, because that is the order AdwToolbarView parents
    # them in and both sides of the comparison are walked in order. Where they go on the
    # screen is the `order` in `utility`.
    "ToolbarView" => {
      "class" => "ToolbarView",
      "children" => [
        {
          "class" => "Widget", "id" => "content", "takes" => "content",
          "utility" => "order-2 flex flex-col [&>*]:grow min-h-0",
          "properties" => { "vexpand" => "True" },
        },
        {
          "class" => "Revealer", "node" => "revealer", "styles" => ["top-bar"],
          "utility" => "order-1",
          "children" => [{
            "class" => "Windowhandle", "node" => "windowhandle",
            "children" => [{
              "class" => "InternalBox", "slot" => "box", "node" => "box", "layout" => "box",
              "properties" => { "orientation" => "vertical" }, "takes" => "children",
            }],
          }],
        },
        {
          "class" => "Revealer", "node" => "revealer", "styles" => ["bottom-bar"],
          "utility" => "order-3",
          "children" => [{
            "class" => "Windowhandle", "node" => "windowhandle",
            "children" => [{
              "class" => "InternalBox", "slot" => "box", "node" => "box", "layout" => "box",
              "properties" => { "orientation" => "vertical" },
            }],
          }],
        },
      ],
    },
    # `spinbutton > text` and `spinbutton > button.image-button.down` are in the
    # stylesheet, but the second names a style class, so `node_tree` reads it as a
    # variant of a button rather than as a button the widget builds. A spin button with
    # no buttons in it is a text entry.
    "SpinButton" => {
      "class" => "SpinButton",
      "children" => [
        { "class" => "Text", "node" => "text", "properties" => { "hexpand" => "True" } },
        # The icon is the widget's own C and not the stylesheet: gtk_spin_button_init
        # builds an image for each button and names it, so a tree without one drew two
        # empty boxes where the toolkit draws a minus and a plus.
        {
          "class" => "SpinDown", "slot" => "button", "node" => "button",
          "styles" => %w[image-button down], "layout" => "bin",
          "children" => [{ "class" => "Image", "node" => "image", "icon" => "value-decrease-symbolic" }],
        },
        {
          "class" => "SpinUp", "slot" => "button", "node" => "button",
          "styles" => %w[image-button up], "layout" => "bin",
          "children" => [{ "class" => "Image", "node" => "image", "icon" => "value-increase-symbolic" }],
        },
      ],
    },
    "HeaderBar" => {
      "class" => "HeaderBar",
      "children" => [{
        "class" => "Windowhandle", "node" => "windowhandle",
        "children" => [{
          "class" => "Box", "node" => "box", "layout" => "center",
          "children" => [
            {
              "class" => "Widget", "node" => "widget", "id" => "start",
              "children" => [{
                "class" => "Box", "node" => "box", "styles" => ["start"], "layout" => "box",
                "properties" => { "orientation" => "horizontal", "spacing" => "6" },
                "children" => [
                  {
                    "class" => "WindowControls", "node" => "windowcontrols",
                    "styles" => %w[start empty], "layout" => "box",
                  },
                ],
                "takes" => "children",
              }],
            },
            { "class" => "Widget", "node" => "widget", "id" => "title", "takes" => "titleWidget" },
            {
              "class" => "Widget", "node" => "widget", "id" => "end",
              "children" => [{
                "class" => "Box", "node" => "box", "styles" => ["end"], "layout" => "box",
                "properties" => { "orientation" => "horizontal", "spacing" => "6" },
                "children" => [{
                  "class" => "WindowControls", "node" => "windowcontrols", "styles" => ["end"],
                  "layout" => "box",
                  "children" => [{
                    # A real GtkButton, which is why it keeps the slot a button has: the
                    # toolkit reports the close button of every window it draws, and a
                    # header bar which did not have one paired its neighbour's buttons
                    # with the wrong ones all the way down the shot.
                    "class" => "CloseButton", "slot" => "button", "node" => "button",
                    "styles" => %w[close image-button], "layout" => "bin",
                    # gtk_window_controls sets the icon in C, the way the spin button
                    # does: without it every window in the registry had a grey disc
                    # where the toolkit draws a cross.
                    "children" => [{ "class" => "Image", "node" => "image", "icon" => "window-close-symbolic" }],
                  }],
                }],
              }],
            },
          ],
        }],
      }],
    },
  }.freeze

  # The props a template's own slots are, beside the properties the class declares.
  def self.with_slot_props(entry)
    return entry unless entry["tree"]

    taken = []
    self.each_node(entry.fetch("tree")){|one| taken << one["takes"] if one["takes"] }

    (taken.uniq - ["children"]).each do |prop|
      next if entry.fetch("props").key?(prop)

      entry.fetch("props")[prop] =
        { "type" => "node", "gir" => "Gtk.Widget", "from" => entry["gtk"] || "the template" }
    end

    entry
  end

  # A component's structure: its template where it has one, the structure written down
  # for it where its source builds one in C, and the nodes the stylesheet shows it
  # building where it does neither.
  def self.structure(name, node, tree, contexts, props)
    return { "template" => tree.fetch("template"), "tree" => tree.fetch("tree") } if tree
    return { "tree" => Marshal.load(Marshal.dump(CONSTRUCTED.fetch(name))) } if CONSTRUCTED.key?(name)

    self.node_tree(name, node, contexts, props).then{|found| found ? { "tree" => found } : {} }
  end

  # The template a component is built from. A subclass with none of its own is built
  # from its parent's: AdwSwitchRow ships no .ui and is an AdwActionRow with a switch in
  # its suffixes, so without this it renders its title and subtitle loose.
  def self.tree_for(name, classes, trees)
    found = self.ancestry(name, classes).filter_map{|one| trees.fetch("trees")[one] }

    return nil if found.empty?

    # A subclass's .ui adds to its parent's rather than replacing it. adw-spin-row.ui is
    # `<template class="AdwSpinRow" parent="AdwActionRow">` with one `<child
    # type="suffix">` in it, and taking that as the whole of what an AdwSpinRow builds
    # left the row with a spin button and no title, no subtitle and none of the header
    # box's 50px of height. What a subclass declares goes where the parent puts a child,
    # which for a row is its suffixes box.
    found.reverse.reduce do |into, one|
      added = (one.fetch("tree").fetch("slots", {}).values + one.fetch("tree").fetch("children", []))

      next into if added.empty?

      merged = Marshal.load(Marshal.dump(into))
      slot = self.slot_of(merged.fetch("tree"))
      slot["children"] = slot.fetch("children", []) + Marshal.load(Marshal.dump(added))
      merged.merge("template" => one.fetch("template"))
    end
  end

  # The containers a template keeps for whatever is put into it.
  SLOTS = %w[
    Bin Box Clamp ClampScrollable FlowBox Gizmo Grid ListBox Overlay Revealer
    ScrolledWindow Stack ToolbarView WrapBox
  ].to_set

  # Where a template's own children go: the last container it leaves empty, which is the
  # one it kept for them.
  def self.slot_of(node)
    found = []
    self.each_node(node) do |one|
      children = (one.fetch("slots", {}).values + one.fetch("children", []))

      found << one if SLOTS.include?(one.fetch("class")) && children.empty? && !one.equal?(node)

    end

    found.last || node
  end

  def self.hides(name, classes, source, qualified)
    self.ancestry(name, classes).reverse.each_with_object({}) do |one, found|
      entry = self.source_for(one, one == name ? qualified : classes.dig(one, "class")&.sub(".", ""), source)

      found.merge!(entry["hides"]) if entry && entry["hides"]
    end
  end

  def self.source_for(name, qualified, source)
    source[qualified] || source["Adw#{name}"] || source["Gtk#{name}"]
  end

  # Gtk.Widget is the one every component inherits from and nothing renders; a class the
  # introspection data does not carry is the library's own business; the rest is a widget
  # when it descends from Widget, and a plain object when it does not.
  def self.kind(name, schema, classes, tree)
    if name == "Widget"
      "abstract"
    elsif tree
      # libadwaita ships a template for it, so it is something it builds, whether or not
      # the introspection data carries a class anyone can instantiate: AdwTab and
      # AdwToastWidget are built from .ui files and exported by neither.
      "composite"
    elsif schema.nil?
      "private"
    elsif self.ancestry(name, classes).include?("Widget")
      "widget"
    else
      "behaviour"
    end
  end

  def self.ancestry(name, classes)
    [].tap do |found|
      current = name

      while current && classes.key?(current) && !found.include?(current)
        found << current
        current = classes.fetch(current)["parent"]
      end
    end
  end

  # The style classes a component can carry: the ones the stylesheet draws on its node,
  # and the ones the widget or an ancestor puts on itself.
  def self.variants(name, node, own, source, classes, contexts, props = {})
    return {} if node.nil?

    by_property = BY_PROPERTY.filter_map{|prop, styles| styles if props.key?(prop) }.flatten

    applied = self.ancestry(name, classes).flat_map do |ancestor|
      entry = self.source_for(ancestor, classes.dig(ancestor, "class")&.sub(".", ""), source)

      entry ? entry.fetch("applies", []) : []
    end.uniq

    # A rule naming no element -- `.card`, `.dim-label` -- can go on any widget, so it is
    # not a variant of a particular one; those are listed once under `universal`. What is
    # a variant here is what the stylesheet names on this node, what the widget puts on
    # itself, and what a template puts on a widget of this class.
    candidates = self.styled_on(node, contexts) | applied | by_property |
      self.templated.fetch(name, [])

    candidates.uniq.sort.to_h do |style|
      rules = self.variant_classes(style, name, node, contexts)
      merged = self.merged(rules.values)

      [style, {
        "classes" => merged,
        "context" => rules.keys.reject{|selector| self.segments(selector).length == 1 }.sort,
        "colour" => merged.values.all?(&:empty?),
        "applied" => applied.include?(style) || by_property.include?(style),
        "universal" => self.unscoped(contexts).include?(style),
      }]
    end
  end

  # The classes libadwaita's own templates put on a widget of each class: a .ui saying
  # `<style><class name="card"/></style>` on a box is the toolkit stating that a box
  # carries `.card`.
  def self.templated = @templated ||= {}

  def self.read_templates(trees)
    @templated = Hash.new{|found, key| found[key] = [] }

    trees.fetch("trees").each_value do |entry|
      self.each_node(entry.fetch("tree")) do |node|
        @templated[node.fetch("class")] |= node.fetch("styles", [])
      end
    end
  end

  # Every class the stylesheet draws on this node, from a selector whose subject is it.
  def self.styled_on(node, contexts)
    contexts.keys.filter_map do |selector|
      element, styles = self.segment(self.segments(selector).last.to_a.last.to_s)

      styles.to_a.first if styles.length == 1 && element == node
    end.uniq
  end

  # The rules which style a node carrying this class, taken at the shallowest context the
  # stylesheet states them in: `.flat` on a headerbar is not `.flat` on a button, and
  # merging every `.flat` rule gives a flat HeaderBar a button's padding.
  # The rules which style this node when it carries this one style class.
  #
  # Matched against the path the node actually sits at, not merely by the class being
  # somewhere in the selector. Taking the shallowest rules naming the class instead gave
  # GtkBox's `vertical` the declarations of
  # `window.filechooser headerbar box.start + box.vertical`, so every vertical box in
  # every application came out with -6px of margin and a 12px minimum height.
  def self.variant_classes(style, name, node, contexts)
    path = self.ambient(name, node) + ["#{node}.#{style}"]

    own = contexts.select do |selector, _states|
      segments = self.addressing(selector)
      _combinator, last = segments.last
      element, styles = self.segment(last.to_s)

      styles.to_a == [style] && (element.nil? || element == node) && self.matches?(segments, path)
    end

    own.sort_by{|selector, _states| self.specificity(selector) }.to_h
  end

  # The classes the stylesheet states without naming an element.
  def self.unscoped(contexts)
    @unscoped ||= contexts.keys.filter_map do |selector|
      element, styles = self.segment(selector)

      styles.to_a.first if element.nil? && styles.length == 1 && self.segments(selector).length == 1
    end.uniq
  end

  # Every rule whose selector starts with a style class that names no element.
  #
  # `.navigation-sidebar`, `.card`, `.heading`: GTK applies these to whichever widget is
  # given them, so they are not a variant of one component -- they are classes, and the
  # rules they scope reach the widgets inside as well, which is why the whole selector is
  # kept rather than only what it says about the class itself. bin/11 writes them out as
  # a stylesheet, so a caller naming one gets what the toolkit gives it.
  def self.style_sheet(contexts)
    {}.tap do |found|
      contexts.each do |selector, states|
        segments = self.segments(selector)

        # A rule about one node on its own is the component's own business and is already
        # in its class list. What goes in the sheet is everything which says where the
        # node has to be: `list.boxed-list > row`, `.navigation-sidebar > row`. A
        # component cannot carry those, because the same AdwActionRow is a card in a
        # preferences group and a flat line in a sidebar, and which one it is depends on
        # what it was put in -- which is the cascade's question, not the component's.
        element, styles = self.segment(segments.first.to_a.last.to_s)

        # A rule about one node on its own is already in that component's class list. A
        # rule about one *class* on its own belongs to no component -- `.navigation-sidebar`
        # goes on whichever widget an application puts it on -- so it is a class here.
        next if segments.length < 2 && !(element.nil? && !styles.empty?)

        (found[selector] = states)
      end
    end
  end

  # The classes which go on any widget at all, which are the rules naming no element.
  def self.universal(contexts)
    self.unscoped(contexts).sort.to_h do |style|
      rules = self.variant_classes(style, nil, nil, contexts)
      merged = self.merged(rules.values)

      [style, {
        "classes" => merged,
        "context" => [],
        "colour" => merged.values.all?(&:empty?),
        "applied" => false,
        "universal" => true,
      }]
    end
  end

  # The props a component shows as text. bin/05 reads the setters which put a property
  # into a label; a template binds the rest, which is where AdwAboutDialog's `version`
  # comes from.
  def self.text(name, props, source, qualified, classes, tree, trees = nil)
    from_source = self.ancestry(name, classes).flat_map do |ancestor|
      entry = self.source_for(
        ancestor,
        ancestor == name ? qualified : classes.dig(ancestor, "class")&.sub(".", ""),
        source,
      )

      entry ? entry.fetch("showsText", []) : []
    end

    # Text is a string by definition: a template node whose id happens to match a boolean
    # property is not the component showing that property as text.
    # A template an ancestor ships shows this component's properties too, because the
    # component is built from it: `title` is AdwPreferencesRow's and AdwActionRow's
    # template is what puts it on screen.
    inherited = trees.nil? ? [] : self.ancestry(name, classes).flat_map do |ancestor|
      self.bound(trees.fetch("trees")[ancestor])
    end

    (from_source | self.bound(tree) | inherited)
      .select{|prop| props.dig(prop, "type") == "string" }
      .sort
  end

  # The props a template binds to something which shows text.
  def self.bound(tree)
    return [] if tree.nil?

    [].tap do |found|
      self.each_node(tree.fetch("tree")) do |node|
        next unless LABELS.include?(node.fetch("class"))

        node.fetch("properties", {}).each do |property, value|
          found << self.camel(value.fetch("bind")) if value.is_a?(Hash) && %w[label text].include?(property)
        end

        found << self.camel(node["id"]) if node["id"]
      end
    end.uniq
  end

  def self.camel(name)
    parts = name.to_s.split("-")

    parts.first.to_s + parts.drop(1).map(&:capitalize).join
  end

  def self.enums_of(props)
    props.values
      .select{|attributes| attributes.fetch("type") == "enum" }
      .map{|attributes| attributes.fetch("enum") }
      .uniq
      .sort
  end

  # Every prop a component accepts, inherited ones included, keyed under both spellings.
  # This is what a lint tests an attribute against, and it is a different question from
  # what the component declares: `<ActionRow visible>` is correct and `visible` is
  # GtkWidget's.
  def self.accepts(schema)
    {}.tap do |found|
      schema.fetch("properties").each do |gtk, attributes|
        rule = attributes.slice("type", "writable", "from", "values", "enum")

        found[gtk] = rule
        found[attributes.fetch("prop")] = rule
      end
    end
  end

  # A class's own writable props: the canonical key, minus anything Gtk.Widget already
  # gives every component.
  def self.own_props(schema, shared)
    {}.tap do |found|
      schema.fetch("properties").each do |key, attributes|
        next unless attributes.fetch("writable")
        next if shared.key?(attributes.fetch("prop"))
        next unless key.include?("-") || key == attributes.fetch("prop")

        found[attributes.fetch("prop")] = attributes
      end
    end
  end

  # Every enumeration a buildable component's props draw from, taken from `accepts`.
  def self.referenced(buildable, enums)
    found = buildable.values.flat_map do |entry|
      entry.fetch("accepts").values.filter_map{|rule| rule["enum"] }
    end

    enums.slice(*found.uniq.sort)
  end

  # What a node is styled with on its own.
  def self.classes_for(nodes, widgets, contexts)
    nodes.to_a.each_with_object({}) do |node, found|
      own = widgets.fetch(node, nil) || self.addressed(node, contexts)

      own.each{|state, list| found[state] = found.fetch(state, []) | list }
    end
  end

  # The rules which address a node and nothing else about it: one segment, no classes.
  def self.addressed(node, contexts)
    own = contexts.select do |selector, _states|
      segments = self.segments(selector)
      element, styles = self.segment(segments.first.to_a.last.to_s)

      segments.length == 1 && element == node && styles.empty?
    end

    self.merged(own.values)
  end

  def self.merged(states)
    states.each_with_object({}) do |one, found|
      one.each{|state, list| found[state] = found.fetch(state, []) | list }
    end
  end

  # A selector, as the segments it names and the combinator before each of them: `>` for a
  # child and a space for a descendant.
  def self.segments(selector)
    selector.scan(/(>|^|\s)\s*([^\s>]+)/).map{|before, one| [before.strip == ">" ? :child : :descendant, one] }
      .reject{|_combinator, one| one.empty? }
  end

  # Whether the rule addresses the node at the end of this path.
  #
  # The last segment has to be the node itself; a `>` before a segment means the one
  # before it in the path, and a space means anywhere above it. Reading every combinator
  # as `>` lost `preferencesgroup > box box.labels`, which is the 6px between a group's
  # title and its description -- and with it 6px of every preferences group's height.
  def self.matches?(segments, path)
    return false if segments.empty? || path.empty?

    combinator, last = segments.last

    return false unless self.addresses?(last, path.last)
    return combinator != :child || path.length > 1 if segments.length == 1

    self.above?(segments[0..-2], path[0..-2])
  end

  def self.above?(segments, path)
    return true if segments.empty?

    combinator, one = segments.last

    if combinator == :child
      return false if path.empty? || !self.addresses?(one, path.last)

      self.above?(segments[0..-2], path[0..-2])
    else
      path.length.downto(1).any? do |index|
        self.addresses?(one, path[index - 1]) && self.above?(segments[0..-2], path[0...(index - 1)])
      end
    end
  end

  # The CSS nodes GTK builds that nothing declares, so nothing a template or a node tree
  # knows about addresses them.
  #
  # A GtkScrolledWindow puts a viewport between itself and its child when the child does
  # not scroll of its own accord, and the stylesheet says
  # `preferencespage > scrolledwindow > viewport > clamp > box`. The template says
  # scrolled window, clamp, box: without dropping the viewport the rule matched nothing,
  # the box lost its `margin: 24px 12px`, and every preferences page was 24px wider than
  # the toolkit's with its groups 12px to the left of them.
  # NOT `widget`. A gizmo renders as `widget` and the trees now carry those nodes, so
  # stripping the segment put `banner > revealer > widget` on the revealer and the banner
  # drew its background one node too high.
  IMPLICIT = %w[viewport contents].to_set

  # A selector's segments, with the nodes neither side writes down taken out.
  def self.addressing(selector)
    self.segments(selector).reject do |_combinator, one|
      element, styles = self.segment(one)

      IMPLICIT.include?(element) && styles.empty?
    end
  end

  # How specific a selector is, as CSS counts it: how much of the path it names, and then
  # how many style classes it asks for. `list` and `.boxed-list` both name one segment, so
  # without the second term the order between them was whichever the sheet happened to
  # reach first -- and a boxed list came out with the plain list's flat background over
  # the card it is supposed to be.
  def self.specificity(selector)
    segments = self.addressing(selector)

    [segments.length, segments.sum{|_combinator, one| one.scan(/\.[a-z0-9-]+/).length }]
  end

  # A selector segment, split into the element it names and the classes on it. A rule may
  # name no element at all -- `.prefixes` rather than `box.prefixes` -- which matches any.
  def self.segment(text)
    [text[/\A[a-z][a-z0-9-]*/], text.scan(/\.([a-z0-9-]+)/).flatten.to_set]
  end

  # Whether a rule's segment addresses a node: the element has to agree where the rule
  # names one, and every class the rule asks for has to be on the node.
  def self.addresses?(rule, node)
    element, styles = self.segment(rule)
    node_element, node_styles = self.segment(node)

    (element.nil? || element == node_element) && styles.subset?(node_styles)
  end

  # A node's CSS path, which is how the stylesheet addresses it.
  #
  # The fallback is `widget` and not the class's own name in lower case. A CSS name is
  # inherited: a widget which sets none renders as whatever its parent class does, and at
  # the root of that chain GtkWidget is `widget`. AdwGizmo sets none, so libadwaita's
  # stylesheet says `banner > revealer > widget` -- and a path built out of the class name
  # said `gizmo`, which addresses nothing, so the banner lost its background, the header
  # bar's bins lost their margins and an entry row's editable area lost its padding.
  #
  # A template can also name the node itself, which is what AdwGizmo's `css-name`
  # construct property is for.
  def self.selector(node, name = nil)
    own = node.fetch("styles", [])
    styles = own.map{|style| ".#{style}" }.join
    klass = node.fetch("class")
    named = node.fetch("properties", {})["css-name"]

    # The orientation class GTK always draws, which the template never writes down.
    # `.vertical` where the template asks for it, and `.horizontal` otherwise.
    stated = node.fetch("properties", {})["orientation"]
    orientation =
      if (own & %w[horizontal vertical]).any? || !self.orientable.include?(klass)
        ""
      elsif stated == "vertical" || stated == "1"
        ".vertical"
      else
        ".horizontal"
      end

    "#{name || (named.is_a?(String) ? named : nil) || node["node"] || self.nodes[klass] || 'widget'}#{styles}#{orientation}"
  end

  # The nodes a widget builds inside itself, as a tree, read from the selectors which
  # style them.
  #
  # A widget's structure is a .ui template or it is CSS nodes built in C, and only the
  # first was being read. GtkProgressBar is `progressbar > trough > progress`, so a
  # component with nothing inside it has no trough to be 8px high and no progress to
  # fill: it measured 0x0 and drew nothing. The same was true of the switch, which is a
  # slider in a box, of the level bar, and of the scale.
  #
  # EVERY direct-child chain the stylesheet writes, whatever classes it puts on the way.
  #
  # Reading only chains of bare node names was the assumption that a style class on a
  # segment means that node in a state rather than another node, and for most of GTK's
  # controls it is the wrong one: the only description of what a spin button builds is
  # `spinbutton > button.image-button.up`, of what a level bar builds is
  # `levelbar > trough > block.full`, of what a check button builds is
  # `checkbutton > check`. Dropping the classed segments left those widgets with nothing
  # inside them at all, which is a scale with no trough, a switch with no slider, a
  # progress bar with no progress and a drop down with no button -- every control in the
  # comparison was a flat grey bar.
  #
  # The classes are not read as structure, only the element names are: `progress.bottom`
  # is the same progress node as `progress`, and which of them a particular widget is
  # showing is a variant, which `annotate` reads separately. A node the stylesheet only
  # ever names with a class is still a node.
  def self.node_tree(name, node, contexts, props = {})
    return nil if node.nil?

    paths = contexts.keys.filter_map do |selector|
      segments = self.segments(selector)

      # A chain rooted at this widget's own node. The combinator is not the test: GTK's
      # own stylesheet writes `checkbutton.selection-mode check` with a descendant
      # combinator for a node which is a direct child, so requiring `>` left the check
      # button with no check in it. What keeps the chain honest is that it starts at this
      # widget and that `structural` stops it where the widget stops.
      next if segments.length < 2

      elements = segments.map{|_combinator, one| one[/\A[a-z][a-z0-9-]*/] }

      next if elements.any?(&:nil?) || elements.first != node

      elements.drop(1)
    end

    paths = paths.map{|path| self.structural(node, path, props) }.reject(&:empty?).uniq

    return nil if paths.empty?

    self.exclusive({ "class" => name, "children" => [] }.tap do |root|
      paths.sort_by(&:length).each do |path|
        path.reduce(root) do |cursor, one|
          cursor["children"].find{|child| child["node"] == one } ||
            # `css` marks a node read out of a selector rather than out of a template.
            # The name is capitalised to stand in for a class, and some of those names
            # are a real widget's: `progressbar > text` became a node of class `Text`,
            # the generator renders a Gtk.Text as an `<input>`, and a progress bar was
            # drawn with a text field in it 13px tall above its trough. A CSS node is a
            # box the widget paints, not a widget, and nothing should look it up as one.
            { "class" => self.pascal(one), "node" => one, "css-node" => true, "children" => [] }
              .tap{|child| cursor.fetch("children") << child }
        end
      end
    end)
  end

  # The CSS nodes a widget builds exactly one of, where the stylesheet names several.
  #
  # A selector chain is a statement about a node which may exist, and the union of every
  # chain rooted at a widget is not its structure -- it is every structure the widget can
  # have at once. gtkcheckbutton.c builds ONE indicator and names it `check` or `radio`
  # depending on whether the button is in a group, and the two rules read as two nodes:
  # every check button in the registry was drawn with a box AND a circle beside its
  # label. The same is true of a menu item, which is an arrow or a check or a radio or an
  # accelerator and never more than one of them.
  #
  # The first of a set which the widget actually has is the one it keeps, and the rest are
  # dropped. Which of them a particular widget is at a particular moment is a style class
  # on it, which the variants already carry.
  EXCLUSIVE = [
    %w[check radio],
    %w[arrow check radio accelerator],
  ].freeze

  # The widgets which build one of a node per thing they are given, keyed by their own
  # node and naming the node they repeat.
  #
  # A node a widget builds ONCE is a part of it; a node it builds one of PER ITEM is the
  # shape of whatever is put in. AdwToggleGroup builds a `toggle` for every AdwToggle it
  # is handed, and reading that as structure gave the group a single toggle part with the
  # caller's buttons nested inside it -- three buttons in one toggle, inside a
  # buttoncontent, inside a box -- rather than three toggles side by side. The rules for
  # the node belong on the parent, as the shape it gives its children, so that they reach
  # whatever the caller actually put there.
  ITEMS = { "toggle-group" => "toggle" }.freeze

  # A node's rules restated as the shape the parent gives each of its children.
  #
  # `[&>*]:` and not a selector on the node itself: the registry has no component whose
  # node is `toggle` -- AdwToggle is a GObject rather than a widget, so there is nothing
  # for one to be generated from -- and what a caller puts in a group is a button. The
  # group is the only thing which knows its children are toggles, so it is the thing
  # which says so.
  def self.for_children(classes)
    base = classes.fetch("base", [])
    states = classes.reject{|state, _| state == "base" }
      .flat_map{|state, list| list.map{|one| "#{state}:#{one}" } }

    (base + states).map{|one| "[&>*]:#{one}" }
  end

  # The item node folded off a component's tree and onto the component itself.
  def self.fold_items(entry)
    repeated = ITEMS[entry["node"]]
    tree = entry["tree"]

    return if repeated.nil? || tree.nil?

    found = tree.fetch("children", []).find{|child| child["node"] == repeated }

    return if found.nil?

    tree["children"] = tree.fetch("children", []) - [found]
    classes = (entry["classes"] ||= {})
    classes["base"] = classes.fetch("base", []) + self.for_children(found.fetch("classes", {}))
    # What the component holds is now the caller's items rather than the folded node, so
    # the generator must not read the tree it is left with as a wrapper around one thing.
    entry["items"] = repeated
  end

  # Siblings cut down to the one node of each exclusive set the widget really builds.
  def self.exclusive(node)
    children = node.fetch("children", [])

    EXCLUSIVE.each do |set|
      found = children.select{|child| set.include?(child["node"]) }

      next if found.length < 2

      children -= found.drop(1)
    end

    node["children"] = children
    children.each{|child| self.exclusive(child) }

    node
  end

  def self.pascal(node) = node.split(/[-_]/).map{|part| part.capitalize }.join

  def self.widget_nodes = @widget_nodes ||= Set.new

  # The CSS nodes of the widgets whose children are put into them rather than built by
  # them. A GtkListBox's rows are what an application adds; a GtkSpinButton's buttons are
  # not, and a spin button with no buttons is a text entry.
  CONTENT_NODES = %w[
    list listview flowbox box grid stack overlay revealer scrolledwindow viewport clamp
    toolbarview wrapbox popover contents
  ].to_set

  # The properties a widget puts whatever it is given into, which is what makes its CSS
  # children content rather than structure.
  HOLDS = %w[child content sidebar].freeze

  # A path cut short where it stops being the widget's own structure.
  #
  # The stylesheet says `button > label` and `spinbutton > button` in the same voice, and
  # one of those is a widget GTK builds while the other is whatever the caller put in. The
  # test is whether the node could hold something: a container holds what is added to it,
  # and so does a widget with a `child` or a `content` property. A GtkSpinButton has
  # neither, so its buttons are its own; a GtkButton has `child`, so its label is not.
  def self.structural(root, path, props = {})
    holds = CONTENT_NODES.include?(root) || HOLDS.any?{|prop| props.key?(prop) }

    [].tap do |found|
      parent = root

      path.each do |one|
        break if holds && self.widget_nodes.include?(one)

        found << one
        parent = one
        holds = CONTENT_NODES.include?(parent)
      end
    end
  end

  # The trees are annotated once the nodes are known, because a tree's root is addressed
  # by the component's CSS node rather than by its class name.
  def self.annotate_trees(components, contexts, widgets)
    # How each class arranges its children, so that a template's boxes carry it too: a
    # composite is built out of other widgets, and a box inside a template is as much a
    # box as one a caller makes.
    @layouts = components.transform_values{|entry| entry["layout"] }.compact

    # The CSS node each class renders as. A template names classes and the stylesheet
    # names nodes, and the two are not the same word: GtkListBox is `list`, and a path
    # built from the class name addresses nothing, so `.boxed-list` never reaches it.
    @nodes = components.transform_values{|entry| entry["node"] }.compact

    # A template's children are widgets, and a widget has structure of its own: a spin
    # row's template holds a GtkSpinButton, and a spin button is a text node with a button
    # either side of it. Without this a composite rendered its parts as empty boxes -- a
    # spin row with no value and no buttons, a combo row with a white rectangle where its
    # list should be -- because the structure stopped at the template's own leaves.
    components.each_value do |entry|
      next unless entry["tree"]

      self.expand(entry.fetch("tree"), components, Set.new)
    end

    components.each_pair do |name, entry|
      next unless entry.key?("tree")

      root = entry["node"] || entry.fetch("nodes", []).first
      entry["tree"] =
        self.annotate(entry.fetch("tree"), self.ambient(name, root), contexts, widgets, root,
                      entry["classes"], entry.fetch("hides", {}))
      self.with_slot_props(entry)
      # After the tree is annotated, so the node carries the classes being folded.
      self.fold_items(entry)
    end
  end

  # A template node which is a widget with structure of its own, filled in with it.
  #
  # `seen` is the classes already being expanded, so that a widget which builds one of
  # itself -- an expander row holds rows -- does not expand for ever.
  def self.expand(node, components, seen)
    children = node.fetch("slots", {}).values + node.fetch("children", [])

    children.each{|child| self.expand(child, components, seen) }

    klass = node["class"]
    found = klass && components.dig(klass, "tree")

    # `.empty` is the toolkit saying the node has nothing in it: gtk_window_controls
    # draws that class on the side of the titlebar which carries no controls, and
    # filling it from the widget's own structure put a button with a blank image at the
    # start of every header bar in the registry -- a grey disc the toolkit does not
    # draw, beside the back button, in every application.
    return if node.fetch("styles", []).include?("empty")
    return if found.nil? || seen.include?(klass) || children.any?

    seen = seen + [klass]
    own = (found.fetch("slots", {}).values + found.fetch("children", []))
      .map{|child| Marshal.load(Marshal.dump(child)) }

    own.each{|child| self.expand(child, components, seen) }

    node["children"] = own unless own.empty?
  end

  # What a component sits inside once it is in an application, as the selector for it.
  #
  # The stylesheet addresses a widget through the window it is in and not only by itself:
  # `headerbar` is 47px tall on its own and
  # `window:not(.ssd-frame) > .titlebar headerbar` makes it 46 with 6px under its box
  # rather than 7, and that second rule is the one every header bar in every application
  # is actually drawn by. A path which started at the component matched the first and
  # never the second, so every header bar was a pixel too tall and sat a pixel low.
  #
  # Every component is in a window. Only a header bar is a window's titlebar, which is
  # why that segment is not given to the rest: `.titlebar` scopes rules which have
  # nothing to say about a button in a list.
  AMBIENT = { "HeaderBar" => %w[window.background.csd .titlebar] }.freeze
  AMBIENT_DEFAULT = %w[window.background.csd].freeze

  def self.ambient(name, node = nil)
    AMBIENT.fetch(name, AMBIENT_DEFAULT)
  end

  def self.layouts = @layouts ||= {}
  def self.nodes = @nodes ||= {}

  # Every node in a tree, with the path it sits at and the classes that path is styled
  # with.
  def self.annotate(node, ancestors, contexts, widgets, name = nil, own = nil, hides = {})
    node["takes"] ||= TEMPLATE_TAKES[node["id"]] if node["id"]

    # What the widget's C says about whether this child is on screen, where the template
    # itself does not say. A `.ui` says `visible="False"` or binds the property; the rest
    # of the time the answer is in the source, and without it a template child which GTK
    # keeps hidden until something happens was drawn in every one of these components.
    if node["id"] && hides.key?(node["id"]) && !node.dig("properties", "visible")
      (node["properties"] ||= {})["visible"] = { "when" => hides.fetch(node["id"]) }
    end

    path = ancestors + [self.selector(node, name)]
    classes = own || self.lookup(path, contexts, widgets)

    node.merge(
      "css" => path.join(" > "),
      # The CSS node this part renders as, so the sheet of contextual rules can address
      # it: a template names GtkListBox and the stylesheet names `list`.
      "node" => node["node"] || self.nodes[node.fetch("class")],
      "classes" => classes,
      "layout" => node["layout"] || self.layouts[node.fetch("class")],
      "children" => node.fetch("children", []).map{|child| self.annotate(child, path, contexts, widgets, nil, nil, hides) },
      "slots" => node.fetch("slots", {}).transform_values{|slot| self.annotate(slot, path, contexts, widgets, nil, nil, hides) },
    ).reject{|_key, value| value.respond_to?(:empty?) && value.empty? }
  end

  # The rules which address this path: every one whose segments are a suffix of it,
  # matching loosely so that a rule naming no element still applies.
  #
  # ALL of them, least specific first, rather than the longest alone. A row in a boxed
  # list is styled by `row` for its height and by `listbox.boxed-list > row` for its
  # corners, and keeping only the second gave it the corners and no height at all.
  # Ordering by how many segments the rule names is CSS's own answer to which of two
  # rules setting the same property wins.
  def self.lookup(path, contexts, widgets)
    # The nodes neither side writes down come out of the path as well as out of the rule:
    # a header bar's gizmos are `widget` nodes, and a rule naming
    # `headerbar > windowhandle > box > box.end` has to reach the box inside one.
    walked = path.reject{|one| IMPLICIT.include?(self.segment(one).first) && self.segment(one).last.empty? }

    return {} if walked.last != path.last

    matches = contexts.select{|selector, _states| self.matches?(self.addressing(selector), walked) }

    ordered = matches.sort_by{|selector, _states| self.specificity(selector) }.map(&:last)

    self.merged([widgets.fetch(walked.last, {})] + ordered)
  end

  def self.each_node(node, &block)
    block.call(node)

    node.fetch("children", []).each{|child| self.each_node(child, &block) }
    node.fetch("slots", {}).each_value{|slot| self.each_node(slot, &block) }
  end

  # Beside the script, in a directory named after it.
  def self.output(name)
    File.join(__dir__, "08-final-components.out").then do |directory|
      Dir.mkdir(directory) unless Dir.exist?(directory)
      File.join(directory, name)
    end
  end
end

FinalComponents.run(ARGV)
