#!/usr/bin/env ruby
# frozen_string_literal: true

# 08-FINAL-COMPONENTS(1)           General Commands Manual           08-FINAL-COMPONENTS(1)
#
# NAME
#      bin/08-final-components — the component list, joined from the passes before it
#
# SYNOPSIS
#      bin/08-final-components > bin/08-final-components.out/final-components.json
#
# DESCRIPTION
#      Loads the catalogue from bin/05-adwaita-components, the templates from
#      bin/06-component-trees, the introspection schemas from bin/07-gtk-schemas and the
#      selector map from bin/03-adwaita-tailwind, and joins them into one entry per
#      component: what it is, what it accepts, what it renders as, and what the stylesheet
#      draws it with.
#
#      IT DECIDES NOTHING ON ITS OWN. Which widgets exist, which CSS node each renders as
#      and which style classes it carries are read from the toolkit's source by
#      bin/05-adwaita-components. Properties, enumerations and parentage are read from the
#      introspection data by bin/07-gtk-schemas. The measurements are read from the
#      stylesheet by bin/03-adwaita-tailwind. This pass looks nothing up for itself.
#
#      A variant is a style class the stylesheet draws on a component's node, or one the
#      widget puts on itself. `.text-button` is the second kind: no application writes it
#      and no page documents it, and GtkButton adds it to every button holding a label.
#
# FILES
#      bin/05-adwaita-components.out/components.json         the catalogue, from 05
#      bin/06-component-trees.out/trees.json              the templates, from 06
#      bin/07-gtk-schemas.out/schemas.json                the schemas, from 07
#      bin/03-adwaita-tailwind.out/widgets.json            the selector map, from 03
#      bin/03-adwaita-tailwind.out/widgets-contexts.json   the same, keyed by context
#      bin/08-final-components.out/final-components.json   the output
#
# EXIT STATUS
#      The bin/08-final-components utility exits 0 on success, and >0 if an error occurs.
#
# SEE ALSO
#      bin/05-adwaita-components, bin/06-component-trees, bin/07-gtk-schemas
#
# adwaita-cn                         October 13, 2026                08-FINAL-COMPONENTS(1)

require "json"
require "set"

module FinalComponents
  ROOT = File.expand_path("..", __dir__)

  # Classes which show text, for reading a template's bindings.
  LABELS = %w[Label FadingLabel Inscription].freeze

  # Classes a shared helper applies rather than any one widget's file, keyed by the
  # property which decides them. gtk_widget_update_orientation in gtkwidget.c puts
  # `.horizontal` or `.vertical` on any widget implementing Gtk.Orientable, so no
  # widget's own source mentions them and the property is what says who carries them.
  BY_PROPERTY = { "orientation" => %w[horizontal vertical] }.freeze

  def self.run(_argv)
    catalogue = self.read("bin/05-adwaita-components.out/components.json")
    trees = self.read("bin/06-component-trees.out/trees.json")
    schemas = self.read("bin/07-gtk-schemas.out/schemas.json")
    widgets = self.read("bin/04-gtk-tailwind.out/gtk-widgets.json").merge(self.read("bin/03-adwaita-tailwind.out/widgets.json"))
    contexts = self.read("bin/04-gtk-tailwind.out/gtk-widgets-contexts.json")
      .merge(self.read("bin/03-adwaita-tailwind.out/widgets-contexts.json"))

    classes = schemas.fetch("classes")
    enums = schemas.fetch("enums")
    shared = self.own_props(classes.fetch("Widget"), {})
    source = catalogue.fetch("widgets")

    # `Button` in the schemas is `GtkButton` in the source: one is the name the
    # documentation uses and the other the name the C defines.
    qualified = classes.to_h{|name, schema| [name, schema.fetch("class").sub(".", "")] }

    self.read_templates(trees)

    names = classes.keys | trees.fetch("referenced").keys | trees.fetch("trees").keys

    components = names.sort.to_h do |name|
      [name, self.entry(name, qualified[name], classes, source, shared, enums, widgets, contexts, trees)]
    end

    self.annotate_trees(components, contexts, widgets)

    buildable = components.reject do |_name, entry|
      %w[abstract behaviour private].include?(entry.fetch("kind"))
    end

    File.write(self.output("final-components.json"), "#{JSON.pretty_generate({
      "versions" => schemas.fetch("versions"),
      "counts" => components.group_by{|_name, entry| entry.fetch("kind") }.transform_values(&:size)
        .merge("variants" => components.values.sum{|entry| entry.fetch("variants").length }),
      "buildable" => buildable.keys.sort,
      "enums" => self.referenced(buildable, enums),
      "widget" => shared,
      "components" => components,
      "universal" => self.universal(contexts),
    })}\n")
    warn("wrote bin/08-final-components.out/final-components.json")
  end

  def self.read(relative) = JSON.parse(File.read(File.join(ROOT, relative)))

  # One component, joined. Everything here is looked up; nothing is decided.
  def self.entry(name, qualified, classes, source, shared, enums, widgets, contexts, trees)
    schema = classes[name]
    own = self.source_for(name, qualified, source)
    props = schema.nil? ? {} : self.own_props(schema, shared)
    node = own && own["node"]
    tree = self.tree_for(name, classes, trees)
    found = self.enums_of(props)

    {
      "kind" => self.kind(name, schema, classes, tree),
      "gtk" => schema&.fetch("class"),
      "parent" => schema && schema["parent"],
      "props" => props,
      "accepts" => schema.nil? ? {} : self.accepts(schema),
      "text" => self.text(name, props, source, qualified, classes, tree, trees),
      "enums" => found,
      "flags" => found.select{|one| enums.dig(one, "flags") },
      "node" => node,
      "nodes" => [node].compact,
      "source" => own && own["source"],
      "layout" => own && own["layout"],
      "direction" => own && own["direction"],
      "classes" => node ? self.classes_for([node], widgets, contexts) : {},
      "variants" => self.variants(name, node, own, source, classes, contexts, props),
    }.merge(tree ? { "template" => tree.fetch("template"), "tree" => tree.fetch("tree") } : {})
  end

  # The template a component is built from. A subclass with none of its own is built
  # from its parent's: AdwSwitchRow ships no .ui and is an AdwActionRow with a switch in
  # its suffixes, so without this it renders its title and subtitle loose.
  def self.tree_for(name, classes, trees)
    self.ancestry(name, classes).filter_map{|one| trees.fetch("trees")[one] }.first
  end

  def self.source_for(name, qualified, source)
    source[qualified] || source["Adw#{name}"] || source["Gtk#{name}"]
  end

  # Gtk.Widget is the one every component inherits from and nothing renders; a class the
  # introspection data does not carry is the library's own business; the rest is a widget
  # when it descends from Widget, and a plain object when it does not.
  def self.kind(name, schema, classes, tree)
    if name == "Widget"
      "abstract"
    elsif tree
      # libadwaita ships a template for it, so it is something it builds, whether or not
      # the introspection data carries a class anyone can instantiate: AdwTab and
      # AdwToastWidget are built from .ui files and exported by neither.
      "composite"
    elsif schema.nil?
      "private"
    elsif self.ancestry(name, classes).include?("Widget")
      "widget"
    else
      "behaviour"
    end
  end

  def self.ancestry(name, classes)
    [].tap do |found|
      current = name

      while current && classes.key?(current) && !found.include?(current)
        found << current
        current = classes.fetch(current)["parent"]
      end
    end
  end

  # The style classes a component can carry: the ones the stylesheet draws on its node,
  # and the ones the widget or an ancestor puts on itself.
  def self.variants(name, node, own, source, classes, contexts, props = {})
    return {} if node.nil?

    by_property = BY_PROPERTY.filter_map{|prop, styles| styles if props.key?(prop) }.flatten

    applied = self.ancestry(name, classes).flat_map do |ancestor|
      entry = self.source_for(ancestor, classes.dig(ancestor, "class")&.sub(".", ""), source)

      entry ? entry.fetch("applies", []) : []
    end.uniq

    # A rule naming no element -- `.card`, `.dim-label` -- can go on any widget, so it is
    # not a variant of a particular one; those are listed once under `universal`. What is
    # a variant here is what the stylesheet names on this node, what the widget puts on
    # itself, and what a template puts on a widget of this class.
    candidates = self.styled_on(node, contexts) | applied | by_property |
      self.templated.fetch(name, [])

    candidates.uniq.sort.to_h do |style|
      rules = self.variant_classes(style, node, contexts)
      merged = self.merged(rules.values)

      [style, {
        "classes" => merged,
        "context" => rules.keys.reject{|selector| self.segments(selector).length == 1 }.sort,
        "colour" => merged.values.all?(&:empty?),
        "applied" => applied.include?(style) || by_property.include?(style),
        "universal" => self.unscoped(contexts).include?(style),
      }]
    end
  end

  # The classes libadwaita's own templates put on a widget of each class: a .ui saying
  # `<style><class name="card"/></style>` on a box is the toolkit stating that a box
  # carries `.card`.
  def self.templated = @templated ||= {}

  def self.read_templates(trees)
    @templated = Hash.new{|found, key| found[key] = [] }

    trees.fetch("trees").each_value do |entry|
      self.each_node(entry.fetch("tree")) do |node|
        @templated[node.fetch("class")] |= node.fetch("styles", [])
      end
    end
  end

  # Every class the stylesheet draws on this node, from a selector whose subject is it.
  def self.styled_on(node, contexts)
    contexts.keys.filter_map do |selector|
      element, styles = self.segment(self.segments(selector).last.to_s)

      styles.to_a.first if styles.length == 1 && element == node
    end.uniq
  end

  # The rules which style a node carrying this class, taken at the shallowest context the
  # stylesheet states them in: `.flat` on a headerbar is not `.flat` on a button, and
  # merging every `.flat` rule gives a flat HeaderBar a button's padding.
  def self.variant_classes(style, node, contexts)
    own = contexts.select do |selector, _states|
      element, styles = self.segment(self.segments(selector).last.to_s)

      styles.to_a == [style] && (element.nil? || element == node)
    end

    shallowest = own.keys.map{|selector| self.segments(selector).length }.min

    own.select{|selector, _states| self.segments(selector).length == shallowest }
  end

  # The classes the stylesheet states without naming an element.
  def self.unscoped(contexts)
    @unscoped ||= contexts.keys.filter_map do |selector|
      element, styles = self.segment(selector)

      styles.to_a.first if element.nil? && styles.length == 1 && self.segments(selector).length == 1
    end.uniq
  end

  # The classes which go on any widget at all, which are the rules naming no element.
  def self.universal(contexts)
    self.unscoped(contexts).sort.to_h do |style|
      rules = self.variant_classes(style, nil, contexts)
      merged = self.merged(rules.values)

      [style, {
        "classes" => merged,
        "context" => [],
        "colour" => merged.values.all?(&:empty?),
        "applied" => false,
        "universal" => true,
      }]
    end
  end

  # The props a component shows as text. bin/05 reads the setters which put a property
  # into a label; a template binds the rest, which is where AdwAboutDialog's `version`
  # comes from.
  def self.text(name, props, source, qualified, classes, tree, trees = nil)
    from_source = self.ancestry(name, classes).flat_map do |ancestor|
      entry = self.source_for(
        ancestor,
        ancestor == name ? qualified : classes.dig(ancestor, "class")&.sub(".", ""),
        source,
      )

      entry ? entry.fetch("showsText", []) : []
    end

    # Text is a string by definition: a template node whose id happens to match a boolean
    # property is not the component showing that property as text.
    # A template an ancestor ships shows this component's properties too, because the
    # component is built from it: `title` is AdwPreferencesRow's and AdwActionRow's
    # template is what puts it on screen.
    inherited = trees.nil? ? [] : self.ancestry(name, classes).flat_map do |ancestor|
      self.bound(trees.fetch("trees")[ancestor])
    end

    (from_source | self.bound(tree) | inherited)
      .select{|prop| props.dig(prop, "type") == "string" }
      .sort
  end

  # The props a template binds to something which shows text.
  def self.bound(tree)
    return [] if tree.nil?

    [].tap do |found|
      self.each_node(tree.fetch("tree")) do |node|
        next unless LABELS.include?(node.fetch("class"))

        node.fetch("properties", {}).each do |property, value|
          found << self.camel(value.fetch("bind")) if value.is_a?(Hash) && %w[label text].include?(property)
        end

        found << self.camel(node["id"]) if node["id"]
      end
    end.uniq
  end

  def self.camel(name)
    parts = name.to_s.split("-")

    parts.first.to_s + parts.drop(1).map(&:capitalize).join
  end

  def self.enums_of(props)
    props.values
      .select{|attributes| attributes.fetch("type") == "enum" }
      .map{|attributes| attributes.fetch("enum") }
      .uniq
      .sort
  end

  # Every prop a component accepts, inherited ones included, keyed under both spellings.
  # This is what a lint tests an attribute against, and it is a different question from
  # what the component declares: `<ActionRow visible>` is correct and `visible` is
  # GtkWidget's.
  def self.accepts(schema)
    {}.tap do |found|
      schema.fetch("properties").each do |gtk, attributes|
        rule = attributes.slice("type", "writable", "from", "values", "enum")

        found[gtk] = rule
        found[attributes.fetch("prop")] = rule
      end
    end
  end

  # A class's own writable props: the canonical key, minus anything Gtk.Widget already
  # gives every component.
  def self.own_props(schema, shared)
    {}.tap do |found|
      schema.fetch("properties").each do |key, attributes|
        next unless attributes.fetch("writable")
        next if shared.key?(attributes.fetch("prop"))
        next unless key.include?("-") || key == attributes.fetch("prop")

        found[attributes.fetch("prop")] = attributes
      end
    end
  end

  # Every enumeration a buildable component's props draw from, taken from `accepts`.
  def self.referenced(buildable, enums)
    found = buildable.values.flat_map do |entry|
      entry.fetch("accepts").values.filter_map{|rule| rule["enum"] }
    end

    enums.slice(*found.uniq.sort)
  end

  # What a node is styled with on its own.
  def self.classes_for(nodes, widgets, contexts)
    nodes.to_a.each_with_object({}) do |node, found|
      own = widgets.fetch(node, nil) || self.addressed(node, contexts)

      own.each{|state, list| found[state] = found.fetch(state, []) | list }
    end
  end

  # The rules which address a node and nothing else about it: one segment, no classes.
  def self.addressed(node, contexts)
    own = contexts.select do |selector, _states|
      segments = self.segments(selector)
      element, styles = self.segment(segments.first.to_s)

      segments.length == 1 && element == node && styles.empty?
    end

    self.merged(own.values)
  end

  def self.merged(states)
    states.each_with_object({}) do |one, found|
      one.each{|state, list| found[state] = found.fetch(state, []) | list }
    end
  end

  def self.segments(selector) = selector.split(/\s*>\s*|\s+/).reject(&:empty?)

  # A selector segment, split into the element it names and the classes on it. A rule may
  # name no element at all -- `.prefixes` rather than `box.prefixes` -- which matches any.
  def self.segment(text)
    [text[/\A[a-z][a-z0-9-]*/], text.scan(/\.([a-z0-9-]+)/).flatten.to_set]
  end

  # Whether a rule's segment addresses a node: the element has to agree where the rule
  # names one, and every class the rule asks for has to be on the node.
  def self.addresses?(rule, node)
    element, styles = self.segment(rule)
    node_element, node_styles = self.segment(node)

    (element.nil? || element == node_element) && styles.subset?(node_styles)
  end

  # A node's CSS path, which is how the stylesheet addresses it.
  def self.selector(node, name = nil)
    styles = node.fetch("styles", []).map{|style| ".#{style}" }.join
    klass = node.fetch("class")

    "#{name || self.nodes.fetch(klass, klass.downcase)}#{styles}"
  end

  # The trees are annotated once the nodes are known, because a tree's root is addressed
  # by the component's CSS node rather than by its class name.
  def self.annotate_trees(components, contexts, widgets)
    # How each class arranges its children, so that a template's boxes carry it too: a
    # composite is built out of other widgets, and a box inside a template is as much a
    # box as one a caller makes.
    @layouts = components.transform_values{|entry| entry["layout"] }.compact

    # The CSS node each class renders as. A template names classes and the stylesheet
    # names nodes, and the two are not the same word: GtkListBox is `list`, and a path
    # built from the class name addresses nothing, so `.boxed-list` never reaches it.
    @nodes = components.transform_values{|entry| entry["node"] }.compact

    components.each_value do |entry|
      next unless entry.key?("tree")

      root = entry["node"] || entry.fetch("nodes", []).first
      entry["tree"] = self.annotate(entry.fetch("tree"), [], contexts, widgets, root, entry["classes"])
    end
  end

  def self.layouts = @layouts ||= {}
  def self.nodes = @nodes ||= {}

  # Every node in a tree, with the path it sits at and the classes that path is styled
  # with.
  def self.annotate(node, ancestors, contexts, widgets, name = nil, own = nil)
    path = ancestors + [self.selector(node, name)]
    classes = own || self.lookup(path, contexts, widgets)

    node.merge(
      "css" => path.join(" > "),
      "classes" => classes,
      "layout" => self.layouts[node.fetch("class")],
      "children" => node.fetch("children", []).map{|child| self.annotate(child, path, contexts, widgets) },
      "slots" => node.fetch("slots", {}).transform_values{|slot| self.annotate(slot, path, contexts, widgets) },
    ).reject{|_key, value| value.respond_to?(:empty?) && value.empty? }
  end

  # The rules which address this path: one whose segments are a suffix of it, matching
  # loosely so that a rule naming no element still applies. The longest match wins.
  def self.lookup(path, contexts, widgets)
    matches = contexts.select do |selector, _states|
      segments = selector.split(">").map(&:strip)

      segments.length <= path.length &&
        path.last(segments.length).zip(segments).all?{|node, rule| self.addresses?(rule, node) }
    end

    if matches.empty?
      widgets.fetch(path.last, {})
    else
      matches.max_by{|selector, _states| selector.split(">").length }.last
    end
  end

  def self.each_node(node, &block)
    block.call(node)

    node.fetch("children", []).each{|child| self.each_node(child, &block) }
    node.fetch("slots", {}).each_value{|slot| self.each_node(slot, &block) }
  end

  # Beside the script, in a directory named after it.
  def self.output(name)
    File.join(__dir__, "08-final-components.out").then do |directory|
      Dir.mkdir(directory) unless Dir.exist?(directory)
      File.join(directory, name)
    end
  end
end

FinalComponents.run(ARGV)
