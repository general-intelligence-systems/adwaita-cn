#!/usr/bin/env ruby
# frozen_string_literal: true

# 08-FINAL-COMPONENTS(1)          General Commands Manual         08-FINAL-COMPONENTS(1)
#
# NAME
#      bin/08-final-components — every component, with its styles, props and tree
#
# SYNOPSIS
#      bin/08-final-components > vendor/adwaita/final-components.json
#
# DESCRIPTION
#      Joins the four things the earlier steps produced into the one document the rest of the
#      pipeline is generated from: the component list, the Tailwind classes, the child trees and
#      the widget schemas.
#
#      THIS IS THE AUTHORITY. bin/09-gtk-enums, bin/10-lint-rules and bin/11-generate-components
#      all read this and nothing else, so a component exists exactly once and its props, its
#      classes and its tree cannot disagree with each other.
#
#      NOTHING HERE IS HAND-WRITTEN. Every input is generated by an earlier step and every
#      question this step asks is answered out of them.
#
#      A class a template is built out of is named by the template, and its name IS its class --
#      GtkBox is Box, AdwClamp is Clamp. Nothing to map.
#
#      A composite widget which ships a template is the same.
#
#      A STYLESHEET SUBJECT IS RESOLVED, which used to be a list of recorded decisions and is
#      not one any more. A selector names a CSS node, and GTK documents which class draws which
#      node in every class's `# CSS nodes` section -- bin/07-gtk-schemas reads that section, so
#      `list` is ListBox because GtkListBox says so, and the few classes which omit the section
#      are caught by the naming convention it corroborates. See resolve() for the four outcomes
#      and the evidence for each.
#
#      A STYLE CLASS IS NOT A COMPONENT AT ALL, which is why trying to name the class it belongs
#      to produced nonsense like `Card -> Overlay`. `.card` is a modifier: a look a widget can
#      be given, and libadwaita gives it to a GtkOverlay in adw-tab-thumbnail.ui, to a button in
#      the stylesheet, and to a bare box wherever an application wants one. So the modifiers are
#      emitted as their own section, each with the classes it contributes and the three
#      independent accounts of what it goes on. See modifier().
#
#      KIND SAYS WHICH IT IS, and three of the four are not components to build:
#
#      composite   ships a .ui template, so its child tree is known
#      widget      a widget class with no template, built in C
#      style       a style class with no class of its own
#      abstract    a base class, which is styling and inheritance rather than a component
#      behaviour   a model, gesture or event controller: no DOM, so a prop or a hook
#      private     referenced by a template but absent from the public API, so ours to write
#
#      A PART IS NOT A COMPONENT EITHER. `check` is the indicator GtkCheckButton draws inside
#      itself and `radio` is the one it draws in the other mode; both are styled, neither is a
#      widget anyone constructs. They are emitted in `parts` with the widgets which draw them,
#      because a part can be drawn in several places and all of them are reported.
#
#      POSITIONS ARE DERIVED FROM THE TREE. A node inside a composite which carries a style class
#      the stylesheet has rules for is a position -- Box.prefixes and Box.suffixes inside
#      ActionRow -- and it is reported with the classes bin/03-adwaita-tailwind generated for it.
#      That is the parent/child question answered from the data rather than by taste.
#
# FILES
#      vendor/adwaita/components.json     the CSS-derived list, from 05
#      vendor/adwaita/widgets.json        the Tailwind classes, from 03
#      vendor/adwaita/gtk-widgets.json    GTK's, for what Adwaita leaves unstyled, from 04
#      vendor/adwaita/trees.json          the child trees, from 06
#      vendor/gir/schemas.json            the props and the CSS nodes, from 07
#
#      GTK.WIDGET'S OWN PROPS ARE EMITTED SEPARATELY, under `widget`. Every component has them
#      and none of them is interesting on any one component, so they are subtracted from each
#      entry's `props` and stated once -- which is also the one interface the generated
#      components extend.
#      vendor/adwaita/final-components.json   the output
#
# EXIT STATUS
#      The bin/08-final-components utility exits 0 on success, and >0 if an error occurs.
#
# SEE ALSO
#      bin/09-gtk-enums, bin/10-lint-rules, bin/11-generate-components
#
# adwaita-cn                      October 12, 2026               08-FINAL-COMPONENTS(1)

require "json"
require "set"

module FinalComponents
  def self.read(root, relative)
    JSON.parse(File.read(File.join(root, relative)))
  end

  def self.run(_argv)
    root = File.expand_path("..", __dir__)
    # ADWAITA FIRST AND GTK ONLY WHERE ADWAITA IS SILENT, which is the same precedence the
    # namespaces are consolidated under. The two sheets are alternatives rather than layers --
    # bin/03-adwaita-tailwind says why -- so bin/04-gtk-tailwind has already reduced GTK's to the
    # nodes libadwaita never mentions, and merging Adwaita's over it cannot overwrite anything.
    widgets = self.read(root, "vendor/adwaita/gtk-widgets.json")
      .merge(self.read(root, "vendor/adwaita/widgets.json"))
    contexts = self.read(root, "vendor/adwaita/gtk-widgets-contexts.json")
      .merge(self.read(root, "vendor/adwaita/widgets-contexts.json"))
    css = self.read(root, "vendor/adwaita/components.json").fetch("components")
    trees = self.read(root, "vendor/adwaita/trees.json")
    schemas = self.read(root, "vendor/gir/schemas.json")

    classes = schemas.fetch("classes")
    enums = schemas.fetch("enums")
    nodes = schemas.fetch("nodes")
    parents = self.parentage(contexts)
    applied = self.applications(trees.fetch("trees"))
    modifiers = {}
    shared = self.own_props(classes.fetch("Widget"), {})

    components = {}

    # The composites, whose trees are known.
    trees.fetch("trees").each do |name, entry|
      components[name] = self.entry(name, "composite", classes[name], classes, shared, enums)
        .merge("template" => entry.fetch("template"))
        .merge("tree" => entry.fetch("tree"))
    end

    # Every class the templates are built out of.
    trees.fetch("referenced").each_key do |name|
      next if components.key?(name)

      kind = self.kind_of(name, classes)
      components[name] = self.entry(name, kind, classes[name], classes, shared, enums)
    end

    # And everything the stylesheet styles, each resolved to what it is.
    parts = {}

    self.styles(contexts, schemas.fetch("styles")).each do |style|
      modifiers[style] = self.modifier(style, widgets, contexts, schemas.fetch("styles"), applied)
    end

    self.subjects(contexts).each do |key|
      found = self.resolve(key, nodes, classes, parents)

      if found.fetch("kind") == "part"
        parts[key] = found.merge("classes" => self.classes_for([key], widgets, contexts))
        next
      end

      name = found["widget"] || self.component(key, trees.fetch("referenced"))
      kind = found.fetch("kind") == "private" ? "private" : self.kind_of(name, classes)
      entry = components[name] || self.entry(name, kind, classes[name], classes, shared, enums)

      components[name] = entry.merge(
        "node" => key,
        "nodes" => [key],
        "classes" => self.classes_for([key], widgets, contexts),
      )
    end

    # A component which is neither a style class nor styled by one still has whatever its own
    # node is styled with.
    components.each do |name, entry|
      next if entry.key?("classes")

      own = self.rendered(name, nodes, classes)

      unless own.nil?
        entry["node"] = own
      end

      entry["nodes"] = [own || name.downcase].select{|node| widgets.key?(node)}
      entry["classes"] = self.classes_for(entry["nodes"], widgets, contexts)
    end

    # The trees are annotated once the nodes are known, because a tree's root is addressed by
    # the component's CSS node rather than by its class name.
    components.each do |name, entry|
      next unless entry.key?("tree")

      root = entry["node"] || entry.fetch("nodes", []).first
      entry["tree"] = self.annotate(entry.fetch("tree"), [], contexts, widgets, root, entry["classes"])
    end

    buildable = components.reject{|_name, entry| %w[abstract behaviour private].include?(entry.fetch("kind"))}

    puts(JSON.pretty_generate({
      "versions" => schemas.fetch("versions"),
      "counts" => components.group_by{|_name, entry| entry.fetch("kind")}.transform_values(&:size),
      "buildable" => buildable.keys.sort,
      "enums" => self.referenced(buildable, enums),
      "widget" => shared,
      "components" => components.sort.to_h,
      "modifiers" => modifiers.sort.to_h,
      "parts" => parts.sort.to_h,
    }))
  end

  # ── What a stylesheet subject actually is ──

  # A selector names a CSS node, and a node is one of four things. Which one is decided by
  # evidence, in the order the evidence is trustworthy:
  #
  # A NODE THE DOCUMENTATION CALLS A CLASS'S OWN is that class. bin/07-gtk-schemas reads the
  # `# CSS nodes` section out of every class's doc comment, so `list` is ListBox because
  # GtkListBox says so.
  #
  # A NODE NAMED AFTER A CLASS is that class. GTK names a node after the widget which draws it,
  # lowercased and with the hyphens gone, and the two sources agree in 85 of the 86 cases where
  # both exist -- so this picks up the classes whose documentation omits the section, like
  # GtkTooltip and AdwToast.
  #
  # A NODE THE DOCUMENTATION CALLS A PART is a part. `check` is the indicator GtkCheckButton
  # draws inside itself and `link` is what GtkLabel makes of a markup link: both are styled,
  # neither is a component, and a registry which made components of them would be wrong.
  #
  # A NODE THE STYLESHEET ONLY EVER PUTS UNDER ANOTHER NODE is a part of that one. This is what
  # answers the handful the documentation skips: `sheet` is under `bottom-sheet`, `emoji` under
  # `popover`, `colorswatch` under `button`. The rule is the stylesheet's own, read back out of
  # its selectors.
  #
  # A PART CAN BE DRAWN IN MORE THAN ONE PLACE, so every host the stylesheet names is reported
  # rather than the commonest one. `radio` is the indicator GtkCheckButton draws and also the
  # one a menu item draws, and naming only the second because menus have more rules about it
  # would be an arbitrary choice dressed up as a derivation.
  #
  # A NODE WITH NONE OF THE ABOVE is private. AdwTabThumbnail is a real widget with real rules
  # and no public class, so it is ours to write rather than ours to wrap.
  def self.resolve(key, nodes, classes, parents)
    documented = nodes[key]
    named = classes.keys.find{|name| name.downcase.delete("-") == key.delete("-")}

    if documented&.fetch("kind") == "root" && documented["widget"]
      { "kind" => "widget", "widget" => documented.fetch("widget") }
    elsif named
      { "kind" => "widget", "widget" => named }
    elsif documented
      { "kind" => "part", "hosts" => [documented["widget"]].compact, "source" => "documented" }
    elsif parents.key?(key)
      { "kind" => "part", "hosts" => self.hosts(parents.fetch(key), nodes, classes), "source" => "stylesheet" }
    else
      { "kind" => "private" }
    end
  end

  # The class name of a private node. A private widget is named the same way a public one is,
  # so a template which references AdwTabThumbnail names the class whose node is `tabthumbnail`.
  # One which no template references has no name to take, and the node's own is used.
  def self.component(key, referenced)
    referenced.keys.find{|name| name.downcase.delete("-") == key.delete("-")} ||
      key.split("-").map(&:capitalize).join
  end

  # Which nodes the stylesheet puts each node under. A selector's last segment is its subject
  # and the one before it is what the subject sits inside, so the selectors say where an
  # undocumented node lives -- and where it lives in more than one place, they say that too.
  def self.parentage(contexts)
    counted = {}

    contexts.each_key do |selector|
      segments = self.segments(selector).map{|segment| self.segment(segment).first}.compact

      if segments.length > 1
        found = (counted[segments.last] ||= {})
        found[segments[-2]] = found.fetch(segments[-2], 0) + 1
      end
    end

    counted.transform_values{|found| found.sort_by{|node, count| [-count, node]}.map(&:first)}
  end

  # The widgets which draw a part, from the nodes the stylesheet puts it under. A parent which is
  # itself a part or a private widget resolves to nothing and is left out: it is a position
  # inside some other widget rather than a widget of its own.
  def self.hosts(parents, nodes, classes)
    parents.filter_map{|parent| self.resolve(parent, nodes, classes, {})["widget"]}.uniq
  end

  # A descendant combinator is a space, and a child one is `>`. Both say the same thing here.
  def self.segments(selector)
    selector.split(/\s*>\s*|\s+/).reject(&:empty?)
  end

  # A STYLE CLASS IS A MODIFIER, NOT A WIDGET, which is why asking which class `.card` is has no
  # answer. It is a look a widget can be given: libadwaita puts `.card` on a GtkOverlay in
  # adw-tab-thumbnail.ui, on a button in the stylesheet, and on a bare box wherever an
  # application wants one. So it is emitted as the classes it contributes plus what it goes on,
  # and three independent sources say what that is:
  #
  # documented   the classes whose doc comment names it, from the GIR
  # elements     the element names the stylesheet attaches it to, `*` where it attaches to none
  # applied      the widget classes libadwaita's own templates put it on
  #
  # A modifier whose elements are `*` goes on anything, and that is a fact about it rather than a
  # gap in the data -- `.osd` has 133 rules which name no element at all.
  def self.modifier(style, widgets, contexts, documented, applied)
    {
      "classes" => self.contributes(style, widgets, contexts),
      "documented" => documented.fetch(style, []),
      "elements" => self.elements(style, contexts),
      "applied" => applied.fetch(style, []).uniq.sort,
    }
  end

  # Every node the stylesheet mentions at all.
  #
  # THE MERGED MAP IS NOT THE WHOLE LIST, which is what bin/05-adwaita-components reads and why
  # this does not. It keys by the compound a rule styles and drops a subject carrying one lone
  # declaration, so `windowcontrols` and `stackswitcher` were missing from it -- libadwaita
  # styles both, but only ever in a context like `.default-decoration.titlebar windowcontrols`.
  #
  # EVERY SEGMENT, NOT ONLY THE SUBJECT, because a widget which is only ever written as the
  # ancestor of its own parts is still a widget: libadwaita says `bottom-sheet > sheet` and
  # never addresses the bottom-sheet node on its own, and reading subjects alone lost
  # AdwBottomSheet entirely.
  #
  # The ones which are noise resolve to a part or to nothing and are not built either way.
  def self.subjects(contexts)
    contexts.each_key.flat_map do |selector|
      self.segments(selector).filter_map{|segment| self.segment(segment).first}
    end.uniq.sort
  end

  # Every style class there is, which is two sources because neither is complete on its own.
  #
  # THE STYLESHEET NAMES MOST OF THEM, in any selector segment rather than only as a bare
  # subject: `.boxed-list` is written `list.boxed-list` everywhere libadwaita uses it and never
  # on its own, and reading only the bare subjects lost it.
  #
  # THE DOCUMENTATION NAMES SEVENTEEN MORE, which the stylesheet does mention but never without
  # an element -- `.flat`, `.circular`, `.link`, `.separators`. A class GTK documents as a style
  # class is one, whatever the selectors look like.
  def self.styles(contexts, documented)
    found = contexts.each_key.flat_map do |selector|
      self.segments(selector).flat_map{|segment| self.segment(segment).last.to_a}
    end

    (found | documented.keys).sort
  end

  # What a style class contributes on its own. A rule which names the class and nothing else is
  # the class's own styling; one which puts it in a structure -- `list.boxed-list > row` -- is
  # the styling of whatever that structure ends in, and annotate() reports it there instead.
  def self.contributes(style, widgets, contexts)
    own = contexts.select do |selector, _states|
      segments = self.segments(selector)

      segments.length == 1 && self.segment(segments.first).last.to_a == [style]
    end

    widgets.fetch(".#{style}", {}).merge(self.merged(own.values))
  end

  # Several rules' classes, per state, merged into one set.
  def self.merged(states)
    states.each_with_object({}) do |one, found|
      one.each{|state, list| found[state] = found.fetch(state, []) | list}
    end
  end

  # The element names a style class is attached to across the stylesheet, counted, with `*` for
  # the rules which name no element and so address any widget at all.
  def self.elements(style, contexts)
    counted = {}

    contexts.each_key do |selector|
      self.segments(selector).each do |segment|
        element, classes = self.segment(segment)

        if classes.include?(style)
          key = element || "*"
          counted[key] = counted.fetch(key, 0) + 1
        end
      end
    end

    counted.sort_by{|element, count| [-count, element]}.to_h
  end

  # Which widget class each style class is put on, by libadwaita's own templates.
  def self.applications(trees)
    {}.tap do |found|
      trees.each_value do |entry|
        self.each_node(entry.fetch("tree")) do |node|
          node.fetch("styles", []).each{|style| (found[style] ||= []) << node.fetch("class")}
        end
      end
    end
  end

  # Which CSS node a component renders as.
  #
  # A SUBCLASS RENDERS ITS PARENT'S NODE unless it declares one of its own, which is how GTK
  # works and is why this walks the chain. AdwActionRow declares no node and is an
  # AdwPreferencesRow, whose node is `row`, so `row`'s rules are ActionRow's rules -- and
  # looking only at the class itself left ActionRow with no styling at all.
  def self.rendered(name, nodes, classes)
    found = nil
    current = name

    while current && found.nil?
      found = nodes.find{|_node, entry| entry["kind"] == "root" && entry["widget"] == current}
      current = classes.dig(current, "parent")
    end

    found&.first
  end

  # Every enumeration a buildable component's props draw from, so that what is generated as
  # TypeScript is what something imports rather than all 158 of them.
  #
  # FROM `accepts` RATHER THAN FROM `props`, because a component is annotated with its own props
  # and checked against every prop it takes, and the second set is the larger one. Narrowing it
  # to the declared props is what had a generated entry.tsx import an InputHints which nothing
  # had written.
  def self.referenced(buildable, enums)
    found = buildable.values.flat_map do |entry|
      entry.fetch("accepts").values.filter_map{|rule| rule["enum"]}
    end

    found.uniq.sort.to_h{|name| [name, enums.fetch(name)]}
  end

  # The bases every widget descends from, which name no component. `widget` is a CSS node
  # libadwaita styles -- AdwNavigationSplitView renders its two panes as bare GtkWidgets and
  # addresses them `widget.sidebar-pane` and `widget.content-view` -- but GtkWidget is abstract,
  # and a Widget component would be a base class with a placeholder div in it. What those rules
  # actually describe is the two style classes, which are modifiers like any other.
  ABSTRACT = %w[Widget].freeze

  # A class which does not descend from Widget renders nothing, and one the public API does not
  # have is libadwaita's own business.
  def self.kind_of(name, classes)
    if ABSTRACT.include?(name)
      "abstract"
    elsif !classes.key?(name)
      "private"
    elsif self.widget?(name, classes)
      "widget"
    else
      "behaviour"
    end
  end

  def self.widget?(name, classes)
    seen = Set.new
    current = name

    while current && classes.key?(current) && !seen.include?(current)
      seen << current
      current = classes.fetch(current)["parent"]
    end

    seen.include?("Widget")
  end

  def self.entry(_name, kind, schema, classes, shared, enums)
    props = schema.nil? ? {} : self.own_props(schema, shared)

    {
      "kind" => kind,
      "gtk" => schema&.fetch("class"),
      "parent" => schema && schema["parent"],
      "props" => props,
      "accepts" => schema.nil? ? {} : self.accepts(schema),
      "enums" => props.values
        .select{|attributes| attributes.fetch("type") == "enum"}
        .map{|attributes| attributes.fetch("enum")}
        .uniq
        .sort,
      "flags" => props.values
        .select{|attributes| attributes.fetch("type") == "enum" && enums.dig(attributes.fetch("enum"), "flags")}
        .map{|attributes| attributes.fetch("enum")}
        .uniq
        .sort,
    }
  end

  # Every prop a component accepts, inherited ones included, keyed under both spellings. This
  # is what a lint tests an attribute against, and it is a different question from what the
  # component declares: `<ActionRow visible>` is correct and `visible` is GtkWidget's.
  #
  # READ-ONLY PROPS ARE KEPT AND FLAGGED. Passing one is an error worth reporting, and a lint
  # cannot report what it was not told about.
  def self.accepts(schema)
    {}.tap do |found|
      schema.fetch("properties").each do |gtk, attributes|
        rule = attributes.slice("type", "writable", "from", "values", "enum")

        found[gtk] = rule
        found[attributes.fetch("prop")] = rule
      end
    end
  end

  # A class's own writable props: the canonical kebab key, minus anything Gtk.Widget already
  # gives every component.
  def self.own_props(schema, shared)
    {}.tap do |found|
      schema.fetch("properties").each do |key, attributes|
        next unless attributes.fetch("writable")
        next if shared.key?(attributes.fetch("prop"))
        next unless key.include?("-") || key == attributes.fetch("prop")

        found[attributes.fetch("prop")] = attributes
      end
    end
  end

  # What a node is styled with on its own. The merged map answers most of them, and for the
  # rest -- a node libadwaita only ever addresses inside a context, like `windowcontrols` -- the
  # contexts do, which is the same fall back the modifiers use.
  def self.classes_for(nodes, widgets, contexts)
    nodes.to_a.each_with_object({}) do |node, found|
      own = widgets.fetch(node, nil) || self.addressed(node, contexts)

      own.each{|state, list| found[state] = found.fetch(state, []) | list}
    end
  end

  # The rules which address a node and nothing else about it: one segment, no style classes. A
  # rule which puts the node in a structure is that structure's styling and annotate() reports
  # it there.
  def self.addressed(node, contexts)
    own = contexts.select do |selector, _states|
      segments = self.segments(selector)
      element, classes = self.segment(segments.first.to_s)

      segments.length == 1 && element == node && classes.empty?
    end

    self.merged(own.values)
  end

  # A selector segment, split into the element it names and the classes on it. A rule may name
  # no element at all -- `.prefixes` rather than `box.prefixes` -- which matches any element.
  def self.segment(text)
    element = text[/\A[a-z][a-z0-9-]*/]
    classes = text.scan(/\.([a-z0-9-]+)/).flatten.to_set

    [element, classes]
  end

  # Whether a rule's segment addresses a node: the element has to agree where the rule names
  # one, and every class the rule asks for has to be on the node.
  def self.addresses?(rule, node)
    element, classes = self.segment(rule)
    node_element, node_classes = self.segment(node)

    (element.nil? || element == node_element) && classes.subset?(node_classes)
  end

  # A node's CSS path, which is how the stylesheet addresses it: `row > box.header > .prefixes`.
  #
  # THE CSS NODE NAME IS NOT THE CLASS NAME. AdwActionRow's node is `row`; AdwPreferencesGroup's
  # is nothing at all. The declared list knows the node for a component, so the root takes its
  # name from there and only the widgets inside a tree fall back to the class lowercased, which
  # is right for the primitives the trees are built out of -- box, label, image.
  def self.selector(node, name = nil)
    styles = node.fetch("styles", []).map{|style| ".#{style}"}.join

    "#{name || node.fetch('class').downcase}#{styles}"
  end

  # Every node in a tree, with the path it sits at and the classes that path is styled with.
  #
  # CONTEXTUALLY, NOT BY STYLE CLASS. `.title` on its own is whatever the stylesheet last said
  # about anything called that -- which for ActionRow meant a 136% font from the about dialog.
  # `row > box.header > box.title > label.title` is ActionRow's, and that is the rule that
  # applies.
  def self.annotate(node, ancestors, contexts, widgets, name = nil, own = nil)
    path = ancestors + [self.selector(node, name)]

    # The root is the component, whose classes are already merged per subject by
    # bin/03-adwaita-tailwind. Only the nodes inside the tree are addressed by path.
    classes = own || self.lookup(path, contexts, widgets)

    node.merge(
      "css" => path.join(" > "),
      "classes" => classes,
      "children" => node.fetch("children", []).map{|child| self.annotate(child, path, contexts, widgets)},
      "slots" => node.fetch("slots", {}).transform_values{|slot| self.annotate(slot, path, contexts, widgets)},
    ).reject{|_key, value| value.respond_to?(:empty?) && value.empty?}
  end

  # The rules which address this path: one whose segments are a suffix of it, matching loosely
  # so that a rule naming no element still applies. The longest match wins, being the most
  # specific.
  def self.lookup(path, contexts, widgets)
    matches = contexts.select do |selector, _states|
      segments = selector.split(">").map(&:strip)

      segments.length <= path.length &&
        path.last(segments.length).zip(segments).all?{|node, rule| self.addresses?(rule, node)}
    end

    if matches.empty?
      widgets.fetch(path.last, {})
    else
      matches.max_by{|selector, _states| selector.split(">").length}.last
    end
  end

  def self.each_node(node, &block)
    block.call(node)

    node.fetch("children", []).each{|child| self.each_node(child, &block)}
    node.fetch("slots", {}).each_value{|slot| self.each_node(slot, &block)}
  end
end

FinalComponents.run(ARGV)
