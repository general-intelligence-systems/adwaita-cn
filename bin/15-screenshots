#!/usr/bin/env ruby
# frozen_string_literal: true

# 15-SCREENSHOTS(1)                 General Commands Manual                  15-SCREENSHOTS(1)
#
# NAME
#      bin/15-screenshots — a picture of every example
#
# SYNOPSIS
#      bin/15-screenshots [--force] [--port PORT] [pattern ...]
#
# DESCRIPTION
#      Loads each example from examples/ into harness/index.html and photographs it, writing
#      screenshots/<component>/<variant>.png.
#
#      ONE PAGE, ONE BROWSER, 219 PICTURES. The harness bundles every example and renders the
#      one its fragment names, so each screenshot is a navigation and a clip rather than a page
#      load: the browser starts once and the bundle is built once.
#
#      The clip is the component rather than the viewport. harness.tsx sets `data-ready` on the
#      box once React has committed and the browser has laid the result out, and the screenshot
#      waits for that attribute rather than for a timeout.
#
#      With patterns, only the examples whose `<component>/<variant>` matches one of them are
#      taken, which is what to use while working on one component.
#
# OPTIONS
#      --force      Overwrite the screenshots which are already there.
#      --port       Serve the harness on this port rather than 4173.
#
# ENVIRONMENT
#      BROWSER_PATH
#              The browser to drive, which the devshell sets to its own chromium. Ferrum
#              otherwise searches PATH and takes whichever Chrome the machine has, which is how
#              a screenshot comes to depend on who took it.
#
# FILES
#      harness/index.html              the template each example is loaded into
#      examples/manifest.json          what to photograph, from 13
#      screenshots/<component>/<variant>.png   the output
#
# EXIT STATUS
#      The bin/15-screenshots utility exits 0 on success, and >0 if an error occurs.
#
# EXAMPLES
#      All of them:
#
#            bin/15-screenshots
#
#      One component, again:
#
#            bin/15-screenshots --force button/
#
# SEE ALSO
#      bin/13-generate-examples, ferrum(3)
#
# adwaita-cn                         October 12, 2026                        15-SCREENSHOTS(1)

require "ferrum"
require "fileutils"
require "json"
require "webrick"

module Screenshots
  ROOT = File.expand_path("..", __dir__)
  PORT = 4173

  # Big enough that nothing wraps against the edge. The clip is the component, so the window
  # only has to be larger than the largest example.
  WINDOW = [1400, 1200].freeze

  def self.run(argv)
    force = !argv.delete("--force").nil?
    port = (self.option(argv, "--port") || PORT).to_i
    manifest = JSON.parse(File.read(File.join(ROOT, "examples/manifest.json")))
    wanted = self.wanted(manifest.fetch("examples"), argv)

    self.build

    server = self.serve(port)

    begin
      self.photograph(wanted, port, force)
    ensure
      server.shutdown
    end
  end

  # The harness, bundled. Vite resolves the examples' imports and Tailwind compiles the classes
  # they name, neither of which a browser can do with the sources as they stand.
  def self.build
    warn("building the harness")

    unless system("pnpm", "exec", "vite", "build", "--config", "vite.harness.config.ts", chdir: ROOT)
      warn("screenshots: the harness did not build")
      exit(1)
    end
  end

  # A static server over the built harness, in a thread. Over a socket rather than file://,
  # which a browser refuses to load a module from.
  def self.serve(port)
    server = WEBrick::HTTPServer.new(
      BindAddress: "127.0.0.1",
      Port: port,
      DocumentRoot: File.join(ROOT, "harness/dist"),
      AccessLog: [],
      Logger: WEBrick::Log.new(File::NULL),
    )

    Thread.new{server.start}

    server
  end

  def self.photograph(wanted, port, force)
    browser = Ferrum::Browser.new(
      browser_path: ENV.fetch("BROWSER_PATH", nil),
      headless: true,
      window_size: WINDOW,
    )
    taken = 0
    skipped = 0

    begin
      wanted.each do |example|
        path = File.join(ROOT, "screenshots", "#{self.id(example)}.png")

        if File.exist?(path) && !force
          skipped += 1
          next
        end

        self.capture(browser, example, path, port)
        taken += 1
      end
    ensure
      browser.quit
    end

    puts("taken: #{taken}")
    puts("left alone: #{skipped}")
  end

  # One example, loaded into the template and clipped to its box.
  def self.capture(browser, example, path, port)
    id = self.id(example)

    browser.goto("http://127.0.0.1:#{port}/##{id}")

    node = self.ready(browser, id)

    FileUtils.mkdir_p(File.dirname(path))
    browser.screenshot(path: path, selector: %([data-ready="#{id}"]), scale: 2)

    node
  end

  # The box, once the harness says it has rendered. Navigating by fragment does not reload, so
  # the attribute is what distinguishes this example's render from the last one's.
  def self.ready(browser, id)
    50.times do
      node = browser.at_css(%([data-ready="#{id}"]))

      return node if node

      sleep(0.05)
    end

    warn("screenshots: #{id} never rendered")
    exit(1)
  end

  def self.id(example)
    variant = example["variant"] || "base"

    "#{self.kebab(example.fetch('component'))}/#{variant}"
  end

  def self.wanted(examples, patterns)
    if patterns.empty?
      examples
    else
      examples.select{|example| patterns.any?{|pattern| self.id(example).include?(pattern)}}
    end
  end

  def self.option(argv, name)
    index = argv.index(name)

    argv.slice!(index, 2).last if index
  end

  def self.kebab(name)
    name.gsub(/([a-z0-9])([A-Z])/, '\1-\2').downcase
  end
end

Screenshots.run(ARGV)
