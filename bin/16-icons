#!/usr/bin/env ruby
# frozen_string_literal: true

# 16-ICONS(1)                      General Commands Manual                      16-ICONS(1)
#
# NAME
#      bin/16-icons — extract Adwaita's icons and convert them into the icon package
#
# SYNOPSIS
#      bin/16-icons
#
# DESCRIPTION
#      One pass, two halves. It reads the symbolic icons bin/01-fetch-adwaita vendored,
#      normalises them into icons/, and generates packages/adwaita_react out of that.
#
#      EXTRACT. The vendored files are what three decades of icon authoring left behind:
#      Inkscape's sodipodi and RDF furniture, `<g>` wrappers carrying the fill their
#      children inherit, grappa's multi-state annotations, presentation stuffed into a
#      `style` attribute beside the attribute that means the same thing, font-family on a
#      path, and the theme's own hex in place of a colour the widget could set. Each icon is
#      rewritten: the tree is flattened, the furniture is dropped, the hardcoded foreground
#      becomes `currentColor`, strokes stay strokes, and the `-symbolic` suffix -- which
#      every icon in the set carries and so distinguishes nothing -- comes off the name and
#      is kept as an alias. Each icon is written twice, as a normalised SVG and as a JSON
#      sidecar of its metadata, which is the format lucide's build-icons takes.
#
#      CONVERT. That source becomes the component tree of packages/adwaita_react: one module
#      per icon holding its node data, an index, the three alias files, a module per alias,
#      and a map of dynamic imports. It is lucide's build-icons, in ruby and under bin/ with
#      the rest of the generators.
#
#      The icon node is the point of the format. An icon is not shipped as an SVG string
#      that has to be parsed or injected, but as the array a renderer can hand straight to
#      createElement:
#
#              ["path", {"fill": "currentColor", "d": "M8 0 ..."}]
#
#      which is what makes `size`, `color`, `className` and a ref ordinary props on the
#      component rather than string surgery on markup.
#
#      Two of the vendored icons are not symbolic icons and are skipped rather than mangled:
#      preferences-desktop-appearance-symbolic is a base64 PNG behind a feColorMatrix mask,
#      and devel-symbolic is a 64x64 gradient wedge. Both are reported on stderr.
#
# FILES
#      bin/01-fetch-adwaita.out/icons/*.svg   the vendored icons, as the theme ships them
#      icons/<name>.svg                       the normalised icon
#      icons/<name>.json                      its metadata
#      icon.schema.json                       what that metadata has to be
#      packages/adwaita_react/src/            the components
#
# EXIT STATUS
#      The bin/16-icons utility exits 0 on success, and >0 if an error occurs.
#
# SEE ALSO
#      bin/01-fetch-adwaita, bin/18-vendor-lucide
#
# adwaita-cn                        October 13, 2026                            16-ICONS(1)

require "rexml/document"
require "json"
require "base64"
require "fileutils"

module Icons
  ROOT = File.expand_path("..", __dir__)
  SOURCE = File.join(ROOT, "bin/01-fetch-adwaita.out/icons")
  OUTPUT = File.join(ROOT, "icons")
  PACKAGE = File.join(ROOT, "packages/adwaita_react/src")

  def self.call
    self.extract
    self.convert_all
  end


  # The shapes an icon node can be. Anything else in the tree is furniture: a <defs>, a
  # <metadata>, a grappa <style>, the <image> and <mask> of the one icon that is a bitmap.
  SHAPES = %w[path rect circle ellipse line polyline polygon].freeze

  # Groups are flattened rather than kept, so a group's presentation has to be resolved onto
  # the shapes inside it. These are the attributes that inherit; geometry does not.
  INHERITED = %w[
    fill fill-opacity fill-rule stroke stroke-width stroke-linecap stroke-linejoin
    stroke-dasharray stroke-opacity opacity paint-order
  ].freeze

  # What a shape is allowed to carry out of the vendored file. Everything else -- id, class,
  # overflow, font-family, the `-inkscape-font-specification` in a style, every gpa: -- is
  # dropped, because none of it draws anything.
  KEPT = (INHERITED + %w[
    d x y width height rx ry cx cy r points x1 y1 x2 y2 transform
  ]).freeze

  # `color` is dropped rather than inherited, and it is worth saying why, because it is the
  # one attribute whose junk value does damage. Inkscape writes `color="#bebebe"` and
  # `style="color:#000"` onto paths that never reference it -- but `currentColor` resolves
  # against `color`, so carrying it through would quietly repaint every icon that has it the
  # colour Inkscape happened to leave behind instead of the widget's.
  DROPPED = %w[color].freeze

  # The theme's foreground, hardcoded. A symbolic icon has no business naming a colour, so
  # each of these becomes currentColor. `foreground` and the url() are grappa's spelling of
  # the same thing.
  FOREGROUND = [
    "#2e3436", "#2e3434", "#2d3336", "#474747", "#222222", "#000000", "#bebebe",
    "rgb(0,0,0)", "foreground",
  ].freeze

  # The colours that mean something. A battery at 0% is red because it is urgent, not because
  # the theme is, so these are kept rather than handed to the widget, and the icon is marked
  # as not monochrome.
  #
  # This is decided by the colour and not by the `class="error"` the set also carries, because
  # the class is not reliable: battery-level-100-plugged-in has `class="success"` on a path
  # painted the ordinary foreground grey, and trusting the class there would leave a
  # hardcoded #2e3434 in an icon that should take the widget's colour.
  STATUS = %w[#33d17a #ff7800 #e01b24 #ed333b].freeze

  # The icons that are not icons. Converting these would mean inventing them.
  UNCONVERTIBLE = {
    "preferences-desktop-appearance-symbolic" =>
      "a base64 PNG behind an feColorMatrix mask, not vector geometry",
    "devel-symbolic" => "a 64x64 gradient wedge, not a 16x16 symbolic icon",
  }.freeze

  # The root attributes every written icon carries, and the defaults the package repeats in
  # its own defaultAttributes. Adwaita is 16px and filled where lucide is 24px and stroked.
  ROOT_ATTRIBUTES = {
    "xmlns" => "http://www.w3.org/2000/svg",
    "width" => "16",
    "height" => "16",
    "viewBox" => "0 0 16 16",
    "fill" => "currentColor",
  }.freeze

  # ── extract: the vendored SVGs, normalised into icons/ ──────────────────

  def self.extract
    FileUtils.mkdir_p(OUTPUT)
    Dir.glob(File.join(OUTPUT, "*.{svg,json}")).each{|stale| File.delete(stale) }

    written = {}
    skipped = []

    Dir.glob(File.join(SOURCE, "*.svg")).sort.each do |path|
      source = File.basename(path, ".svg")

      if UNCONVERTIBLE.key?(source)
        skipped << [source, UNCONVERTIBLE.fetch(source)]
        next
      end

      icon = self.convert(path, source)

      if icon.nil?
        skipped << [source, "no geometry survived normalisation"]
        next
      end

      name = self.icon_name(source)

      if written.key?(name)
        raise "#{source} and #{written.fetch(name)} both normalise to #{name}"
      end

      written[name] = source

      File.write(File.join(OUTPUT, "#{name}.svg"), self.render(icon))
      File.write(File.join(OUTPUT, "#{name}.json"), self.sidecar(icon, source))
    end

    self.write_schema

    $stderr.puts("Skipped #{skipped.length} icons:") unless skipped.empty?
    skipped.each{|source, reason| $stderr.puts("  #{source}: #{reason}") }
    puts("Successfully extracted #{written.length} icons into icons/.")
  end

  # An icon, as the shapes it draws plus what the file said about itself. Returns nil when
  # nothing drawable is left, which is how a file that is all furniture is caught.
  def self.convert(path, source)
    document = REXML::Document.new(File.read(path))
    root = document.root

    shapes = self.flatten(root, {})
    return nil if shapes.empty?

    {
      shapes: shapes,
      monochrome: shapes.none?{|shape| shape[:status] },
      view_box: self.view_box(root),
      tags: self.tags(root),
      contributors: self.contributors(root),
      source: source,
    }
  end

  # Walk the tree, carrying each group's inherited presentation down to the shapes under it,
  # and come back with a flat list. A group is only ever a fill in this set, but nesting is
  # cheap to handle and the alternative is silently dropping whatever it holds.
  def self.flatten(element, inherited, transforms = [])
    element.elements.flat_map do |child|
      name = child.expanded_name

      # The attributes this element contributes, with `style` folded in. CSS says a style
      # declaration beats the presentation attribute spelling the same property, and the
      # vendored files rely on it: a path with `fill="#2e3434"` and
      # `style="fill:#33d17a;fill-opacity:1"` is green.
      own = inherited.merge(self.presentation(child))

      # A group's transform has to come with it. Dropping it is not a cosmetic loss: Inkscape
      # leaves the drawing where it sat on its canvas and puts the translation back on the
      # group, so battery-level-100-plugged-in draws at x=687 inside two groups translated by
      # (-620,-180) and (-62), and flattening the groups without their transforms would move
      # it 682 units off a 16-unit viewBox -- a blank icon, not a wrong one.
      #
      # They compose by concatenation rather than by multiplying matrices out, because that is
      # what a transform list already means: `transform="a b"` applies a then b, which is
      # exactly what nesting b inside a does.
      nested = transforms + [child.attributes["transform"]].compact

      if name == "g"
        self.flatten(child, own, nested)
      elsif SHAPES.include?(name)
        [self.shape(name, child, own, transforms)]
      else
        # <defs>, <metadata>, <style>, <mask>, <clipPath>, <filter>, <image>, sodipodi:*.
        []
      end
    end
  end

  # One shape, as the tag and the attributes it keeps, with its colour resolved and whatever
  # transforms it inherited folded into its own.
  def self.shape(name, element, inherited, transforms)
    attributes = inherited.merge(self.geometry(element))
    composed = (transforms + [attributes["transform"]].compact).join(" ")
    attributes = attributes.merge("transform" => composed).reject{|_, value| value == "" }

    recoloured = self.recolour(attributes.slice(*KEPT))

    {
      tag: name,
      attributes: recoloured,
      status: recoloured.values_at("fill", "stroke").compact.any?{|paint| STATUS.include?(paint) },
    }
  end

  # The presentation half of an element's attributes, which is what inherits.
  def self.presentation(element)
    declared = element.attributes.each_attribute.to_h{|attribute| [attribute.expanded_name, attribute.value] }
    declared.slice(*INHERITED).merge(self.style(element.attributes["style"]))
  end

  # The geometry half, which does not inherit and so is read off the shape itself.
  def self.geometry(element)
    declared = element.attributes.each_attribute.to_h{|attribute| [attribute.expanded_name, attribute.value] }
    declared.slice(*(KEPT - INHERITED))
  end

  # A `style` attribute as the properties it sets, keeping only the ones that are also
  # presentation attributes. The rest of what Inkscape put there -- line-height, text-indent,
  # `-inkscape-font-specification` -- describes text, and there is no text in an icon.
  def self.style(declaration)
    return {} if declaration.nil?

    declaration.split(";").filter_map do |property|
      key, value = property.split(":", 2)
      next if value.nil?

      key = key.strip
      next unless INHERITED.include?(key)

      [key, value.strip]
    end.to_h
  end

  # The colour, resolved. A status icon keeps what it was given; everything else hands its
  # colour back to whatever draws it.
  def self.recolour(attributes)
    attributes.to_h do |key, value|
      if !%w[fill stroke].include?(key) || value == "none"
        [key, value]
      else
        # grappa writes a paint server and a fallback together:
        # `url(#gpa:foreground) rgb(0,0,0)`. Either half of it means the foreground.
        [key, self.foreground?(value) ? "currentColor" : self.expand(value)]
      end
    end
  end

  def self.foreground?(value)
    FOREGROUND.include?(self.expand(value)) || value.include?("gpa:foreground")
  end

  # `#222` and `#222222` are the same colour, and the set writes both, so a paint is compared
  # and written in one spelling.
  def self.expand(value)
    normalised = value.strip.downcase
    short = normalised.match(/\A#(\h)(\h)(\h)\z/)
    short ? "##{short[1] * 2}#{short[2] * 2}#{short[3] * 2}" : normalised
  end

  # The viewBox to write. 98 of the vendored files have none at all (grappa gives width and
  # height only), and ten have one that missed 16 by a rounding error -- `0 0 15.984375 16`.
  # Every icon in the set is a 16px grid, so that is what is written.
  def self.view_box(root)
    declared = root.attributes["viewBox"]
    return "0 0 16 16" if declared.nil?

    numbers = declared.split(/[\s,]+/).map(&:to_f)
    return "0 0 16 16" unless numbers.length == 4

    rounded = numbers.map{|number| number.round }
    rounded == [0, 0, 16, 16] ? "0 0 16 16" : declared
  end

  # What the icon says it is for. Adwaita's RDF carries a `dc:subject` bag of keywords, which
  # is the same thing lucide's `tags` is, so it is worth keeping rather than regenerating.
  def self.tags(root)
    REXML::XPath.match(root, ".//rdf:li", "rdf" => "http://www.w3.org/1999/02/22-rdf-syntax-ns#")
      .flat_map{|node| node.text.to_s.split }
      .map(&:strip)
      .reject(&:empty?)
      .uniq
      .sort
  end

  # Who drew it. The same field lucide's `contributors` is, and the same reason to keep it.
  def self.contributors(root)
    REXML::XPath.match(root, ".//cc:Agent/dc:title",
      "cc" => "http://creativecommons.org/ns#",
      "dc" => "http://purl.org/dc/elements/1.1/")
      .map{|node| node.text.to_s.strip }
      .reject(&:empty?)
      .uniq
  end

  # The name the icon is published under. Every icon is `-symbolic`, so the suffix is noise;
  # the direction suffix is not, because `-rtl` is a different drawing.
  def self.icon_name(source)
    source.sub(/-symbolic(?=(-rtl|-ltr)?\z)/, "")
  end

  # The icon, as the SVG lucide's build-icons reads: root attributes, then one shape a line.
  # Written in lucide's own formatting, because that is the format being copied.
  def self.render(icon)
    attributes = ROOT_ATTRIBUTES.merge("viewBox" => icon.fetch(:view_box))
    header = attributes.map{|key, value| "  #{key}=\"#{value}\"" }.join("\n")

    shapes = icon.fetch(:shapes).map do |shape|
      pairs = shape.fetch(:attributes).map{|key, value| " #{key}=\"#{value}\"" }.join
      "  <#{shape.fetch(:tag)}#{pairs} />"
    end

    "<svg\n#{header}\n>\n#{shapes.join("\n")}\n</svg>\n"
  end

  # The sidecar, which is lucide's icon JSON plus the two things an Adwaita icon knows that a
  # lucide icon does not: the name GTK calls it, and whether it is really one colour.
  def self.sidecar(icon, source)
    JSON.pretty_generate({
      "$schema" => "../icon.schema.json",
      "contributors" => icon.fetch(:contributors),
      "tags" => icon.fetch(:tags),
      "categories" => [],
      "gtkIconName" => source,
      "monochrome" => icon.fetch(:monochrome),
      "aliases" => [{"name" => source}],
    }) + "\n"
  end

  # The schema the sidecars point at, so the generated tree validates on its own terms.
  def self.write_schema
    schema = {
      "$id" => "https://github.com/async-matrix/adwaita-cn/icon.schema.json",
      "$schema" => "https://json-schema.org/draft/2020-12/schema",
      "title" => "Adwaita icon schema",
      "type" => "object",
      "additionalProperties" => false,
      "required" => ["$schema", "contributors", "tags", "categories", "gtkIconName", "monochrome"],
      "properties" => {
        "$schema" => {"type" => "string"},
        "contributors" => {"type" => "array", "items" => {"type" => "string"}},
        "tags" => {"type" => "array", "items" => {"type" => "string"}},
        "categories" => {"type" => "array", "items" => {"type" => "string"}},
        "gtkIconName" => {
          "type" => "string",
          "description" => "The name GTK draws this icon by, which is what an `icon-name` property holds.",
        },
        "monochrome" => {
          "type" => "boolean",
          "description" => "False for the status icons, whose colour is part of what they mean.",
        },
        "aliases" => {
          "type" => "array",
          "items" => {
            "type" => "object",
            "additionalProperties" => false,
            "required" => ["name"],
            "properties" => {
              "name" => {"type" => "string"},
              "deprecated" => {"const" => true},
              "deprecationReason" => {"type" => "string"},
            },
          },
        },
      },
    }

    File.write(File.join(ROOT, "icon.schema.json"), JSON.pretty_generate(schema) + "\n")
  end


  # Every icon is drawn on the 16px grid GTK draws a symbolic icon on, which is what the
  # package's defaultAttributes says too.
  SIZE = 16

  HEADER = "// Generated by bin/16-icons. Do not edit.\n"

  # ── convert: icons/ into the package's components ───────────────────────

  def self.convert_all
    icons = Dir.glob(File.join(OUTPUT, "*.svg")).sort.map{|path| self.read(path) }
    raise "nothing was extracted into icons/" if icons.empty?

    FileUtils.mkdir_p(File.join(PACKAGE, "icons"))
    FileUtils.mkdir_p(File.join(PACKAGE, "aliases"))

    Dir.glob(File.join(PACKAGE, "icons/*.ts")).each{|stale| File.delete(stale) }

    # Two icon names can flatten to one identifier once the punctuation is dropped, and a
    # duplicate `export { default as X }` is a module that does not compile rather than a
    # component that is subtly wrong -- but it would be found at the end of a build and not
    # here, so it is checked here.
    self.check_collisions(icons)

    icons.each do |icon|
      File.write(File.join(PACKAGE, "icons/#{icon.fetch(:name)}.ts"), self.component(icon))
    end

    # An alias is a module of its own which re-exports the icon, which is what lucide's
    # `--separateAliasesFile` does: `icons/window-close-symbolic.ts` beside
    # `icons/window-close.ts`, so a dynamic import of either name resolves to a file.
    icons.each do |icon|
      icon.fetch(:aliases).each do |alias_|
        File.write(File.join(PACKAGE, "icons/#{alias_}.ts"),
                   "export { default } from \"./#{icon.fetch(:name)}\";\n")
      end
    end

    File.write(File.join(PACKAGE, "icons/index.ts"), self.index(icons))
    File.write(File.join(PACKAGE, "aliases/aliases.ts"), self.aliases(icons))
    File.write(File.join(PACKAGE, "aliases/prefixed.ts"), self.prefixed(icons))
    File.write(File.join(PACKAGE, "aliases/suffixed.ts"), self.suffixed(icons))
    File.write(File.join(PACKAGE, "dynamicIconImports.ts"), self.dynamic_imports(icons))

    puts("Successfully generated #{icons.length} icon components.")
  end

  # Every name the package exports has to be unique, across the icons and their aliases
  # alike, because they are all exported from the one module.
  def self.check_collisions(icons)
    seen = {}

    icons.each do |icon|
      name = icon.fetch(:name)

      ([name] + icon.fetch(:aliases)).each do |key|
        component = self.pascal_case(key)
        taken = seen[component]

        raise "#{key} and #{taken} both export as #{component}" if taken && taken != name

        seen[component] = name
      end
    end
  end

  # One icon, as the node a renderer draws plus the sidecar's metadata.
  def self.read(path)
    name = File.basename(path, ".svg")
    svg = File.read(path)
    document = REXML::Document.new(svg)

    node = document.root.elements.filter_map do |element|
      next unless SHAPES.include?(element.expanded_name)

      attributes = element.attributes.each_attribute.to_h do |attribute|
        [attribute.expanded_name, attribute.value]
      end

      [element.expanded_name, attributes]
    end

    # React needs a stable key on each child, because a node is rendered as a list. The key is
    # a hash of the shape rather than its index, so reordering an icon's paths does not
    # invalidate the others -- which is what lucide's --renderUniqueKey does, and the same
    # djb2 hash it does it with.
    node = node.map{|tag, attributes| [tag, attributes.merge("key" => self.hashed_key(tag, attributes))] }

    raise "#{name}.svg has no shapes" if node.empty?

    sidecar = JSON.parse(File.read(File.join(OUTPUT, "#{name}.json")))

    {
      name: name,
      node: node,
      svg: svg,
      gtk_icon_name: sidecar["gtkIconName"],
      monochrome: sidecar.fetch("monochrome", true),
      aliases: (sidecar["aliases"] || []).map{|alias_| alias_.fetch("name") }.reject{|alias_| alias_ == name },
    }
  end

  # djb2, over the shape's tag and attributes, in the 32-bit arithmetic JavaScript does it in:
  # a multiply that would overflow is truncated to int32 by the xor that follows it.
  def self.hashed_key(tag, attributes)
    seed = JSON.generate([tag, attributes]).each_char.reverse_each.reduce(5381) do |accumulator, char|
      self.int32(accumulator * 33) ^ char.ord
    end

    (seed % (1 << 32)).to_s(36)[0, 6]
  end

  def self.int32(number)
    truncated = number % (1 << 32)

    truncated >= (1 << 31) ? truncated - (1 << 32) : truncated
  end

  # The icon data a component is built from. `monochrome` is only carried when it is false,
  # because monochrome is the rule and the flag is only worth the bytes on the status icons
  # that break it.
  def self.icon_data(icon)
    data = {
      "name" => icon.fetch(:name),
      "size" => SIZE,
      "node" => icon.fetch(:node),
    }

    data["aliases"] = icon.fetch(:aliases) unless icon.fetch(:aliases).empty?
    data["gtkIconName"] = icon.fetch(:gtk_icon_name) if icon.fetch(:gtk_icon_name)
    data["monochrome"] = false unless icon.fetch(:monochrome)

    data
  end

  def self.component(icon)
    name = icon.fetch(:name)
    component = self.pascal_case(name)
    preview = Base64.strict_encode64(icon.fetch(:svg).gsub(/\s+/, " ").gsub('"', "'").strip)

    <<~TYPESCRIPT
      import createAdwaitaIcon from '../createAdwaitaIcon';
      import type { AdwaitaIconNode, AdwaitaIconData } from '../types';

      export const __iconData: AdwaitaIconData = #{JSON.generate(self.icon_data(icon))};

      /**
       * @deprecated Access `__iconData` instead.
       */
      export const __iconNode: AdwaitaIconNode[] = __iconData.node;

      /**
       * @component @name #{component}
       * @description Adwaita SVG icon component, renders SVG Element with children.
       *
       * @preview ![img](data:image/svg+xml;base64,#{preview})
       * @gtk `#{icon.fetch(:gtk_icon_name) || name}` -- the name GTK draws this icon by.
       *
       * @param {Object} props - Adwaita icons props and any valid SVG attribute
       * @returns {JSX.Element} JSX Element
       */
      const #{component} = createAdwaitaIcon(__iconData);

      export default #{component};
    TYPESCRIPT
  end

  def self.index(icons)
    header = "// Generated by bin/16-icons. Do not edit.\n"

    icons.map do |icon|
      name = icon.fetch(:name)
      "export { default as #{self.pascal_case(name)} } from './#{name}';\n"
    end.unshift(header).join
  end

  # The alias files lucide's build writes, in the shape it writes them.
  #
  # `aliases.ts` is every icon under the name GTK calls it -- the spelling that matters,
  # because a port reading `icon-name` out of a .ui file has `ac-adapter-symbolic` and not
  # `ac-adapter`. `prefixed.ts` and `suffixed.ts` are lucide's two collision-free
  # spellings, `AdwaitaAcAdapter` and `AcAdapterIcon`, which exist because a component
  # called `Image` or `Label` collides with half the registry.
  def self.aliases(icons)
    icons.flat_map do |icon|
      component = self.pascal_case(icon.fetch(:name))

      icon.fetch(:aliases).filter_map do |alias_|
        next if self.pascal_case(alias_) == component

        self.export_string(self.pascal_case(alias_), alias_)
      end
    end.unshift(HEADER).join
  end

  def self.prefixed(icons) = self.spelled(icons){|component| "Adwaita#{component}" }
  def self.suffixed(icons) = self.spelled(icons){|component| "#{component}Icon" }

  def self.spelled(icons)
    icons.map do |icon|
      component = self.pascal_case(icon.fetch(:name))

      "// #{component} aliases\n#{self.export_string(yield(component), icon.fetch(:name))}"
    end.unshift(HEADER).join
  end

  def self.export_string(component, file) = "export { default as #{component} } from '../icons/#{file}';\n"

  def self.dynamic_imports(icons)
    entries = icons.flat_map do |icon|
      name = icon.fetch(:name)

      ([name] + icon.fetch(:aliases)).map do |key|
        "  '#{key}': () => import('./icons/#{name}'),\n"
      end
    end

    "// Generated by bin/16-icons. Do not edit.\n" \
      "const dynamicIconImports = {\n#{entries.join}};\n\nexport default dynamicIconImports;\n"
  end

  # `ac-adapter` is `AcAdapter`, and `battery-level-0` is `BatteryLevel0`.
  #
  # The split is on anything that is not alphanumeric rather than on the hyphen, because an
  # icon name is a GTK icon name and not an identifier: `application-rss+xml-symbolic` is a
  # real icon in the set, and splitting it on hyphens alone leaves a `+` in the middle of
  # `ApplicationRss+xml`, which is a syntax error rather than a component.
  def self.pascal_case(name)
    pascal = name.split(/[^A-Za-z0-9]+/).reject(&:empty?).map{|part| part.sub(/\A./, &:upcase) }.join

    # A digit cannot start an identifier, so a name that begins with one is prefixed.
    pascal.match?(/\A[A-Za-z]/) ? pascal : "Icon#{pascal}"
  end
end

Icons.call
