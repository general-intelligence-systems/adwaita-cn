#!/usr/bin/env ruby
# frozen_string_literal: true

# 17-GENERATE-ICONS(1)             General Commands Manual              17-GENERATE-ICONS(1)
#
# NAME
#      bin/17-generate-icons — generate the adwaita_react icon components from icons/
#
# SYNOPSIS
#      bin/17-generate-icons
#
# DESCRIPTION
#      Reads the icon source bin/16-extract-icons writes -- icons/<name>.svg beside
#      icons/<name>.json -- and generates the component tree of packages/adwaita_react. It is
#      lucide's build-icons, in ruby and under bin/ with the rest of the generators: one
#      module per icon holding that icon's node data, an index that re-exports them, an
#      aliases entry, and a map of dynamic imports.
#
#      The icon node is the point of the format. An icon is not shipped as an SVG string that
#      has to be parsed or injected, but as the array a renderer can hand straight to
#      createElement:
#
#              ["path", {"fill": "currentColor", "d": "M8 0 ..."}]
#
#      which is what makes `size`, `color`, `className` and a ref ordinary props on the
#      component rather than string surgery on markup.
#
#      Four kinds of file are written into packages/adwaita_react/src/:
#
#      icons/<name>.ts
#              One per icon. Exports `__iconData` -- the name, the 16px size, the node, the
#              aliases, the GTK icon name, and `monochrome: false` where it applies -- and a
#              component built from it. The doc comment carries the icon base64-encoded, so an
#              editor draws it on hover.
#
#      icons/index.ts
#              `export { default as AcAdapter } from './ac-adapter'`, once per icon.
#
#      aliases/aliases.ts
#              Every icon again under the name GTK calls it -- `AcAdapterSymbolic` -- and
#              under an `Icon`-suffixed name, which is the spelling that avoids collisions
#              with a component of the same name.
#
#      dynamicIconImports.ts
#              `{ "ac-adapter": () => import("./icons/ac-adapter"), ... }`, keyed by both our
#              name and the GTK one. This is what DynamicIcon reads, and the reason it exists:
#              a widget names its icon at runtime, so `icon-name="view-refresh-symbolic"` out
#              of a .ui file has to resolve to a module without a bundler having seen the
#              string.
#
#      The generated files are not committed; they are build output, the way lucide's
#      src/icons/ is. bin/16-extract-icons produces the source they are generated from.
#
# FILES
#      packages/adwaita_react/src/icons/*.ts
#      packages/adwaita_react/src/icons/index.ts
#      packages/adwaita_react/src/aliases/aliases.ts
#      packages/adwaita_react/src/dynamicIconImports.ts
#
# EXIT STATUS
#      The bin/17-generate-icons utility exits 0 on success, and >0 if an error occurs.
#
# SEE ALSO
#      bin/16-extract-icons, packages/adwaita_react
#
# async-matrix                          October 13, 2026                  17-GENERATE-ICONS(1)

require "rexml/document"
require "json"
require "base64"
require "fileutils"

module GenerateIcons
  ROOT = File.expand_path("..", __dir__)
  ICONS = File.join(ROOT, "icons")
  PACKAGE = File.join(ROOT, "packages/adwaita_react/src")

  # Every icon is drawn on the 16px grid GTK draws a symbolic icon on, which is what the
  # package's defaultAttributes says too.
  SIZE = 16

  HEADER = "// Generated by bin/17-generate-icons. Do not edit.\n"

  # The shapes an icon node can hold, which is what bin/16 leaves behind.
  SHAPES = %w[path rect circle ellipse line polyline polygon].freeze

  def self.call
    icons = Dir.glob(File.join(ICONS, "*.svg")).sort.map{|path| self.read(path) }
    raise "No icons in icons/. Run bin/16-extract-icons first." if icons.empty?

    FileUtils.mkdir_p(File.join(PACKAGE, "icons"))
    FileUtils.mkdir_p(File.join(PACKAGE, "aliases"))

    Dir.glob(File.join(PACKAGE, "icons/*.ts")).each{|stale| File.delete(stale) }

    # Two icon names can flatten to one identifier once the punctuation is dropped, and a
    # duplicate `export { default as X }` is a module that does not compile rather than a
    # component that is subtly wrong -- but it would be found at the end of a build and not
    # here, so it is checked here.
    self.check_collisions(icons)

    icons.each do |icon|
      File.write(File.join(PACKAGE, "icons/#{icon.fetch(:name)}.ts"), self.component(icon))
    end

    # An alias is a module of its own which re-exports the icon, which is what lucide's
    # `--separateAliasesFile` does: `icons/window-close-symbolic.ts` beside
    # `icons/window-close.ts`, so a dynamic import of either name resolves to a file.
    icons.each do |icon|
      icon.fetch(:aliases).each do |alias_|
        File.write(File.join(PACKAGE, "icons/#{alias_}.ts"),
                   "export { default } from \"./#{icon.fetch(:name)}\";\n")
      end
    end

    File.write(File.join(PACKAGE, "icons/index.ts"), self.index(icons))
    File.write(File.join(PACKAGE, "aliases/aliases.ts"), self.aliases(icons))
    File.write(File.join(PACKAGE, "aliases/prefixed.ts"), self.prefixed(icons))
    File.write(File.join(PACKAGE, "aliases/suffixed.ts"), self.suffixed(icons))
    File.write(File.join(PACKAGE, "dynamicIconImports.ts"), self.dynamic_imports(icons))

    puts("Successfully generated #{icons.length} icon components.")
  end

  # Every name the package exports has to be unique, across the icons and their aliases
  # alike, because they are all exported from the one module.
  def self.check_collisions(icons)
    seen = {}

    icons.each do |icon|
      name = icon.fetch(:name)

      ([name] + icon.fetch(:aliases)).each do |key|
        component = self.pascal_case(key)
        taken = seen[component]

        raise "#{key} and #{taken} both export as #{component}" if taken && taken != name

        seen[component] = name
      end
    end
  end

  # One icon, as the node a renderer draws plus the sidecar's metadata.
  def self.read(path)
    name = File.basename(path, ".svg")
    svg = File.read(path)
    document = REXML::Document.new(svg)

    node = document.root.elements.filter_map do |element|
      next unless SHAPES.include?(element.expanded_name)

      attributes = element.attributes.each_attribute.to_h do |attribute|
        [attribute.expanded_name, attribute.value]
      end

      [element.expanded_name, attributes]
    end

    # React needs a stable key on each child, because a node is rendered as a list. The key is
    # a hash of the shape rather than its index, so reordering an icon's paths does not
    # invalidate the others -- which is what lucide's --renderUniqueKey does, and the same
    # djb2 hash it does it with.
    node = node.map{|tag, attributes| [tag, attributes.merge("key" => self.hashed_key(tag, attributes))] }

    raise "#{name}.svg has no shapes" if node.empty?

    sidecar = JSON.parse(File.read(File.join(ICONS, "#{name}.json")))

    {
      name: name,
      node: node,
      svg: svg,
      gtk_icon_name: sidecar["gtkIconName"],
      monochrome: sidecar.fetch("monochrome", true),
      aliases: (sidecar["aliases"] || []).map{|alias_| alias_.fetch("name") }.reject{|alias_| alias_ == name },
    }
  end

  # djb2, over the shape's tag and attributes, in the 32-bit arithmetic JavaScript does it in:
  # a multiply that would overflow is truncated to int32 by the xor that follows it.
  def self.hashed_key(tag, attributes)
    seed = JSON.generate([tag, attributes]).each_char.reverse_each.reduce(5381) do |accumulator, char|
      self.int32(accumulator * 33) ^ char.ord
    end

    (seed % (1 << 32)).to_s(36)[0, 6]
  end

  def self.int32(number)
    truncated = number % (1 << 32)

    truncated >= (1 << 31) ? truncated - (1 << 32) : truncated
  end

  # The icon data a component is built from. `monochrome` is only carried when it is false,
  # because monochrome is the rule and the flag is only worth the bytes on the status icons
  # that break it.
  def self.icon_data(icon)
    data = {
      "name" => icon.fetch(:name),
      "size" => SIZE,
      "node" => icon.fetch(:node),
    }

    data["aliases"] = icon.fetch(:aliases) unless icon.fetch(:aliases).empty?
    data["gtkIconName"] = icon.fetch(:gtk_icon_name) if icon.fetch(:gtk_icon_name)
    data["monochrome"] = false unless icon.fetch(:monochrome)

    data
  end

  def self.component(icon)
    name = icon.fetch(:name)
    component = self.pascal_case(name)
    preview = Base64.strict_encode64(icon.fetch(:svg).gsub(/\s+/, " ").gsub('"', "'").strip)

    <<~TYPESCRIPT
      import createAdwaitaIcon from '../createAdwaitaIcon';
      import type { AdwaitaIconNode, AdwaitaIconData } from '../types';

      export const __iconData: AdwaitaIconData = #{JSON.generate(self.icon_data(icon))};

      /**
       * @deprecated Access `__iconData` instead.
       */
      export const __iconNode: AdwaitaIconNode[] = __iconData.node;

      /**
       * @component @name #{component}
       * @description Adwaita SVG icon component, renders SVG Element with children.
       *
       * @preview ![img](data:image/svg+xml;base64,#{preview})
       * @gtk `#{icon.fetch(:gtk_icon_name) || name}` -- the name GTK draws this icon by.
       *
       * @param {Object} props - Adwaita icons props and any valid SVG attribute
       * @returns {JSX.Element} JSX Element
       */
      const #{component} = createAdwaitaIcon(__iconData);

      export default #{component};
    TYPESCRIPT
  end

  def self.index(icons)
    header = "// Generated by bin/17-generate-icons. Do not edit.\n"

    icons.map do |icon|
      name = icon.fetch(:name)
      "export { default as #{self.pascal_case(name)} } from './#{name}';\n"
    end.unshift(header).join
  end

  # The alias files lucide's build writes, in the shape it writes them.
  #
  # `aliases.ts` is every icon under the name GTK calls it -- the spelling that matters,
  # because a port reading `icon-name` out of a .ui file has `ac-adapter-symbolic` and not
  # `ac-adapter`. `prefixed.ts` and `suffixed.ts` are lucide's two collision-free
  # spellings, `AdwaitaAcAdapter` and `AcAdapterIcon`, which exist because a component
  # called `Image` or `Label` collides with half the registry.
  def self.aliases(icons)
    icons.flat_map do |icon|
      component = self.pascal_case(icon.fetch(:name))

      icon.fetch(:aliases).filter_map do |alias_|
        next if self.pascal_case(alias_) == component

        self.export_string(self.pascal_case(alias_), alias_)
      end
    end.unshift(HEADER).join
  end

  def self.prefixed(icons) = self.spelled(icons){|component| "Adwaita#{component}" }
  def self.suffixed(icons) = self.spelled(icons){|component| "#{component}Icon" }

  def self.spelled(icons)
    icons.map do |icon|
      component = self.pascal_case(icon.fetch(:name))

      "// #{component} aliases\n#{self.export_string(yield(component), icon.fetch(:name))}"
    end.unshift(HEADER).join
  end

  def self.export_string(component, file) = "export { default as #{component} } from '../icons/#{file}';\n"

  def self.dynamic_imports(icons)
    entries = icons.flat_map do |icon|
      name = icon.fetch(:name)

      ([name] + icon.fetch(:aliases)).map do |key|
        "  '#{key}': () => import('./icons/#{name}'),\n"
      end
    end

    "// Generated by bin/17-generate-icons. Do not edit.\n" \
      "const dynamicIconImports = {\n#{entries.join}};\n\nexport default dynamicIconImports;\n"
  end

  # `ac-adapter` is `AcAdapter`, and `battery-level-0` is `BatteryLevel0`.
  #
  # The split is on anything that is not alphanumeric rather than on the hyphen, because an
  # icon name is a GTK icon name and not an identifier: `application-rss+xml-symbolic` is a
  # real icon in the set, and splitting it on hyphens alone leaves a `+` in the middle of
  # `ApplicationRss+xml`, which is a syntax error rather than a component.
  def self.pascal_case(name)
    pascal = name.split(/[^A-Za-z0-9]+/).reject(&:empty?).map{|part| part.sub(/\A./, &:upcase) }.join

    # A digit cannot start an identifier, so a name that begins with one is prefixed.
    pascal.match?(/\A[A-Za-z]/) ? pascal : "Icon#{pascal}"
  end
end

GenerateIcons.call
