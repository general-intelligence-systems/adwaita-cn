#!/usr/bin/env ruby
# frozen_string_literal: true

# 04-GTK-TAILWIND(1)                General Commands Manual                 04-GTK-TAILWIND(1)
#
# NAME
#      bin/04-gtk-tailwind — GTK's own theme, for the widgets libadwaita leaves alone
#
# SYNOPSIS
#      bin/04-gtk-tailwind [--contexts] [--all] [pattern ...]
#
# DESCRIPTION
#      Runs bin/03-adwaita-tailwind over GTK's Default theme instead of libadwaita's stylesheet,
#      and keeps only the nodes libadwaita never styles.
#
#      Output is the same shape as bin/03-adwaita-tailwind's and the options mean the same
#      things, so the join reads whichever has an answer for a node, preferring Adwaita's.
#
# OPTIONS
#      --contexts   Key by each selector context separately rather than merging them.
#      --all        Include widgets styled by a single declaration.
#
# FILES
#      bin/01-fetch-adwaita.out/gtk-default-light.css   the input
#      bin/03-adwaita-tailwind.out/widgets-contexts.json   what libadwaita already answers, from 03
#      bin/04-gtk-tailwind.out/gtk-widgets.json        the output
#
# EXIT STATUS
#      The bin/04-gtk-tailwind utility exits 0 on success, and >0 if an error occurs.
#
# EXAMPLES
#      The map, and the contexts beside it:
#
#            bin/04-gtk-tailwind > bin/04-gtk-tailwind.out/gtk-widgets.json
#            bin/04-gtk-tailwind --contexts --all > bin/04-gtk-tailwind.out/gtk-widgets-contexts.json
#
#      What GTK styles and libadwaita does not:
#
#            bin/04-gtk-tailwind | jq 'keys'
#
# SEE ALSO
#      bin/03-adwaita-tailwind, bin/08-final-components
#
# adwaita-cn                         October 12, 2026                       04-GTK-TAILWIND(1)

require "json"
require "set"

module GtkTailwind
  # GTK's sheet as bin/03-adwaita-tailwind converted it, and the name each reading is
  # kept under here once the selectors libadwaita answers have been taken out.
  GTK = {
    "gtk-widgets.json" => "bin/03-adwaita-tailwind.out/gtk-widgets.json",
    "gtk-widgets-contexts.json" => "bin/03-adwaita-tailwind.out/gtk-widgets-contexts.json",
  }.freeze

  ADWAITA = "bin/03-adwaita-tailwind.out/widgets-contexts.json"

  # The converter, over GTK's sheet. It is the same code either way, which is the point: the
  # sheets differ, the conversion does not.
  # GTK's sheet, already converted by bin/03-adwaita-tailwind. This pass reads that file
  # and keeps what libadwaita never answers; converting the sheet a second time here
  # would be the same code reading the same stylesheet to the same end.
  def self.convert(root, name)
    JSON.parse(File.read(File.join(root, name)))
  end

  # A selector GTK styles and libadwaita does not. The node is what decides it rather than the
  # whole selector: `notebook > header` is GTK's to answer because libadwaita says nothing about
  # a notebook at all, while `headerbar > button` is not, because libadwaita styles both ends of
  # it and its silence on that exact pairing is the cascade working rather than a gap.
  def self.gap?(selector, styled)
    nodes = self.nodes(selector)

    !nodes.empty? && nodes.none?{|node| styled.include?(node)}
  end

  # Every node libadwaita has a rule about, which is what this stage defers to.
  def self.styled(root)
    JSON.parse(File.read(File.join(root, ADWAITA))).keys.filter_map do |selector|
      self.nodes(selector).last
    end.to_set
  end

  # The node each segment of a selector names, in order, skipping the segments which name none.
  def self.nodes(selector)
    selector.split(/\s*>\s*|\s+/).filter_map{|segment| segment[/\A[a-z][a-z0-9-]*/]}
  end

  def self.run(_argv)
    root = File.expand_path("..", __dir__)
    styled = self.styled(root)

    GTK.each do |name, source|
      widgets = self.convert(root, source).select{|selector, _variants| self.gap?(selector, styled) }

      File.write(self.output(name), "#{JSON.pretty_generate(widgets)}\n")
      warn("wrote bin/04-gtk-tailwind.out/#{name}")
    end
  end

  # Beside the script, in a directory named after it.
  def self.output(name)
    File.join(__dir__, "04-gtk-tailwind.out").then do |directory|
      Dir.mkdir(directory) unless Dir.exist?(directory)
      File.join(directory, name)
    end
  end
end

GtkTailwind.run(ARGV)
