#!/usr/bin/env ruby
# frozen_string_literal: true

# 06-COMPONENT-TREES(1)           General Commands Manual          06-COMPONENT-TREES(1)
#
# NAME
#      bin/06-component-trees — the child tree of every composite widget
#
# SYNOPSIS
#      bin/06-component-trees > vendor/adwaita/trees.json
#
# DESCRIPTION
#      Reads the .ui templates under vendor/adwaita/ui/ and writes, as JSON on stdout, the tree
#      of widgets each composite is built out of.
#
#      <property name="child"> wraps one object. It is a named slot holding a single widget --
#      `child` itself, or `content`, `titlebar`, `title-widget`, `header-suffix`.
#
#      <child> holds an ordinary child, and a parent may have many. Where the surrounding object
#      carries a style class, that class is the position: GtkBox.prefixes and GtkBox.suffixes
#      are AdwActionRow's two, and both already have their own Tailwind classes from
#      bin/03-adwaita-tailwind.
#
#      Every class a template mentions is reported in `referenced`, with how many templates use
#      it. What is missing is not decided here: bin/08-final-components is the step which knows
#      the whole set, and it is the one which says.
#
# FILES
#      vendor/adwaita/ui/*.ui      the templates, vendored by bin/01-fetch-adwaita
#      vendor/adwaita/trees.json   the output
#
# EXIT STATUS
#      The bin/06-component-trees utility exits 0 on success, and >0 if an error occurs.
#
# SEE ALSO
#      bin/01-fetch-adwaita, bin/08-final-components
#
# adwaita-cn                      October 12, 2026                06-COMPONENT-TREES(1)

require "json"
require "rexml/document"

module ComponentTrees
  def self.bare(name)
    name.sub(/\A(Adw|Gtk|G)(?=[A-Z])/, "")
  end

  def self.namespace(name)
    name[/\A(Adw|Gtk|G)(?=[A-Z])/] || ""
  end

  # One <object> or <template> as a node: what it is, what it is called, the style classes on
  # it, the properties set on it, and what is underneath.
  def self.node(element)
    styles = REXML::XPath.match(element, "style/class").map{|c| c.attribute("name").to_s}

    {
      "class" => self.bare(element.attribute("class").to_s),
      "gtk" => element.attribute("class").to_s,
      "id" => element.attribute("id")&.to_s,
      "styles" => styles,
      "properties" => self.properties(element),
      # A named slot holds one widget: `<property name="child"><object .../></property>`.
      "slots" => self.slots(element),
      # An ordinary child, of which there may be many.
      "children" => REXML::XPath.match(element, "child/object").map{|child| self.node(child)},
    }.reject{|_key, value| value.nil? || (value.respond_to?(:empty?) && value.empty?)}
  end

  # The properties set on a node, less the ones which hold a widget -- those are slots.
  def self.properties(element)
    REXML::XPath.match(element, "property").filter_map do |property|
      next if REXML::XPath.first(property, "object")

      name = property.attribute("name").to_s
      bound = property.attribute("bind-property")&.to_s

      [name, bound ? { "bind" => bound } : property.text.to_s.strip]
    end.to_h
  end

  def self.slots(element)
    REXML::XPath.match(element, "property").filter_map do |property|
      object = REXML::XPath.first(property, "object")
      next if object.nil?

      [property.attribute("name").to_s, self.node(object)]
    end.to_h
  end

  # Every class named anywhere in a tree, with how often.
  def self.census(node, found)
    found[node.fetch("class")] = found.fetch(node.fetch("class"), 0) + 1

    node.fetch("children", []).each{|child| self.census(child, found)}
    node.fetch("slots", {}).each_value{|slot| self.census(slot, found)}

    found
  end

  def self.run(_argv)
    root = File.expand_path("..", __dir__)
    trees = {}

    Dir[File.join(root, "vendor/adwaita/ui/*.ui")].sort.each do |path|
      document = REXML::Document.new(File.read(path))

      REXML::XPath.each(document, "//template") do |template|
        name = self.bare(template.attribute("class").to_s)

        trees[name] = {
          "gtk" => template.attribute("class").to_s,
          "parent" => self.bare(template.attribute("parent").to_s),
          "template" => File.basename(path),
          "tree" => self.node(template),
        }
      end
    end

    referenced = {}
    trees.each_value{|entry| self.census(entry.fetch("tree"), referenced)}


    puts(JSON.pretty_generate({
      "templates" => trees.keys.sort,
      "referenced" => referenced.sort_by{|name, count| [-count, name]}.to_h,
      "trees" => trees.sort.to_h,
    }))
  end
end

ComponentTrees.run(ARGV)
