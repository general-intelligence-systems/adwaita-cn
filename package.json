{
  "name": "adwaita-cn",
  "version": "0.0.1",
  "private": true,
  "description": "shadcn registry of components built to GNOME Adwaita's geometry.",
  "type": "module",
  "scripts": {
    "registry:build": "shadcn build",
    "registry:check": "shadcn build --output /tmp/adwaita-cn-check && rm -rf /tmp/adwaita-cn-check",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit -p tsconfig.json",
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxlint": "^1.87.0",
    "shadcn": "^3.4.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^8.3.4"
  }
}
