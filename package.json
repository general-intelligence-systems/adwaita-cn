{
  "name": "adwaita-cn",
  "version": "0.0.1",
  "private": true,
  "description": "shadcn registry of components built to GNOME Adwaita's geometry.",
  "scripts": {
    "dev": "react-router dev",
    "build": "pnpm run registry:build && react-router build",
    "build:pages": "bin/12-build-pages",
    "registry:build": "shadcn build",
    "registry:check": "shadcn build --output /tmp/adwaita-cn-check && rm -rf /tmp/adwaita-cn-check",
    "lint": "oxlint",
    "typecheck": "react-router typegen && tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@react-router/dev": "^8.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxlint": "^1.87.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^3.4.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@react-router/node": "^8.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fumadocs-core": "^16.17.1",
    "fumadocs-mdx": "^15.4.7",
    "fumadocs-ui": "^16.17.1",
    "react-router": "^8.4.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.6.6",
    "isbot": "^5"
  },
  "type": "module"
}
